{
  "info": {
    "name": "Prosto Mobile API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Set base_url to the HTTPS API origin, username and password locally. Users/Login captures the session token automatically. Do not share an export containing real credentials or tokens."
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{access_token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "device_id",
      "value": ""
    },
    {
      "key": "app_version",
      "value": "1.0.0"
    },
    {
      "key": "app_build",
      "value": "100"
    },
    {
      "key": "device_platform",
      "value": "Android"
    },
    {
      "key": "device_model",
      "value": "Postman test device"
    },
    {
      "key": "os_version",
      "value": "14"
    },
    {
      "key": "base_url",
      "value": "https://api.example.com"
    },
    {
      "key": "username",
      "value": ""
    },
    {
      "key": "password",
      "value": ""
    },
    {
      "key": "access_token",
      "value": ""
    },
    {
      "key": "expires_at",
      "value": ""
    },
    {
      "key": "device_mac_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "bio_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "integration_username",
      "value": "",
      "type": "string"
    },
    {
      "key": "integration_password",
      "value": "",
      "type": "string"
    },
    {
      "key": "brand_id",
      "value": "29"
    }
  ],
  "item": [
    {
      "name": "1 - Login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/Users/Login",
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"Username\": \"{{username}}\",\n  \"Password\": \"{{password}}\",\n  \"AppVersion\": \"{{app_version}}\",\n  \"AppBuild\": \"{{app_build}}\",\n  \"Device\": {\n    \"DeviceID\": \"{{device_id}}\",\n    \"Platform\": \"{{device_platform}}\",\n    \"Model\": \"{{device_model}}\",\n    \"OSVersion\": \"{{os_version}}\",\n    \"MACID\": \"{{device_mac_id}}\"\n  }\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Persist this ID between logins; change only to test a different installation.",
              "if(!pm.collectionVariables.get('device_id'))pm.collectionVariables.set('device_id',pm.variables.replaceIn('{{$guid}}'));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "if (pm.response.code === 200) { const data = pm.response.json().Data; pm.collectionVariables.set(\"access_token\", data.AccessToken); pm.collectionVariables.set(\"expires_at\", data.ExpiresAt); }",
              "if(pm.response.code===200){pm.collectionVariables.set('bio_id',pm.response.json().Data.User.BIOID);}",
              "if(pm.response.code===200){const brand=pm.response.json().Data.User.brand;pm.collectionVariables.set('brand_id',brand?brand.ID:'');}"
            ]
          }
        }
      ]
    },
    {
      "name": "2 - Get_News",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/Get_News",
        "body": {
          "mode": "raw",
          "raw": "{\"BrandID\":{{brand_id}}}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "if (pm.response.code === 200) pm.collectionVariables.set(\"expires_at\", pm.response.json().Session.ExpiresAt);"
            ]
          }
        }
      ]
    },
    {
      "name": "3 - Get_InfoPages",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/Get_InfoPages"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "if (pm.response.code === 200) pm.collectionVariables.set(\"expires_at\", pm.response.json().Session.ExpiresAt);"
            ]
          }
        }
      ]
    },
    {
      "name": "4 - Logout",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/Logout"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.collectionVariables.unset(\"access_token\");"
            ]
          }
        }
      ]
    },
    {
      "name": "Device - Add_New_Devices",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/Users/AddNewDevices",
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"Username\": \"{{username}}\",\n  \"Password\": \"{{password}}\",\n  \"AppVersion\": \"{{app_version}}\",\n  \"AppBuild\": \"{{app_build}}\",\n  \"Device\": {\n    \"DeviceID\": \"{{device_id}}\",\n    \"Platform\": \"{{device_platform}}\",\n    \"Model\": \"{{device_model}}\",\n    \"OSVersion\": \"{{os_version}}\",\n    \"MACID\": \"{{device_mac_id}}\"\n  }\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Persist this ID between logins; change only to test a different installation.",
              "if(!pm.collectionVariables.get('device_id'))pm.collectionVariables.set('device_id',pm.variables.replaceIn('{{$guid}}'));"
            ]
          }
        }
      ]
    },
    {
      "name": "Device - status",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/v1/devices/status",
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"Username\": \"{{username}}\",\n  \"Password\": \"{{password}}\",\n  \"AppVersion\": \"{{app_version}}\",\n  \"AppBuild\": \"{{app_build}}\",\n  \"Device\": {\n    \"DeviceID\": \"{{device_id}}\",\n    \"Platform\": \"{{device_platform}}\",\n    \"Model\": \"{{device_model}}\",\n    \"OSVersion\": \"{{os_version}}\",\n    \"MACID\": \"{{device_mac_id}}\"\n  }\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Persist this ID between logins; change only to test a different installation.",
              "if(!pm.collectionVariables.get('device_id'))pm.collectionVariables.set('device_id',pm.variables.replaceIn('{{$guid}}'));"
            ]
          }
        }
      ]
    },
    {
      "name": "Login Via BIO",
      "request": {
        "method": "POST",
        "url": "{{base_url}}/api/Users/LoginViaBIO",
        "auth": {
          "type": "basic",
          "basic": [
            {
              "key": "username",
              "value": "{{integration_username}}",
              "type": "string"
            },
            {
              "key": "password",
              "value": "{{integration_password}}",
              "type": "string"
            }
          ]
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"BIOID\": \"{{bio_id}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "description": "Current fixed Basic credentials. BIOID from Data.User.BIOID is secret. Keep real values out of shared exports."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "if (pm.response.code === 200) { const data = pm.response.json().Data; pm.collectionVariables.set(\"access_token\", data.AccessToken); pm.collectionVariables.set(\"expires_at\", data.ExpiresAt); }",
              "if(pm.response.code===200){pm.collectionVariables.set('bio_id',pm.response.json().Data.User.BIOID);}"
            ]
          }
        }
      ]
    }
  ]
}