{
  "info": {
    "name": "Prosto - Employee Password Recovery",
    "description": "Three-step password reset. Configure brand Gmail first. Enter received OTP manually. Basic credentials are not included.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "value": "http://localhost:3001",
      "key": "baseUrl"
    },
    {
      "value": "",
      "key": "integration_username"
    },
    {
      "value": "",
      "key": "integration_password"
    },
    {
      "value": "100",
      "key": "employee_number"
    },
    {
      "value": "",
      "key": "challenge_id"
    },
    {
      "value": "",
      "key": "otp"
    },
    {
      "value": "",
      "key": "reset_token"
    },
    {
      "value": "",
      "key": "new_password"
    }
  ],
  "auth": {
    "type": "basic",
    "basic": [
      {
        "value": "{{integration_username}}",
        "type": "string",
        "key": "username"
      },
      {
        "value": "{{integration_password}}",
        "type": "string",
        "key": "password"
      }
    ]
  },
  "item": [
    {
      "event": [
        {
          "script": {
            "type": "text/javascript",
            "exec": [
              "const data=pm.response.json(); if(data.Success) pm.collectionVariables.set('challenge_id',data.Data.ChallengeID);"
            ]
          },
          "listen": "test"
        }
      ],
      "name": "RequestPasswordReset",
      "request": {
        "url": "{{baseUrl}}/api/Users/RequestPasswordReset",
        "body": {
          "options": {
            "raw": {
              "language": "json"
            }
          },
          "raw": "{\"EmployeeNumber\":{{employee_number}}}",
          "mode": "raw"
        },
        "header": [
          {
            "value": "application/json",
            "key": "Content-Type"
          }
        ],
        "method": "POST"
      }
    },
    {
      "event": [
        {
          "script": {
            "type": "text/javascript",
            "exec": [
              "const data=pm.response.json(); if(data.Success) pm.collectionVariables.set('reset_token',data.Data.ResetToken);"
            ]
          },
          "listen": "test"
        }
      ],
      "name": "VerifyPasswordResetOTP",
      "request": {
        "url": "{{baseUrl}}/api/Users/VerifyPasswordResetOTP",
        "body": {
          "options": {
            "raw": {
              "language": "json"
            }
          },
          "raw": "{\"ChallengeID\":\"{{challenge_id}}\",\"OTP\":\"{{otp}}\"}",
          "mode": "raw"
        },
        "header": [
          {
            "value": "application/json",
            "key": "Content-Type"
          }
        ],
        "method": "POST"
      }
    },
    {
      "event": [
        {
          "script": {
            "type": "text/javascript",
            "exec": [
              "if(pm.response.json().Success){pm.collectionVariables.unset('reset_token');pm.collectionVariables.unset('otp');pm.collectionVariables.unset('new_password');}"
            ]
          },
          "listen": "test"
        }
      ],
      "name": "ResetPassword",
      "request": {
        "url": "{{baseUrl}}/api/Users/ResetPassword",
        "body": {
          "options": {
            "raw": {
              "language": "json"
            }
          },
          "raw": "{\"ResetToken\":\"{{reset_token}}\",\"NewPassword\":\"{{new_password}}\"}",
          "mode": "raw"
        },
        "header": [
          {
            "value": "application/json",
            "key": "Content-Type"
          }
        ],
        "method": "POST"
      }
    }
  ]
}