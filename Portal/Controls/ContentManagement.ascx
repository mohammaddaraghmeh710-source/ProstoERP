<%@ Control Language="VB" %>
<style>#contentEditor .select2-search__field{min-width:8rem;max-width:100%}#contentEditor .select2-selection__choice{max-width:100%;white-space:normal;overflow-wrap:anywhere}</style>
<div id="contentManager" class="container-xxl flex-grow-1 container-p-y crm-shell crm-types" dir="rtl" data-kind='<%= If(TypeOf Page Is CRM.ManageInformationPages,"pages","news") %>' data-token='<%= Server.HtmlEncode(Convert.ToString(Session("ContentManagementCSRF"))) %>'>
 <div class="type-page-header type-flex align-items-center justify-content-between"><h1 class="h4 mb-0" data-manager-title></h1><nav aria-label="مسار التنقل"><ol class="breadcrumb mb-0"><li class="breadcrumb-item">إدارة المحتوى</li><li class="breadcrumb-item active" data-manager-title></li></ol></nav></div>
 <div data-manager-message role="status" aria-live="polite"></div>
 <div class="row g-4 mb-4" aria-label="إحصائيات الإدارة">
  <div class="col-12 col-md-4"><div class="card type-stat-card"><div class="card-body type-flex align-items-start justify-content-between"><div><span>إجمالي العناصر</span><div class="type-stat-count" data-stat="total">—</div></div><span class="badge bg-label-primary rounded type-stat-icon"><i class="bx bx-category" aria-hidden="true"></i></span></div></div></div>
  <div class="col-12 col-md-4"><div class="card type-stat-card"><div class="card-body type-flex align-items-start justify-content-between"><div><span data-active-label>العناصر الفعالة</span><div class="type-stat-count" data-stat="active">—</div></div><span class="badge bg-label-success rounded type-stat-icon"><i class="bx bx-check-circle" aria-hidden="true"></i></span></div></div></div>
  <div class="col-12 col-md-4"><div class="card type-stat-card"><div class="card-body type-flex align-items-start justify-content-between"><div><span data-inactive-label>العناصر الموقوفة</span><div class="type-stat-count" data-stat="inactive">—</div></div><span class="badge bg-label-warning rounded type-stat-icon"><i class="bx bx-pause-circle" aria-hidden="true"></i></span></div></div></div>
 </div>
 <div class="card"><div class="card-header type-filter-header"><h2 class="card-title h5 mb-0">تصفية البحث</h2><div class="row g-3 align-items-center">
  <div class="col-12 col-md"><input type="search" class="form-control" data-filter="name" placeholder="العنوان بالعربية أو الإنجليزية" aria-label="البحث بالعنوان"/></div>
  <div class="col-12 col-md"><select class="form-select" data-filter="brand" aria-label="العلامة التجارية"><option value="">جميع العلامات التجارية</option></select></div>
  <div class="col-12 col-md"><select class="form-select" data-filter="status" aria-label="الحالة"><option value="">جميع الحالات</option><option value="1">فعال</option><option value="0">موقوف</option></select></div>
  <div class="col-12 col-md" data-pages-only><select class="form-select" data-filter="archive" aria-label="عرض الأرشيف"><option value="0">الصفحات الحالية</option><option value="1">أرشيف المحذوفات</option></select></div>
  <div class="col-auto type-flex gap-2"><button type="button" class="btn btn-icon btn-label-secondary" data-filter-apply aria-label="بحث" title="بحث"><i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i></button><button type="button" class="btn btn-icon btn-label-secondary" data-filter-reset aria-label="إعادة تعيين" title="إعادة تعيين"><i class="fa-solid fa-rotate-left" aria-hidden="true"></i></button></div>
 </div></div>
 <div id="pnlTableActions" class="type-flex type-toolbar-controls"><button type="button" class="btn btn-primary" data-manager-add><i class="fa-solid fa-plus me-2" aria-hidden="true"></i><span>إضافة عنصر</span></button><a href="/Modules/Information_Pages/Logs.aspx" class="btn btn-label-secondary" data-pages-only>سجل العمليات والزيارات</a></div>
 <div class="table-responsive"><table id="ERPTable" data-enhanced="1" class="table type-table" aria-label="عناصر الإدارة"><thead><tr><th>العنوان</th><th>العلامة التجارية</th><th>الحالة</th><th data-date-heading>التاريخ</th><th>الترتيب</th><th data-version-heading>الإصدار</th><th>الإجراءات</th></tr></thead><tbody></tbody></table></div></div>
 <div class="offcanvas offcanvas-end type-editor crm-editor-wide" tabindex="-1" id="contentEditor" aria-labelledby="contentEditorTitle"><div class="offcanvas-header border-bottom"><h2 class="offcanvas-title h5" id="contentEditorTitle">إضافة عنصر</h2><button type="button" class="btn-close text-reset" data-bs-dismiss="offcanvas" aria-label="إغلاق"></button></div><div class="offcanvas-body"><div data-editor-message role="status" aria-live="polite"></div>
  <section class="crm-form-section"><h3 class="crm-section-title h6">العلامة التجارية والنشر</h3><div class="row g-3">
   <div class="col-12"><label class="form-label" for="contentBrands">العلامة التجارية <span data-pages-only>(يمكن اختيار أكثر من علامة)</span></label><select id="contentBrands" class="form-select" data-field="brands" aria-label="علامات العنصر"></select></div>
   <div class="col-12" data-news-only><label class="form-label" for="contentDate">تاريخ الخبر</label><input id="contentDate" type="datetime-local" class="form-control" data-field="date"/></div>
  </div></section>
  <section class="crm-form-section" data-pages-only><h3 class="crm-section-title h6">صلاحيات الاطلاع</h3><div class="mb-3"><label for="contentAudience" class="form-label">جمهور الصفحة</label><select id="contentAudience" class="form-select" data-field="audience"><option value="employees">الموظفون</option><option value="customers">العملاء</option><option value="all">الجميع — الموظفون والعملاء</option></select></div>
   <div data-employee-scope><label for="contentEmployeeScope" class="form-label">أنواع الموظفين</label><select id="contentEmployeeScope" class="form-select mb-3" data-field="employeeScope"><option value="all">كل أنواع الموظفين ضمن العلامات المحددة</option><option value="selected">أنواع موظفين محددة</option></select><div class="row g-2 mb-3" data-role-options></div></div>
   <div data-customer-scope><label for="contentCustomerScope" class="form-label">العملاء</label><select id="contentCustomerScope" class="form-select mb-3" data-field="customerScope"><option value="all">كل العملاء ضمن العلامات المحددة</option><option value="selected">عملاء محددون بالاسم</option></select><div data-customer-selection><label for="contentCustomers" class="form-label">اختر العملاء</label><select id="contentCustomers" class="form-select" multiple data-placeholder="ابحث باسم العميل" aria-label="اختر العملاء"></select><small class="text-muted d-block mt-2" data-customer-status role="status" aria-live="polite"></small></div></div>
   <div class="alert alert-primary mb-0" data-everyone>تظهر الصفحة لكل الموظفين والعملاء ضمن العلامات المختارة، بشرط النشر وفترة العرض.</div>
  </section>
  <section class="crm-form-section"><h3 class="crm-section-title h6">المحتوى</h3><div class="row g-3">
   <div class="col-12 col-md-6"><label class="form-label" for="contentTitleAr">العنوان بالعربية</label><input id="contentTitleAr" class="form-control" data-field="titleAr" maxlength="250" required/></div>
   <div class="col-12 col-md-6"><label class="form-label" for="contentTitleEn">العنوان بالإنجليزية</label><input id="contentTitleEn" class="form-control" data-field="titleEn" maxlength="250" dir="ltr"/></div>
   <div class="col-12"><label class="form-label" for="contentSummaryAr">الملخص بالعربية</label><textarea id="contentSummaryAr" class="form-control" data-field="summaryAr" maxlength="2000" rows="3"></textarea></div>
   <div class="col-12"><label class="form-label" for="contentSummaryEn">الملخص بالإنجليزية</label><textarea id="contentSummaryEn" class="form-control" data-field="summaryEn" maxlength="2000" rows="3" dir="ltr"></textarea></div>
   <div class="col-12"><label class="form-label" for="contentDetailsAr">التفاصيل بالعربية</label><textarea id="contentDetailsAr" class="form-control" data-field="detailsAr" rows="8"></textarea></div>
   <div class="col-12"><label class="form-label" for="contentDetailsEn">التفاصيل بالإنجليزية</label><textarea id="contentDetailsEn" class="form-control" data-field="detailsEn" rows="8" dir="ltr"></textarea></div>
   <div class="col-12 col-md-6"><label class="form-label" for="contentOrder">الترتيب</label><input id="contentOrder" class="form-control" type="number" min="0" max="2147483647" data-field="order" value="0" required/></div>
   <div class="col-12 col-md-6"><label class="form-label" for="contentActive">الحالة</label><select id="contentActive" class="form-select" data-field="active"><option value="1">فعال</option><option value="0">موقوف</option></select></div>
   <div class="col-12" data-pages-only><label class="form-label" for="contentMode">طريقة النشر</label><select id="contentMode" class="form-select" data-field="mode"><option value="immediate">نشر فوري</option><option value="scheduled">نشر مجدول</option></select></div>
   <div class="col-12" data-schedule><div class="row g-3"><div class="col-md-6"><label class="form-label" for="contentStart">بداية العرض — عمّان</label><input id="contentStart" class="form-control" type="datetime-local" data-field="start"/></div><div class="col-md-6"><label class="form-label" for="contentEnd">نهاية العرض — عمّان</label><input id="contentEnd" class="form-control" type="datetime-local" data-field="end"/></div></div></div>
   <div class="col-12" data-news-only><label class="form-label" for="contentImage">صورة الخبر (اختيارية)</label><input id="contentImage" class="form-control" type="file" accept="image/png,image/jpeg,image/gif,image/webp"/><p class="form-text">PNG أو JPG أو GIF أو WebP، حتى 10 ميجابايت. اتركه فارغًا للاحتفاظ بالصورة الحالية.</p><img id="contentImagePreview" class="rounded" width="96" height="72" style="object-fit:cover" alt="صورة الخبر" hidden/></div>
  </div></section>
  <div class="type-flex flex-wrap gap-2"><button type="button" class="btn btn-primary" data-editor-save>حفظ</button><button type="button" class="btn btn-label-secondary" data-bs-dismiss="offcanvas">إلغاء</button></div>
 </div></div>
 <div class="modal fade" id="contentDeleteModal" tabindex="-1" aria-labelledby="contentDeleteTitle" aria-hidden="true"><div class="modal-dialog modal-dialog-centered"><div class="modal-content"><div class="modal-header"><h2 class="modal-title h5" id="contentDeleteTitle">تأكيد الحذف</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="إغلاق"></button></div><div class="modal-body"><div data-delete-message role="status"></div>هل تريد حذف «<strong data-delete-name></strong>»؟</div><div class="modal-footer"><button type="button" class="btn btn-label-secondary" data-bs-dismiss="modal">إلغاء</button><button type="button" class="btn btn-danger" data-delete-confirm>تأكيد الحذف</button></div></div></div></div>
 <div class="modal fade" id="contentLinksModal" tabindex="-1" aria-labelledby="contentLinksTitle" aria-hidden="true"><div class="modal-dialog modal-dialog-centered modal-lg"><div class="modal-content"><div class="modal-header"><h2 class="modal-title h5" id="contentLinksTitle">رابط الصفحة</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="إغلاق"></button></div><div class="modal-body"><p class="text-muted">فتح الرابط يخضع لصلاحيات الجمهور والعلامة التجارية والنشر.</p><div class="mb-3"><label class="form-label" for="employeePageUrl">رابط الموظفين</label><div class="input-group"><input id="employeePageUrl" class="form-control" dir="ltr" readonly/><button type="button" class="btn btn-label-primary" data-copy-url="employeePageUrl">نسخ</button></div></div><div><label class="form-label" for="customerPageUrl">رابط العميل</label><div class="input-group"><input id="customerPageUrl" class="form-control" dir="ltr" readonly/><button type="button" class="btn btn-label-primary" data-copy-url="customerPageUrl">نسخ</button></div></div><p class="text-muted mt-3 mb-0" data-copy-status role="status" aria-live="polite"></p></div></div></div></div>
</div>
<script src="/assets/js/crm-list.js?v=20261017e"></script>
<script src="/assets/js/content-management.js?v=20261021multi"></script>
