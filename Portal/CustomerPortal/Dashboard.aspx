<%@ Page Title="لوحة العميل" Language="vb" AutoEventWireup="false" MasterPageFile="~/Customer.Master" CodeBehind="Dashboard.aspx.vb" Inherits="CRM.CustomerDashboard" %>
<%@ Register TagPrefix="uc" TagName="CircularReader" Src="~/Controls/CircularReader.ascx" %>
<asp:Content ID="head" runat="server" ContentPlaceHolderID="HeadContent">
  <link rel="stylesheet" href="/assets/css/customer-news.css?v=20261018e" /><link rel="stylesheet" href="/assets/vendor/css/pages/page-profile.css" /><link rel="stylesheet" href="/assets/vendor/fonts/fontawesome.css" /><link rel="stylesheet" href="/assets/css/crm.css" /><link rel="stylesheet" href="/assets/css/crm-list.css" />
  <link rel="stylesheet" href="/assets/vendor/libs/datatables-bs5/datatables.bootstrap5.css" /><link rel="stylesheet" href="/assets/css/customer-circular-table.css?v=20261021a" />
  <style>.customer-profile .user-profile-img{height:120px!important;object-fit:contain;background:#fff}.customer-profile .profile-value{overflow-wrap:anywhere}.customer-profile .contact-avatar{width:32px;height:32px}.customer-profile .contact-card{height:100%;min-width:0}.customer-profile .contact-identity,.customer-profile .contact-details{min-width:0}.customer-profile .contact-card h6{font-size:.9375rem}.customer-profile .contact-card small,.customer-profile .contact-role{font-size:.8125rem}.customer-profile .contact-card .badge{font-size:.6875rem}.customer-profile .contact-card .type-row-actions{gap:.125rem;flex-shrink:0}@media(max-width:767.98px){.customer-profile .user-profile-img{height:100px!important}}</style>
</asp:Content>
<asp:Content ID="body" runat="server" ContentPlaceHolderID="ContentPlaceHolder1">
<div class="customer-profile crm-types">
<asp:Literal ID="litMessage" runat="server" EnableViewState="false" />
  <div class="d-flex align-items-center justify-content-between gap-2 mb-3"><h5 class="mb-0">لوحة العميل</h5><span class="text-muted small">بوابة العملاء / الملف الشخصي</span></div>
  <div class="card mb-4">
    <div class="user-profile-header-banner"><img src="/assets/img/pages/profile-banner.png" alt="" class="rounded-top" /></div>
    <div class="user-profile-header d-flex flex-column flex-sm-row text-sm-start text-center mb-4">
      <div class="flex-shrink-0 mt-n2 mx-sm-0 mx-auto"><img src="Logo.aspx" alt="شعار العميل" class="d-block ms-0 ms-sm-4 rounded-3 user-profile-img" /></div>
      <div class="flex-grow-1 mt-3 mt-sm-5"><div class="d-flex align-items-center justify-content-between mx-4 flex-md-row flex-column gap-3">
        <div class="user-profile-info"><h4 class="mb-2 profile-value">مرحبًا بك، <asp:Literal ID="welcomeName" runat="server" Mode="Encode" /></h4><p class="text-muted mb-2">يسعدنا تواصلك معنا. تجد هنا بيانات حسابك وجهات الاتصال الخاصة بك.</p><ul class="list-inline mb-0 d-flex flex-wrap justify-content-sm-start justify-content-center gap-3"><li class="list-inline-item"><i class="bx bx-store-alt me-1"></i><asp:Literal ID="brandName" runat="server" Mode="Encode" /></li><li class="list-inline-item"><i class="bx bx-map me-1"></i><asp:Literal ID="branchName" runat="server" Mode="Encode" /></li></ul></div>
        <span class="badge bg-label-success text-nowrap"><i class="bx bx-check-circle me-1"></i>حساب فعال</span>
      </div></div>
    </div>
  </div>

  <div class="row g-4">
    <div class="col-lg-4 col-md-5">
      <div class="card mb-4"><div class="card-body"><div class="d-flex align-items-center justify-content-between mb-3"><h6 class="text-muted mb-0">بيانات العميل</h6><asp:LinkButton ID="btnEditProfile" runat="server" CssClass="btn btn-sm btn-label-primary" OnClick="EditProfile_Click" CausesValidation="false"><i class="fa-solid fa-pen-to-square me-1" aria-hidden="true"></i>تعديل بياناتي</asp:LinkButton></div><ul class="list-unstyled mb-0">
        <li class="d-flex gap-2 mb-3"><i class="bx bx-user"></i><div class="profile-value"><span class="fw-semibold">اسم العميل: </span><asp:Literal ID="customerName" runat="server" Mode="Encode" /></div></li>
        <li class="d-flex gap-2 mb-3"><i class="bx bx-star"></i><div class="profile-value"><span class="fw-semibold">نوع العميل: </span><asp:Literal ID="typeName" runat="server" Mode="Encode" /></div></li>
        <li class="d-flex gap-2 mb-3"><i class="bx bx-phone"></i><div class="profile-value"><span class="fw-semibold">الهاتف: </span><bdi><asp:Literal ID="phone" runat="server" Mode="Encode" /></bdi></div></li>
        <li class="d-flex gap-2"><i class="bx bx-envelope"></i><div class="profile-value"><span class="fw-semibold">البريد الإلكتروني: </span><bdi><asp:Literal ID="email" runat="server" Mode="Encode" /></bdi></div></li>
      </ul></div></div>
      <div class="card"><div class="card-body d-flex align-items-center justify-content-between"><div><p class="mb-1 text-muted">جهات الاتصال</p><h3 class="mb-0"><asp:Literal ID="contactCount" runat="server" Mode="Encode" /></h3></div><span class="avatar bg-label-primary rounded p-2"><i class="bx bx-group bx-sm"></i></span></div></div>
    </div>
    <div class="col-lg-8 col-md-7">
      <div class="card"><div class="card-header border-bottom d-flex justify-content-between align-items-center flex-wrap gap-2"><div><h5 class="mb-1">جهات الاتصال الخاصة بك</h5><small class="text-muted">جهات الاتصال المسجلة ضمن حساب العميل</small></div><asp:LinkButton ID="btnNewContact" runat="server" CssClass="btn btn-primary btn-sm" OnClick="NewContact_Click" CausesValidation="false"><i class="fa-solid fa-plus me-1" aria-hidden="true"></i>إضافة جهة اتصال</asp:LinkButton></div><div class="card-body pt-4">
        <asp:Panel ID="emptyContacts" runat="server" CssClass="text-center text-muted py-5"><i class="bx bx-group bx-lg d-block mb-3"></i>لا توجد جهات اتصال مسجلة لحسابك حتى الآن.</asp:Panel>
        <div class="row g-3"><asp:ListView ID="contacts" runat="server" DataKeyNames="ID,Row_Version" OnItemCommand="Contact_Command"><LayoutTemplate><asp:PlaceHolder ID="itemPlaceholder" runat="server" /></LayoutTemplate><ItemTemplate><div class="col-xl-6"><article class="border rounded p-3 contact-card" data-contact-card="1">
          <div class="d-flex align-items-start gap-2"><span class="avatar contact-avatar bg-label-primary rounded d-flex align-items-center justify-content-center flex-shrink-0"><i class="bx bx-user" aria-hidden="true"></i></span><div class="flex-grow-1 contact-identity profile-value"><h6 class="mb-1"><%#: Eval("Name_AR") %></h6><small class="d-block text-muted" dir="ltr"><%#: DisplayValue(Eval("Name_EN")) %></small></div><span class='<%# If(Convert.ToBoolean(Eval("Is_Active")), "badge bg-label-success", "badge bg-label-secondary") %>'><%#: If(Convert.ToBoolean(Eval("Is_Active")), "فعال", "موقوف") %></span></div>
          <div class="contact-role text-muted d-flex flex-wrap gap-1 my-2 profile-value"><span><%#: DisplayValue(Eval("Job_Title")) %></span><span aria-hidden="true">·</span><bdi dir="ltr"><%#: DisplayValue(Eval("Job_Title_EN")) %></bdi></div>
          <div class="d-flex align-items-end justify-content-between gap-2 border-top pt-2"><div class="contact-details small profile-value"><div class="d-flex align-items-start gap-2 mb-1"><i class="bx bx-phone" aria-hidden="true"></i><bdi><%#: DisplayValue(Eval("Phone")) %></bdi></div><div class="d-flex align-items-start gap-2"><i class="bx bx-envelope" aria-hidden="true"></i><bdi><%#: DisplayValue(Eval("Email")) %></bdi></div></div><div class="type-flex type-row-actions"><asp:LinkButton runat="server" CssClass="btn btn-sm btn-icon type-row-action text-secondary" CommandName="EditContact" CommandArgument='<%# Eval("ID") %>' CausesValidation="false" ToolTip="تعديل جهة الاتصال" aria-label="تعديل جهة الاتصال" data-bs-toggle="tooltip"><i class="fa-solid fa-pen-to-square" aria-hidden="true"></i></asp:LinkButton><asp:LinkButton runat="server" CssClass="btn btn-sm btn-icon type-row-action text-danger" CommandName="AskDeleteContact" CommandArgument='<%# Eval("ID") %>' CausesValidation="false" ToolTip="حذف جهة الاتصال" aria-label="حذف جهة الاتصال" data-bs-toggle="tooltip"><i class="fa-solid fa-trash-can" aria-hidden="true"></i></asp:LinkButton></div></div>
        </article></div></ItemTemplate></asp:ListView></div>
      </div></div>
  <section class="customer-circulars card mt-4 mb-0" id="customerCirculars" aria-labelledby="customerCircularsTitle">
    <div class="card-header border-bottom py-3 px-4"><div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3"><h2 class="h6 mb-0" id="customerCircularsTitle">التعاميم</h2><span class="badge bg-label-primary" data-circular-count aria-live="polite"><asp:Literal ID="circularCount" runat="server" Mode="Encode" /></span></div><div class="row g-2">
      <div class="col-12 col-md-5"><div class="input-group input-group-merge"><span class="input-group-text"><i class="bx bx-search" aria-hidden="true"></i></span><input type="search" id="customerCircularName" class="form-control" maxlength="200" placeholder="ابحث باسم التعميم..." aria-label="البحث باسم التعميم بالعربية أو الإنجليزية" data-circular-name-filter /></div></div>
      <div class="col-12 col-sm-6 col-md-4"><asp:DropDownList ID="circularBrandFilter" runat="server" ClientIDMode="Static" CssClass="form-select" aria-label="العلامة التجارية للتعاميم" data-circular-brand-filter="1" data-authorized-brands="1" /></div>
      <div class="col-12 col-sm-6 col-md-3"><select id="customerCircularReadStatus" class="form-select" aria-label="حالة قراءة التعميم" data-circular-read-filter><option value="">جميع الحالات</option><option value="0">غير مقروء</option><option value="1">مقروء</option></select></div>
    </div></div>
    <div class="card-datatable table-responsive"><table id="customerCircularTable" data-enhanced="1" data-circular-reader-table="1" class="card-list-table table border-top crm-table"><thead><tr><th>التعميم</th><th>العلامة التجارية</th><th>التاريخ</th><th>الحالة</th><th data-orderable="false">الإجراءات</th></tr></thead><tbody><asp:Repeater ID="customerCirculars" runat="server"><ItemTemplate>
      <tr data-circular-row="1" data-circular-id='<%# CInt(Eval("ID")) %>' data-circular-version='<%# CInt(Eval("Version")) %>' data-read='<%# If(CBool(Eval("IsRead")), "1", "0") %>' data-brand-id='<%# CInt(Eval("BrandID")) %>' data-circular-name='<%# CRM.CRMData.H(Convert.ToString(Eval("Title")) & " " & Convert.ToString(Eval("Title_EN"))) %>'>
        <td data-title="التعميم"><div class="type-record-name"><span class="fw-semibold"><%#: Eval("Title") %></span><small class="d-block text-muted" dir="auto"><%#: Eval("Title_EN") %></small></div></td>
        <td data-title="العلامة التجارية"><span class="text-muted"><%#: Eval("BrandName") %></span></td>
        <td data-title="التاريخ"><bdi><%#: CDate(Eval("CircularDate")).ToString("yyyy/MM/dd") %></bdi></td>
        <td data-title="الحالة"><span data-read-badge class='<%# If(CBool(Eval("IsRead")), "badge bg-label-success", "badge bg-label-warning") %>'><%#: If(CBool(Eval("IsRead")), "مقروء", "غير مقروء") %></span></td>
        <td data-title="الإجراءات"><button type="button" class="btn btn-sm btn-icon type-row-action text-primary" data-circular-open="1" data-circular-id='<%# CInt(Eval("ID")) %>' data-bs-toggle="tooltip" title="عرض التعميم" aria-label="عرض التعميم"><i class="fa-solid fa-eye" aria-hidden="true"></i></button></td>
      </tr>
    </ItemTemplate></asp:Repeater></tbody></table></div><div class="card-body text-muted" data-circular-filter-empty hidden>لا توجد تعاميم مطابقة للفلاتر المحددة.</div>
  </section>
  <section class="customer-news card mt-4 mb-0" id="brandNewsSection" aria-labelledby="brandNewsTitle">
    <div class="card-header py-3 px-4 d-flex flex-wrap align-items-center justify-content-between gap-3"><h2 class="h6 mb-0" id="brandNewsTitle">آخر الأخبار</h2><asp:DropDownList ID="newsBrandFilter" runat="server" CssClass="form-select form-select-sm w-auto" data-news-brand-filter="1" data-authorized-brands="1" aria-label="العلامة التجارية للأخبار" /></div>
    <asp:Panel ID="newsEmpty" runat="server" CssClass="card-body text-muted">لا توجد أخبار منشورة للعلامات التجارية المرتبطة بحسابك حاليًا.</asp:Panel>
    <asp:Panel ID="newsCarouselBody" runat="server"><div id="customerBrandNews" class="carousel carousel-dark slide carousel-fade" data-bs-ride="carousel" data-bs-interval="false" role="region" aria-roledescription="عارض أخبار" aria-label="أخبار العلامة التجارية"><div class="carousel-inner"><asp:Repeater ID="brandNews" runat="server"><ItemTemplate>
      <article data-brand-id='<%# CInt(Eval("Brand_ID")) %>' data-brand-name='<%# CRM.CRMData.H(Eval("Brand_Name")) %>' class='<%# If(Container.ItemIndex = 0, "carousel-item active", "carousel-item") %>'><div class="customer-news-slide"><img class="customer-news-image rounded" src='<%# CRM.CRMData.H(CRM.NewsData.CustomerImage(Eval("Image"))) %>' alt='<%# CRM.CRMData.H(Eval("Title_AR")) %>'/><div class="customer-news-copy"><div class="text-muted small mb-1"><span class="badge bg-label-primary me-2"><%#: Eval("Brand_Name") %></span><i class="bx bx-calendar me-1" aria-hidden="true"></i><%#: CRM.NewsData.CustomerDate(Eval("Date")) %></div><h3 class="h6 mb-1 customer-news-title"><%#: Eval("Title_AR") %></h3><p class="text-muted small mb-0 customer-news-excerpt"><%#: Eval("Brief_Ar") %></p></div><div class="customer-news-slide-action"><a class="btn btn-label-primary btn-sm text-nowrap" href='<%# "NewsDetail.aspx?id=" & Convert.ToInt32(Eval("PID")).ToString() %>'>تفاصيل الخبر<i class="bx bx-left-arrow-alt ms-1" aria-hidden="true"></i></a></div></div></article>
    </ItemTemplate></asp:Repeater></div><div class="carousel-indicators"><asp:Repeater ID="newsIndicators" runat="server"><ItemTemplate><button type="button" data-bs-target="#customerBrandNews" data-bs-slide-to='<%# Container.ItemIndex %>' class='<%# If(Container.ItemIndex=0,"active","") %>' aria-current='<%# If(Container.ItemIndex=0,"true","false") %>' aria-label='<%# "الخبر " & (Container.ItemIndex+1).ToString() %>'></button></ItemTemplate></asp:Repeater></div></div></asp:Panel>
    <div class="card-body text-muted" data-news-filter-empty hidden>لا توجد أخبار مطابقة للعلامة المختارة.</div>
  </section>
    </div>
  </div>

<div class="offcanvas offcanvas-end type-editor crm-editor-wide" tabindex="-1" id="profileEditor" aria-labelledby="profileEditorTitle"><div class="offcanvas-header border-bottom"><h2 class="offcanvas-title h5" id="profileEditorTitle">تعديل بياناتي</h2><button type="button" class="btn-close text-reset" data-bs-dismiss="offcanvas" aria-label="إغلاق"></button></div><div class="offcanvas-body"><asp:Panel ID="profileEditorBody" runat="server" DefaultButton="btnSaveProfile"><asp:Literal ID="profileEditorMessage" runat="server" EnableViewState="false" /><asp:ValidationSummary runat="server" ValidationGroup="ProfileEditor" CssClass="alert alert-danger" HeaderText="يرجى مراجعة البيانات التالية:" /><section class="crm-form-section"><h6 class="crm-section-title">العلامة التجارية والفرع</h6><div class="alert alert-secondary"><asp:Literal ID="editorOrganization" runat="server" Mode="Encode" /></div><div class="form-text">تُدار العلامة والفرع ونوع العميل وحالة الحساب بواسطة إدارة النظام.</div></section><section class="crm-form-section"><h6 class="crm-section-title">شعار العميل (اختياري)</h6><div class="type-flex align-items-center gap-3 type-logo-upload"><asp:Image ID="logoPreview" runat="server" CssClass="rounded type-logo-preview" Width="80" Height="80" AlternateText="شعار العميل" ClientIDMode="Static" /><div class="flex-grow-1"><asp:FileUpload ID="logoUpload" runat="server" CssClass="form-control" accept="image/png,image/jpeg,image/gif" data-crm-logo-preview="logoPreview" /><div class="form-text">PNG أو JPG أو GIF، حتى 2 ميجابايت. اتركه فارغًا للاحتفاظ بالشعار الحالي.</div><div class="text-danger small" data-crm-logo-error=""></div></div></div></section><section class="crm-form-section"><h6 class="crm-section-title">بيانات العميل</h6><div class="row g-3"><div class="col-12 col-md-6"><asp:Label runat="server" AssociatedControlID="p_Name_AR" CssClass="form-label" Text="اسم العميل بالعربية" /><asp:TextBox ID="p_Name_AR" runat="server" CssClass="form-control" MaxLength="200" /><asp:RequiredFieldValidator runat="server" ControlToValidate="p_Name_AR" ValidationGroup="ProfileEditor" ErrorMessage="أدخل اسم العميل بالعربية." CssClass="text-danger small" Display="Dynamic" /></div><div class="col-12 col-md-6"><asp:Label runat="server" AssociatedControlID="p_Name_EN" CssClass="form-label" Text="اسم العميل بالإنجليزية" /><asp:TextBox ID="p_Name_EN" runat="server" CssClass="form-control" MaxLength="200" dir="ltr" /></div><div class="col-12 col-md-6"><asp:Label runat="server" AssociatedControlID="p_Phone" CssClass="form-label" Text="الهاتف" /><asp:TextBox ID="p_Phone" runat="server" CssClass="form-control" MaxLength="50" dir="ltr" /></div><div class="col-12 col-md-6"><asp:Label runat="server" AssociatedControlID="p_Email" CssClass="form-label" Text="البريد الإلكتروني" /><asp:TextBox ID="p_Email" runat="server" CssClass="form-control" MaxLength="254" TextMode="Email" dir="ltr" /></div><div class="col-12"><asp:Label runat="server" AssociatedControlID="p_Address" CssClass="form-label" Text="العنوان" /><asp:TextBox ID="p_Address" runat="server" CssClass="form-control" MaxLength="500" TextMode="MultiLine" Rows="3" /></div><div class="col-12 col-md-6"><asp:Label runat="server" AssociatedControlID="p_Country" CssClass="form-label" Text="البلد" /><asp:TextBox ID="p_Country" runat="server" CssClass="form-control" MaxLength="100" /></div><div class="col-12 col-md-6"><asp:Label runat="server" AssociatedControlID="p_Website" CssClass="form-label" Text="الموقع الإلكتروني" /><asp:TextBox ID="p_Website" runat="server" CssClass="form-control" MaxLength="500" dir="ltr" /></div><div class="col-12 col-md-6"><asp:Label runat="server" AssociatedControlID="p_Registration_Number" CssClass="form-label" Text="رقم تسجيل الشركة" /><asp:TextBox ID="p_Registration_Number" runat="server" CssClass="form-control" MaxLength="100" dir="ltr" /></div></div></section><div class="type-flex flex-wrap gap-2"><asp:LinkButton ID="btnSaveProfile" runat="server" CssClass="btn btn-primary" Text="