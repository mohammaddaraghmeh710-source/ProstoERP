<%@ Page Title="الشكاوى والاقتراحات" Language="vb" AutoEventWireup="false" MasterPageFile="~/Customer.Master" CodeBehind="Feedback.aspx.vb" Inherits="CRM.CustomerFeedback" %><asp:Content ID="body" runat="server" ContentPlaceHolderID="ContentPlaceHolder1"><div class="mb-4"><span class="badge bg-label-primary mb-2">صوتك يهمنا</span><h3>الشكاوى والاقتراحات</h3><p class="text-muted">أرسل ملاحظتك إلى مدير النظام وتابع حالتها من هنا.</p></div><asp:Literal ID="litMessage" runat="server"/><div class="row g-4"><div class="col-lg-7"><div class="card"><div class="card-header"><h5 class="mb-0">طلب جديد</h5></div><div class="card-body"><div class="row g-3"><div class="col-md-6"><asp:Label runat="server" AssociatedControlID="ddlType" CssClass="form-label" Text="نوع الطلب"/><asp:DropDownList ID="ddlType" runat="server" CssClass="form-select" AutoPostBack="true" OnSelectedIndexChanged="Type_Changed"/></div><div class="col-md-6"><asp:Label runat="server" AssociatedControlID="ddlBrand" CssClass="form-label" Text="العلامة التجارية"/><asp:DropDownList ID="ddlBrand" runat="server" CssClass="form-select" AutoPostBack="true" OnSelectedIndexChanged="Brand_Changed"/></div><div class="col-md-6"><asp:Label runat="server" AssociatedControlID="ddlBranch" CssClass="form-label" Text="الفرع"/><asp:DropDownList ID="ddlBranch" runat="server" CssClass="form-select"/></div><div class="col-md-6"><asp:Label runat="server" AssociatedControlID="ddlTopic" CssClass="form-label" Text="الموضوع"/><asp:DropDownList ID="ddlTopic" runat="server" CssClass="form-select"/></div><div class="col-12"><asp:Label runat="server" AssociatedControlID="txtMobile" CssClass="form-label" Text="رقم التواصل"/><asp:TextBox ID="txtMobile" runat="server" CssClass="form-control" MaxLength="30" TextMode="Phone"/></div><div class="col-12"><asp:Label runat="server" AssociatedControlID="txtTitle" CssClass="form-label" Text="عنوان الطلب"/><asp:TextBox ID="txtTitle" runat="server" CssClass="form-control" MaxLength="300"/></div><div class="col-12"><asp:Label runat="server" AssociatedControlID="txtDetails" CssClass="form-label" Text="التفاصيل"/><asp:TextBox ID="txtDetails" runat="server" CssClass="form-control" TextMode="MultiLine" Rows="5"/></div><div class="col-12"><asp:Label runat="server" AssociatedControlID="uploads" CssClass="form-label" Text="المرفقات (اختياري)"/><asp:FileUpload ID="uploads" runat="server" CssClass="form-control" AllowMultiple="true"/><div class="form-text">حتى 5 ملفات، 10 ميجابايت للملف. PDF وWord وExcel والصور. أضف الملفات بعد اختيار العلامة ونوع الطلب.</div></div><div class="col-12"><div class="alert alert-info mb-3">يُرسل الطلب باسم حساب العميل إلى مدير النظام.</div><asp:Button ID="btnSubmit" runat="server" OnClick="Submit_Click" Text="إرسال الطلب" CssClass="btn btn-primary"/></div></div></div></div></div><div class="col-lg-5"><div class="card"><div class="card-header"><h5 class="mb-0">طلباتي السابقة</h5></div><div class="card-body"><asp:Panel ID="empty" runat="server" CssClass="text-center text-muted py-4">لم ترسل أي طلب بعد.</asp:Panel><asp:Repeater ID="history" runat="server"><ItemTemplate><div class="border-bottom py-3"><div class="d-flex justify-content-between gap-2 mb-2"><span class="small text-muted">#<%#: Eval("ID") %> · <%#: Eval("TypeName") %></span><span class='<%# CRM.EmployeeFeedbackData.StatusCss(Eval("Status")) %>'><%#: CRM.EmployeeFeedbackData.StatusText(Eval("Status")) %></span></div><h6 class="mb-1"><a href='FeedbackDetail.aspx?id=<%# Eval("ID") %>'><%#: Eval("Title") %></a></h6><a class="btn btn-sm btn-label-primary mb-2" href='FeedbackDetail.aspx?id=<%# Eval("ID") %>'>عرض تفاصيل الطلب</a><span class="small text-muted"><%#: Eval("Brand_Title_Ar") %> · <%#: CRM.EmployeeFeedbackData.LogDate(Eval("AddedDate")) %></span></div></ItemTemplate></asp:Repeater></div></div></div></div></asp:Content>