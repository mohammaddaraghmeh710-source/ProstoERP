<%@ Page Title="دليل العمل" Language="vb" AutoEventWireup="false" MasterPageFile="~/Customer.Master" CodeBehind="WorkGuide.aspx.vb" Inherits="CRM.CustomerWorkGuide" %>
<asp:Content ID="head" ContentPlaceHolderID="HeadContent" runat="server">
<link rel="stylesheet" href="/assets/vendor/fonts/fontawesome.css"/><link rel="stylesheet" href="/assets/vendor/libs/datatables-bs5/datatables.bootstrap5.css"/><link rel="stylesheet" href="/assets/css/crm.css"/><link rel="stylesheet" href="/assets/css/crm-list.css"/><link rel="stylesheet" href="/assets/css/crm-workguide.css?v=20261018c"/>
<link rel="stylesheet" href="/assets/vendor/libs/jstree/jstree.css"/>
</asp:Content>
<asp:Content ID="body" ContentPlaceHolderID="ContentPlaceHolder1" runat="server">
<div class="crm-shell crm-types crm-workguide" dir="rtl">
 <div class="type-page-header type-flex align-items-center justify-content-between"><h1 class="h4 mb-0">دليل العمل</h1><nav aria-label="مسار التنقل"><ol class="breadcrumb mb-0"><li class="breadcrumb-item"><a href="Dashboard.aspx">الرئيسية</a></li><li class="breadcrumb-item active">دليل العمل</li></ol></nav></div>
 <asp:Literal ID="litMessage" runat="server" EnableViewState="false"/>
 <asp:Panel ID="pnlBody" runat="server">
  <div class="row g-4 mb-4">
   <div class="col-md-4"><div class="card type-stat-card"><div class="card-body type-flex align-items-start justify-content-between"><div><span>التصنيفات المسموحة</span><div class="type-stat-count"><span id="customerGuideCategoryCount"><asp:Literal ID="statCategories" runat="server"/></span></div></div><span class="badge bg-label-primary rounded type-stat-icon"><i class="bx bx-folder" aria-hidden="true"></i></span></div></div></div>
   <div class="col-md-4"><div class="card type-stat-card"><div class="card-body type-flex align-items-start justify-content-between"><div><span>الأدلة المتاحة</span><div class="type-stat-count"><span id="customerGuideItemCount"><asp:Literal ID="statItems" runat="server"/></span></div></div><span class="badge bg-label-success rounded type-stat-icon"><i class="bx bx-book-open" aria-hidden="true"></i></span></div></div></div>
   <div class="col-md-4"><div class="card type-stat-card"><div class="card-body"><span>صلاحية الاطلاع والتحميل</span><h5 class="mb-0 mt-2"><span id="customerGuideRights"><asp:Literal ID="litRight" runat="server" Mode="Encode"/></span></h5></div></div></div>
  </div>
  <div class="row g-4"><aside class="col-12 col-lg-4"><div class="card"><div class="card-header"><h2 class="h5 mb-0">تصنيفات دليل العمل</h2></div><div class="card-body"><asp:DropDownList ID="customerGuideBrand" runat="server" ClientIDMode="Static" CssClass="form-select mb-3" aria-label="فلتر العلامة التجارية"/><input type="search" id="customerCategorySearch" class="form-control mb-3" placeholder="بحث في التصنيفات..." aria-label="بحث تصنيفات العميل"/><button type="button" id="customerAllCategories" class="btn btn-sm btn-label-primary mb-3">كل التصنيفات المسموحة</button><div id="customerCategoryTree" class="guide-tree customer-category-tree" aria-label="شجرة التصنيفات المسموحة"></div><script type="application/json" id="customerCategoryTreeData"><asp:Literal ID="litCategoryTree" runat="server"/></script></div></div></aside><div class="col-12 col-lg-8">
  <div class="card"><div class="card-header type-filter-header"><h2 class="h5 card-title">البحث في الأدلة</h2><asp:Panel ID="pnlSearch" runat="server" DefaultButton="btnSearch" CssClass="row g-3 align-items-center">
   <div class="visually-hidden"><asp:DropDownList ID="category" runat="server" ClientIDMode="Static" CssClass="form-select" aria-label="اختر التصنيف"/></div>
   <div class="col-12 col-md-9"><asp:TextBox ID="filterName" runat="server" CssClass="form-control" MaxLength="200" placeholder="بحث في الاسم أو الملخص أو نص التفاصيل..." aria-label="البحث في جميع الأدلة المتاحة" data-guide-search-source="1"/></div>
   <div class="col-12 col-md-3"><asp:LinkButton ID="btnSearch" runat="server" OnClick="Search_Click" CssClass="btn btn-primary" ToolTip="بحث" aria-label="بحث" data-bs-toggle="tooltip" CausesValidation="false"><i class="fa-solid fa-magnifying-glass me-2" aria-hidden="true"></i>بحث</asp:LinkButton></div>
  </asp:Panel><p class="small text-muted mt-3 mb-0">البحث يشمل نصوص الأدلة التي تملك صلاحية الاطلاع عليها. كل إجراء يتبع صلاحية التصنيف الموضح في صفه. مشاهدة Word تُحمّل الملف الأصلي وتتطلب صلاحية التحميل.</p></div>
  <div class="card-datatable table-responsive"><table id="ERPTable" data-enhanced="1" class="ERP_ProstoTBL card-list-table table border-top crm-table customer-guide-table"><thead><tr><th>الرقم</th><th>الدليل</th><th>التصنيف / العلامة التجارية</th><th>الملخص</th><th>الصيغة الأصلية</th><th data-orderable="false">الإجراءات</th></tr></thead><tbody>
  <asp:Repeater ID="guides" runat="server"><ItemTemplate><tr data-guide-brand='<%# Eval("Brand_ID") %>' data-guide-id='<%# Eval("ID") %>' data-guide-category='<%# Eval("Category_ID") %>'><td data-title="الرقم"><%#: Eval("ID") %></td><td data-title="الدليل"><span class="fw-semibold"><%#: Eval("Name_AR") %></span><small class="d-block text-muted" dir="ltr"><%#: Eval("Name_EN") %></small></td><td data-title="التصنيف"><span class="badge bg-label-primary"><%#: Eval("Category_Name") %></span><small class="d-block text-muted mt-1"><%#: Eval("Brand_Name") %></small></td><td data-title="الملخص" class="guide-summary"><div class="guide-excerpt"><%#: Eval("Summary_AR") %></div><small class="guide-excerpt d-block text-muted" dir="ltr"><%#: Eval("Summary_EN") %></small></td><td data-title="الصيغة الأصلية"><%#: If(Convert.ToString(Eval("File_Extension"))=".pdf", "PDF", "Word") %></td><td data-title="الإجراءات"><div class="type-flex type-row-actions">
   <asp:PlaceHolder runat="server" Visible='<%# CBool(Eval("Can_View")) %>'><a href='<%# CRM.CRMData.H(DetailsUrl(Eval("ID"), Eval("Category_ID"))) %>' class="btn btn-sm btn-icon type-row-action text-primary" data-guide-details="1" data-id='<%# Eval("ID") %>' data-category='<%# Eval("Category_ID") %>' data-title='<%# CRM.CRMData.H(Eval("Name_AR")) %>' title="التفاصيل" aria-label="التفاصيل" data-bs-toggle="tooltip"><i class="fa-solid fa-circle-info" aria-hidden="true"></i></a></asp:PlaceHolder>
   <asp:PlaceHolder runat="server" Visible='<%# CBool(Eval("Can_View")) AndAlso Convert.ToString(Eval("File_Extension"))=".pdf" %>'><button type="button" class="btn btn-sm btn-icon type-row-action text-primary" data-guide-action="view" data-id='<%# Eval("ID") %>' data-category='<%# Eval("Category_ID") %>' data-title='<%# CRM.CRMData.H(Eval("Name_AR")) %>' title="مشاهدة PDF" aria-label="مشاهدة PDF" data-bs-toggle="tooltip"><i class="fa-solid fa-eye" aria-hidden="true"></i></button></asp:PlaceHolder>
   <asp:PlaceHolder runat="server" Visible='<%# CBool(Eval("Can_Download")) %>'><button type="button" class="btn btn-sm btn-icon type-row-action text-secondary" data-guide-action="download" data-id='<%# Eval("ID") %>' data-category='<%# Eval("Category_ID") %>' data-extension='<%# CRM.CRMData.H(Eval("File_Extension")) %>' title='<%# If(Convert.ToString(Eval("File_Extension"))=".pdf", "تحميل الملف", "مشاهدة Word — تحميل الملف الأصلي") %>' aria-label='<%# If(Convert.ToString(Eval("File_Extension"))=".pdf", "تحميل الملف", "مشاهدة Word — تحميل الملف الأصلي") %>' data-bs-toggle="tooltip"><i class='<%# If(Convert.ToString(Eval("File_Extension"))=".pdf", "fa-solid fa-download", "fa-solid fa-file-word") %>' aria-hidden="true"></i></button></asp:PlaceHolder>
   </div></td></tr></ItemTemplate></asp:Repeater>
  </tbody></table></div></div></div></div>

  <div id="guideOperationStatus" class="mt-3" role="status" aria-live="polite"></div>
  <div class="modal fade" id="customerGuideViewer" tabindex="-1" aria-labelledby="guideViewerTitle" aria-hidden="true"><div class="modal-dialog modal-xl modal-dialog-scrollable"><div class="modal-content"><div class="modal-header"><h2 class="modal-title h5" id="guideViewerTitle">عارض دليل العمل</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="إغلاق"></button></div><div class="modal-body crm-guide-viewer">
   <div id="guidePdfStatus" class="text-muted small mb-3" role="status" aria-live="polite"></div>
   <div class="type-flex flex-wrap align-items-center justify-content-center gap-3 mb-3"><button id="guidePrevious" type="button" class="btn btn-sm btn-label-primary" disabled>السابق</button><span id="guidePageLabel" dir="ltr">—</span><button id="guideNext" type="button" class="btn btn-sm btn-label-primary" disabled>التالي</button><button id="guideZoomOut" type="button" class="btn btn-sm btn-icon btn-label-secondary" aria-label="تصغير" title="تصغير" disabled><i class="bx bx-zoom-out" aria-hidden="true"></i></button><span id="guideZoomLabel" dir="ltr">100%</span><button id="guideZoomIn" type="button" class="btn btn-sm btn-icon btn-label-secondary" aria-label="تكبير" title="تكبير" disabled><i class="bx bx-zoom-in" aria-hidden="true"></i></button></div><canvas id="guidePdfCanvas" class="d-none mx-auto" aria-label="صفحة الدليل"></canvas>
  </div></div></div></div>
 </asp:Panel>
</div>
<div id="customerGuideConfig" data-csrf='<%= CRM.CRMData.H(GuideCsrf) %>'></div>
<script src="/assets/vendor/libs/datatables/jquery.dataTables.js" defer></script><script src="/assets/vendor/libs/datatables-bs5/datatables-bootstrap5.js" defer></script><script src="/assets/js/crm-list.js?v=20261021suppliers" defer></script><script src="/assets/vendor/libs/jstree/jstree.js" defer></script><script src="/assets/js/crm-guide-tree-search.js?v=20261021multibrandb" defer></script><script src="/assets/js/customer-guide-details.js?v=20261021multibrandb" defer></script><script src="/assets/js/pdf.min.js" defer></script><script src="/assets/js/customer-workguide.js?v=20261017b" defer></script>
</asp:Content>
