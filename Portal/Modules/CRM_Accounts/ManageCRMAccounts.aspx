<%@ Page Title="العملاء" Language="vb" AutoEventWireup="false" MasterPageFile="~/Site.Master" CodeBehind="ManageCRMAccounts.aspx.vb" Inherits="CRM.ManageCRMAccounts" %>
<asp:Content ID="head" ContentPlaceHolderID="HeadContent" runat="server">
<link rel="stylesheet" href="/assets/vendor/libs/datatables-bs5/datatables.bootstrap5.css" />
<link rel="stylesheet" href="/assets/css/crm.css?v=20260913c" />
<link rel="stylesheet" href="/assets/css/crm-list.css?v=20261021organization" />
</asp:Content>
<asp:Content ID="body" ContentPlaceHolderID="ContentPlaceHolder1" runat="server">
<div class="container-xxl flex-grow-1 container-p-y crm-shell crm-types" dir="rtl">
  <div class="type-page-header type-flex align-items-center justify-content-between"><h1 class="h4 mb-0">العملاء</h1><nav aria-label="مسار التنقل"><ol class="breadcrumb mb-0"><li class="breadcrumb-item"><a href="/Modules/CRM_Account_Types/Overview.aspx">إدارة العملاء</a></li><li class="breadcrumb-item active" aria-current="page">العملاء</li></ol></nav></div>
  <asp:Literal ID="litMessage" runat="server" EnableViewState="false" />
  <asp:Panel ID="pnlBody" runat="server">
    <div class="row g-4 mb-4" aria-label="إحصائيات العملاء">
      <div class="col-12 col-md-4"><div class="card type-stat-card"><div class="card-body type-flex align-items-start justify-content-between"><div><span>إجمالي العناصر</span><div class="type-stat-count"><asp:Literal ID="statTotal" runat="server" Text="—" /></div></div><span class="badge bg-label-primary rounded type-stat-icon"><i class="bx bx-category" aria-hidden="true"></i></span></div></div></div>
      <div class="col-12 col-md-4"><div class="card type-stat-card"><div class="card-body type-flex align-items-start justify-content-between"><div><span>العناصر الفعالة</span><div class="type-stat-count"><asp:Literal ID="statActive" runat="server" Text="—" /></div></div><span class="badge bg-label-success rounded type-stat-icon"><i class="bx bx-check-circle" aria-hidden="true"></i></span></div></div></div>
      <div class="col-12 col-md-4"><div class="card type-stat-card"><div class="card-body type-flex align-items-start justify-content-between"><div><span>العناصر الموقوفة</span><div class="type-stat-count"><asp:Literal ID="statInactive" runat="server" Text="—" /></div></div><span class="badge bg-label-warning rounded type-stat-icon"><i class="bx bx-pause-circle" aria-hidden="true"></i></span></div></div></div>
    </div>
    <div class="card">
      <div class="card-header type-filter-header">
        <h2 class="card-title h5 mb-0">تصفية البحث</h2>
      <asp:Panel ID="pnlSearch" runat="server" DefaultButton="btnSearch" CssClass="row g-3 align-items-center" ClientIDMode="Static"><div class="col-12 col-md-6 col-xl-6"><div class="input-group input-group-merge"><span class="input-group-text"><i class="bx bx-search" aria-hidden="true"></i></span><asp:TextBox ID="filterName" runat="server" CssClass="form-control" MaxLength="200" placeholder="اسم العميل بالعربية أو الإنجليزية" aria-label="اسم العميل بالعربية أو الإنجليزية" /></div></div><div class="col-12 col-md-6 col-xl-3"><asp:DropDownList ID="filterType" runat="server" data-crm-search-select="بحث بنوع العميل..." CssClass="form-select" aria-label="نوع العميل"></asp:DropDownList></div><div class="col-12 col-md-6 col-xl-3"><asp:DropDownList ID="filterBrand" runat="server" data-crm-search-select="بحث بالعلامة التجارية..." ClientIDMode="Static" CssClass="form-select" aria-label="العلامة التجارية" data-crm-branch-target="filterBranch" /></div><div class="col-12 col-md-6 col-xl-3"><asp:DropDownList ID="filterBranch" runat="server" data-crm-search-select="بحث بالفرع..." ClientIDMode="Static" CssClass="form-select" aria-label="الفرع" /></div><div class="col-12 col-md-6 col-xl-3"><asp:DropDownList ID="filterStatus" runat="server" CssClass="form-select" aria-label="الحالة"><asp:ListItem Value="" Text="اختر الحالة" /><asp:ListItem Value="1" Text="فعال" /><asp:ListItem Value="0" Text="موقوف" /></asp:DropDownList></div><div class="col-12 col-md-6 col-xl-6 type-flex gap-2 justify-content-xl-end"><asp:LinkButton ID="btnSearch" runat="server" CssClass="btn btn-primary" OnClick="Search_Click" CausesValidation="false" ToolTip="بحث" aria-label="بحث" data-bs-toggle="tooltip"><i class="fa-solid fa-magnifying-glass me-2" aria-hidden="true"></i>بحث</asp:LinkButton><asp:LinkButton ID="btnReset" runat="server" CssClass="btn btn-icon btn-label-secondary" OnClick="ResetFilters_Click" CausesValidation="false" ToolTip="إعادة تعيين" aria-label="إعادة تعيين" data-bs-toggle="tooltip"><i class="fa-solid fa-rotate-left" aria-hidden="true"></i></asp:LinkButton></div></asp:Panel>
      </div>
      <asp:Panel ID="pnlTableActions" runat="server" CssClass="type-flex type-toolbar-controls align-items-center" ClientIDMode="Static">
        <asp:LinkButton ID="btnNewRecord" runat="server" CssClass="btn btn-primary" OnClick="NewRecord_Click" CausesValidation="false"><i class="fa-solid fa-plus me-2" aria-hidden="true"></i>إضافة عميل</asp:LinkButton>
      </asp:Panel>
      <div class="card-datatable table-responsive">
        <table id="ERPTable" data-enhanced="1" class="ERP_ProstoTBL card-list-table table border-top crm-table"><thead><tr><th>الرقم</th><th>العميل</th><th>نوع العميل</th><th>العلامات التجارية / الفروع</th><th>المسؤول</th><th>جهات الاتصال</th><th>بيانات التواصل</th><th>الحالة</th><th data-orderable="false">الإجراءات</th></tr></thead><tbody><asp:ListView ID="lstData" runat="server" DataKeyNames="ID,Row_Version" OnItemCommand="Inline_RowCommand"><LayoutTemplate><asp:PlaceHolder ID="itemPlaceholder" runat="server" /></LayoutTemplate><ItemTemplate><tr><td data-title="الرقم"><%#: Eval("ID") %></td><td data-title="العميل"><div class="type-flex align-items-center gap-3"><img class="type-customer-logo" src='<%# CRM.CRMData.H(Eval("Logo_Url")) %>' alt="شعار العميل" width="40" height="40" loading="lazy" /><div class="type-record-name"><span class="fw-semibold"><%#: Eval("Name_AR") %></span><small class="d-block text-muted" dir="auto"><%#: Eval("Name_EN") %></small></div></div></td><td data-title="نوع العميل"><%#: Eval("Type_Name") %></td><td data-title="العلامات التجارية / الفروع"><div class="type-cell-details"><span><%#: If(IsDBNull(Eval("Brand_Name")), "غير محددة", Eval("Brand_Name")) %></span><small class="d-block text-muted"><%#: If(IsDBNull(Eval("Branch_Name")), "بدون فروع محددة", Eval("Branch_Name")) %></small></div></td><td data-title="المسؤول"><%#: Eval("Owner_Name") %></td><td data-title="جهات الاتصال"><a class="type-contact-count" href='<%# "/Modules/CRM_Contacts/ManageCRMContacts.aspx?account=" & Convert.ToString(Eval("ID")) %>' aria-label='<%# "جهات اتصال " & CRM.CRMData.H(Eval("Name_AR")) %>'><%#: Eval("Contact_Count") %></a></td><td data-title="بيانات التواصل"><div class="type-cell-details" dir="auto"><span class="d-block" dir="ltr"><%#: Eval("Phone") %></span><small class="d-block text-muted" dir="ltr"><%#: Eval("Email") %></small></div></td><td data-title="الحالة"><span class='<%# If(Convert.ToBoolean(Eval("Is_Active")), "badge bg-label-success", "badge bg-label-secondary") %>'><%#: If(Convert.ToBoolean(Eval("Is_Active")), "فعال", "موقوف") %></span></td><td data-title="الإجراءات"><div class="type-flex type-row-actions"><asp:HyperLink runat="server" Visible="<%# CRMIsAdmin %>" NavigateUrl='<%# "/Modules/CRM_WorkGuide/Permissions.aspx?account=" & Convert.ToString(Eval("ID")) %>' CssClass="btn btn-sm btn-icon type-row-action text-primary" ToolTip="صلاحيات دليل العمل" aria-label="صلاحيات دليل العمل" data-bs-toggle="tooltip"><i class="fa-solid fa-user-shield" aria-hidden="true"></i></asp:HyperLink>
<asp:LinkButton runat="server" CssClass="btn btn-sm btn-icon type-row-action text-secondary" CommandName="EditRecord" CommandArgument='<%# Eval("ID") %>' ToolTip="تعديل" aria-label="تعديل" data-bs-toggle="tooltip" CausesValidation="false"><i class="fa-solid fa-pen-to-square" aria-hidden="true"></i></asp:LinkButton>
<asp:LinkButton runat="server" CssClass="btn btn-sm btn-icon type-row-action text-warning" CommandName="Deactivate" CommandArgument='<%# Eval("ID") %>' Visible='<%# Convert.ToBoolean(Eval("Is_Active")) %>' ToolTip="إيقاف" aria-label="إيقاف" data-bs-toggle="tooltip" CausesValidation="false"><i class="fa-solid fa-pause" aria-hidden="true"></i></asp:LinkButton>
<asp:LinkButton runat="server" CssClass="btn btn-sm btn-icon type-row-action text-success" CommandName="Activate" CommandArgument='<%# Eval("ID") %>' Visible='<%# Not Convert.ToBoolean(Eval("Is_Active")) %>' ToolTip="تفعيل" aria-label="تفعيل" data-bs-toggle="tooltip" CausesValidation="false"><i class="fa-solid fa-play" aria-hidden="true"></i></asp:LinkButton>
<asp:LinkButton runat="server" CssClass="btn btn-sm btn-icon type-row-action text-danger" CommandName="AskDelete" CommandArgument='<%# Eval("ID") %>' ToolTip="حذف" aria-label="حذف" data-bs-toggle="tooltip" CausesValidation="false"><i class="fa-solid fa-trash-can" aria-hidden="true"></i></asp:LinkButton>
</div></td></tr></ItemTemplate></asp:ListView></tbody></table>
      </div>
    </div>
    <div class="modal fade" id="crmDeleteModal" tabindex="-1" aria-labelledby="crmDeleteTitle" aria-hidden="true">
      <div class="modal-dialog modal-dialog-centered"><div class="modal-content">
        <div class="modal-header"><h2 class="modal-title h5" id="crmDeleteTitle">حذف عميل</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="إغلاق"></button></div>
        <div class="modal-body"><p class="mb-0">هل تريد حذف عميل «<strong><asp:Literal ID="litDeleteName" runat="server" Mode="Encode" /></strong>»؟</p></div>
        <div class="modal-footer"><button type="button" class="btn btn-label-secondary" data-bs-dismiss="modal">إلغاء</button><asp:LinkButton ID="btnConfirmDelete" runat="server" CssClass="btn btn-danger" CausesValidation="false" OnClick="ConfirmDelete_Click"><i class="fa-solid fa-trash-can me-2" aria-hidden="true"></i>تأكيد الحذف</asp:LinkButton></div>
      </div></div>
    </div>
<div class="offcanvas offcanvas-end type-editor crm-editor-wide" tabindex="-1" id="crmEditor" aria-labelledby="crmEditorTitle"><div class="offcanvas-header border-bottom"><h2 class="offcanvas-title h5" id="crmEditorTitle"><asp:Literal ID="litEditorTitle" runat="server" Text="إضافة عميل" /></h2><button type="button" class="btn-close text-reset" data-bs-dismiss="offcanvas" aria-label="إغلاق"></button></div><div class="offcanvas-body"><asp:Panel ID="pnlEditor" runat="server" DefaultButton="btnSaveRecord"><asp:Literal ID="litEditorMessage" runat="server" EnableViewState="false" /><asp:ValidationSummary runat="server" ValidationGroup="CRMEditor" CssClass="alert alert-danger" HeaderText="يرجى مراجعة البيانات التالية:" /><section class="crm-form-section crm-account-organization"><h6 class="crm-section-title">العلامات التجارية والفروع</h6><div class="row g-3"><div class="col-12"><asp:Label runat="server" AssociatedControlID="f_Account_Brands" CssClass="form-label" Text="العلامات التجارية *" /><asp:ListBox ID="f_Account_Brands" runat="server" ClientIDMode="Static" SelectionMode="Multiple" CssClass="form-select" data-crm-account-branches="f_Account_Branches" data-crm-search-select="ابحث باسم العلامة التجارية..." data-placeholder="اختر علامة تجارية واحدة أو أكثر" aria-required="true" /><asp:RequiredFieldValidator ValidationGroup="CRMEditor" runat="server" ControlToValidate="f_Account_Brands" ErrorMessage="اختر علامة تجارية واحدة على الأقل للعميل." CssClass="text-danger small" Display="Dynamic" /></div><div class="col-12"><asp:Label runat="server" AssociatedControlID="f_Account_Branches" CssClass="form-label" Text="الفروع (اختياري)" /><asp:ListBox ID="f_Account_Branches" runat="server" ClientIDMode="Static" SelectionMode="Multiple" CssClass="form-select" data-crm-search-select="ابحث باسم الفرع أو العلامة التجارية..." data-placeholder="اختر فرعًا واحدًا أو أكثر" aria-describedby="accountBranchesHelp" /><div class="form-text" id="accountBranchesHelp" aria-live="polite">يمكن اختيار عدة فروع لكل علامة تجارية، أو الحفظ دون تحديد فروع.</div></div></div></section>
<section class="crm-form-section"><h6 class="crm-section-title">بيانات العميل</h6><div class="type-logo-upload type-flex align-items-center gap-3 mb-4">
<asp:Image ID="logoPreview" runat="server" ClientIDMode="Static" ImageUrl="/assets/img/illustrations/customer-default.svg" AlternateText="شعار العميل" CssClass="type-logo-preview rounded" Width="80" Height="80" />
<div class="flex-grow-1"><asp:Label runat="server" AssociatedControlID="logoUpload" CssClass="form-label" Text="شعار العميل (اختياري)" />
<asp:FileUpload ID="logoUpload" runat="server" CssClass="form-control" accept="image/png,image/jpeg,image/gif" data-crm-logo-preview="logoPreview" />
<div class="form-text">PNG أو JPG أو GIF، بحد أقصى 2 ميجابايت. يبقى الشعار الحالي إذا لم تختر صورة جديدة.</div><div class="text-danger small" data-crm-logo-error role="alert" aria-live="polite"></div></div></div><div class="row g-3"><div class="col-12 col-md-6"><asp:Label runat="server" AssociatedControlID="f_Name_AR" CssClass="form-label" Text="اسم العميل" /><asp:TextBox ID="f_Name_AR" runat="server" CssClass="form-control" MaxLength="200" /><asp:RequiredFieldValidator runat="server" ControlToValidate="f_Name_AR" ValidationGroup="CRMEditor" ErrorMessage="أدخل الاسم." CssClass="text-danger small" Display="Dynamic" /></div><div class="col-12 col-md-6"><asp:Label runat="server" AssociatedControlID="f_Name_EN" CssClass="form-label" Text="الاسم الإنجليزي" /><asp:TextBox ID="f_Name_EN" runat="server" CssClass="form-control" MaxLength="200" dir="ltr" /></div><div class="col-12 col-md-6"><asp:Label runat="server" AssociatedControlID="f_Account_Type_ID" CssClass="form-label" Text="نوع العميل" /><asp:DropDownList ID="f_Account_Type_ID" runat="server" CssClass="form-select" /></div><div class="col-12 col-md-6"><asp:Label runat="server" AssociatedControlID="f_Owner_ID" CssClass="form-label" Text="مسؤول العميل" /><asp:DropDownList ID="f_Owner_ID" runat="server" CssClass="form-select" /></div><div class="col-12 col-md-6"><asp:Label runat="server" AssociatedControlID="f_Registration_Number" CssClass="form-label" Text="رقم تسجيل الشركة" /><asp:TextBox ID="f_Registration_Number" runat="server" CssClass="form-control" MaxLength="100" dir="ltr" /></div></div></section>

<section class="crm-form-section"><h6 class="crm-section-title">بيانات التواصل والعنوان</h6><div class="row g-3"><div class="col-12 col-md-6"><asp:Label runat="server" AssociatedControlID="f_Phone" CssClass="form-label" Text="هاتف الشركة" /><asp:TextBox ID="f_Phone" runat="server" CssClass="form-control" MaxLength="50" dir="ltr" /></div><div class="col-12 col-md-6"><asp:Label runat="server" AssociatedControlID="f_Email" CssClass="form-label" Text="بريد الشركة" /><asp:TextBox ID="f_Email" runat="server" CssClass="form-control" MaxLength="254" TextMode="Email" dir="ltr" /></div><div class="col-12 col-md-6"><asp:Label runat="server" AssociatedControlID="f_Website" CssClass="form-label" Text="الموقع الإلكتروني" /><asp:TextBox ID="f_Website" runat="server" CssClass="form-control" MaxLength="500" dir="ltr" /></div><div class="col-12 col-md-6"><asp:Label runat="server" AssociatedControlID="f_Country" CssClass="form-label" Text="البلد" /><asp:TextBox ID="f_Country" runat="server" CssClass="form-control" MaxLength="100" /></div><div class="col-12"><asp:Label runat="server" AssociatedControlID="f_Address" CssClass="form-label" Text="العنوان" /><asp:TextBox ID="f_Address" runat="server" CssClass="form-control" MaxLength="500" TextMode="MultiLine" Rows="3" /></div></div></section>
<section class="crm-form-section"><h6 class="crm-section-title">ملاحظات وحالة العميل</h6><div class="row g-3"><div class="col-12"><asp:Label runat="server" AssociatedControlID="f_Notes" CssClass="form-label" Text="ملاحظات" /><asp:TextBox ID="f_Notes" runat="server" CssClass="form-control" MaxLength="2000" TextMode="MultiLine" Rows="3" /></div></div></section>
<asp:Panel ID="pnlCredentials" runat="server"><section class="crm-form-section"><h6 class="crm-section-title">بيانات حساب العميل</h6><div class="form-text mb-3">اختياري عند الإضافة. اترك كلمة المرور فارغة للإبقاء عليها عند التعديل. تغيير بيانات الدخول يُنهي جلسات العميل الحالية.</div><div class="row g-3">
<div class="col-12 col-md-6"><asp:Label runat="server" AssociatedControlID="txtUsername" CssClass="form-label" Text="اسم المستخدم" /><asp:TextBox ID="txtUsername" runat="server" CssClass="form-control" MaxLength="100" autocomplete="off" dir="ltr" /></div>
<div class="col-12 col-md-6"><asp:Label runat="server" AssociatedControlID="txtPassword" CssClass="form-label" Text="كلمة مرور جديدة" /><asp:TextBox ID="txtPassword" runat="server" TextMode="Password" EnableViewState="false" CssClass="form-control" MaxLength="128" autocomplete="new-password" /><div class="form-text">من 8 إلى 128 حرفًا.</div></div>
</div></section></asp:Panel>
<div class="type-account-state mb-4"><div class="mb-2"><asp:CheckBox ID="chkIsActive" runat="server" Text=" فعال" Checked="true" /></div><asp:Panel ID="pnlLoginState" runat="server"><asp:CheckBox ID="chkLoginActive" runat="server" Text=" السماح للعميل بتسجيل الدخول" Checked="true" /></asp:Panel></div><div class="type-flex flex-wrap gap-2"><asp:LinkButton ID="btnSaveRecord" runat="server" CssClass="btn btn-primary" OnClick="SaveRecord_Click" ValidationGroup="CRMEditor" Text="حفظ" /><button type="button" class="btn btn-label-secondary" data-bs-dismiss="offcanvas">إلغاء</button></div></asp:Panel></div></div>
  </asp:Panel>
</div>
<script src="/assets/js/crm-list.js?v=20261021organization"></script>
</asp:Content>
