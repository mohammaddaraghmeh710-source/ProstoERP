<div class="col-12 col-md-6"><asp:Label runat="server" AssociatedControlID="guideNameAr" CssClass="form-label" Text="الاسم بالعربية" /><asp:TextBox ID="guideNameAr" runat="server" CssClass="form-control" MaxLength="200" /><asp:RequiredFieldValidator runat="server" ControlToValidate="guideNameAr" ValidationGroup="GuideEditor" ErrorMessage="أدخل الاسم بالعربية." CssClass="text-danger small" Display="Dynamic" /></div>
<div class="col-12 col-md-6"><asp:Label runat="server" AssociatedControlID="guideNameEn" CssClass="form-label" Text="الاسم بالإنجليزية" /><asp:TextBox ID="guideNameEn" runat="server" CssClass="form-control" MaxLength="200" dir="ltr" /><asp:RequiredFieldValidator runat="server" ControlToValidate="guideNameEn" ValidationGroup="GuideEditor" ErrorMessage="أدخل الاسم بالإنجليزية." CssClass="text-danger small" Display="Dynamic" /></div>
<div class="col-12"><asp:Label runat="server" AssociatedControlID="guideSummaryAr" CssClass="form-label" Text="الملخص بالعربية" /><asp:TextBox ID="guideSummaryAr" runat="server" CssClass="form-control" MaxLength="4000" TextMode="MultiLine" Rows="3" /><asp:RequiredFieldValidator runat="server" ControlToValidate="guideSummaryAr" ValidationGroup="GuideEditor" ErrorMessage="أدخل الملخص بالعربية." CssClass="text-danger small" Display="Dynamic" /></div>
<div class="col-12"><asp:Label runat="server" AssociatedControlID="guideSummaryEn" CssClass="form-label" Text="الملخص بالإنجليزية" /><asp:TextBox ID="guideSummaryEn" runat="server" CssClass="form-control" MaxLength="4000" TextMode="MultiLine" Rows="3" dir="ltr" /><asp:RequiredFieldValidator runat="server" ControlToValidate="guideSummaryEn" ValidationGroup="GuideEditor" ErrorMessage="أدخل الملخص بالإنجليزية." CssClass="text-danger small" Display="Dynamic" /></div>
<div class="col-12 col-md-6"><asp:Label runat="server" AssociatedControlID="guideOrder" CssClass="form-label" Text="الترتيب" /><asp:TextBox ID="guideOrder" runat="server" CssClass="form-control" MaxLength="7" TextMode="Number" min="0" max="1000000" /><asp:RequiredFieldValidator runat="server" ControlToValidate="guideOrder" ValidationGroup="GuideEditor" ErrorMessage="أدخل الترتيب." CssClass="text-danger small" Display="Dynamic" /><asp:RangeValidator runat="server" ControlToValidate="guideOrder" ValidationGroup="GuideEditor" Type="Integer" MinimumValue="0" MaximumValue="1000000" ErrorMessage="أدخل ترتيبًا صحيحًا من 0 إلى 1000000." CssClass="text-danger small" Display="Dynamic" /></div>
   </div></section>
   <section class="crm-form-section"><h6 class="crm-section-title">النص التفصيلي للدليل</h6><p class="form-text">يمكن تنسيق النص بالعربية والإنجليزية. يبقى الملخص والملف منفصلين.</p><div class="row g-3"><div class="col-12"><asp:Label runat="server" AssociatedControlID="guideDetailsAr" CssClass="form-label" Text="التفاصيل بالعربية"/><asp:TextBox ID="guideDetailsAr" runat="server" ClientIDMode="Static" TextMode="MultiLine" Rows="8" ValidateRequestMode="Disabled" CssClass="form-control"/></div><div class="col-12"><asp:Label runat="server" AssociatedControlID="guideDetailsEn" CssClass="form-label" Text="التفاصيل بالإنجليزية"/><asp:TextBox ID="guideDetailsEn" runat="server" ClientIDMode="Static" TextMode="MultiLine" Rows="8" ValidateRequestMode="Disabled" CssClass="form-control" dir="ltr"/></div></div></section>
