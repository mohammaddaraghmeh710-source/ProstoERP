  <div class="offcanvas offcanvas-end type-editor crm-editor-wide" tabindex="-1" id="crmGuideEditor" aria-labelledby="crmGuideEditorTitle"><div class="offcanvas-header border-bottom"><h2 class="offcanvas-title h5" id="crmGuideEditorTitle"><asp:Literal ID="litGuideTitle" runat="server" Text="إضافة دليل عمل" /></h2><button type="button" class="btn-close text-reset" data-bs-dismiss="offcanvas" aria-label="إغلاق"></button></div><div class="offcanvas-body"><asp:Panel ID="pnlGuideEditor" runat="server" DefaultButton="btnSaveGuide"><asp:Literal ID="litGuideMessage" runat="server" EnableViewState="false" /><asp:ValidationSummary runat="server" ValidationGroup="GuideEditor" CssClass="alert alert-danger" HeaderText="يرجى مراجعة البيانات التالية:" />
