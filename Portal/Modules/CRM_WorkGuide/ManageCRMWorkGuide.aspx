     <div class="col-12 col-md-2"><asp:DropDownList ID="filterCategory" runat="server" data-crm-search-select="بحث باسم التصنيف..." CssClass="form-select" ClientIDMode="Static" aria-label="التصنيف والفروع التابعة له" /></div>
