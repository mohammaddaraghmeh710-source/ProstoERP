   <asp:Panel ID="pnlTableActions" runat="server" CssClass="type-flex type-toolbar-controls align-items-center" ClientIDMode="Static"><a href="Permissions.aspx" class="btn btn-label-primary"><i class="fa-solid fa-user-shield me-2" aria-hidden="true"></i>صلاحيات العملاء</a><asp:LinkButton ID="btnManageCategories" runat="server" CssClass="btn btn-label-secondary" OnClick="ManageCategories_Click" CausesValidation="false"><i class="fa-solid fa-folder-tree me-2" aria-hidden="true"></i>تصنيفات دليل العمل</asp:LinkButton><asp:LinkButton ID="btnNewGuide" runat="server" CssClass="btn btn-primary" OnClick="NewGuide_Click" CausesValidation="false"><i class="fa-solid fa-plus me-2" aria-hidden="true"></i>إضافة دليل عمل</asp:LinkButton></asp:Panel>
   <div class="card-datatable table-responsive"><table id="ERPTable" data-enhanced="1" class="ERP_ProstoTBL card-list-table table border-top crm-table"><thead><tr><th>الرقم</th><th>الاسم</th><th>العلامة التجارية</th><th>الملخص</th><th>التصنيفات</th><th data-orderable="false">الملف</th><th>الترتيب</th><th>الحالة</th><th data-orderable="false">الإجراءات</th></tr></thead><tbody>
    <asp:ListView ID="lstData" runat="server" DataKeyNames="ID,Row_Version" OnItemCommand="Guide_RowCommand"><LayoutTemplate><asp:PlaceHolder ID="itemPlaceholder" runat="server" /></LayoutTemplate><ItemTemplate>
    <tr><td data-title="الرقم"><%#: Eval("ID") %></td><td data-title="الاسم"><div class="type-flex align-items-center gap-3"><span class="type-record-icon badge bg-label-primary rounded"><i class="bx bx-book-open fs-4" aria-hidden="true"></i></span><div class="type-record-name"><span class="fw-semibold"><%#: Eval("Name_AR") %></span><small class="d-block text-muted" dir="ltr"><%#: Eval("Name_EN") %></small></div></div></td><td data-title="العلامة التجارية"><%#: Eval("Brand_Name") %></td><td data-title="الملخص" class="guide-summary"><div class="guide-excerpt"><%#: Eval("Summary_AR") %></div><small class="guide-excerpt d-block text-muted" dir="ltr"><%#: Eval("Summary_EN") %></small></td><td data-title="التصنيفات" class="guide-categories-cell"><%#: Eval("Category_Names") %></td><td data-title="الملف"><a class="btn btn-sm btn-icon type-row-action text-primary" href='<%# "File.aspx?id=" & Convert.ToString(Eval("ID")) %>' aria-label="تحميل الملف" title="تحميل الملف" data-bs-toggle="tooltip"><i class='<%# If(Convert.ToString(Eval("File_Extension"))=".pdf", "fa-solid fa-file-pdf", "fa-solid fa-file-word") %>' aria-hidden="true"></i></a><small class="d-block text-muted"><%#: If(Convert.ToString(Eval("File_Extension"))=".pdf", "PDF", "Word") %></small></td><td data-title="الترتيب"><%#: Eval("Sort_Order") %></td><td data-title="الحالة"><span class='<%# If(Convert.ToBoolean(Eval("Is_Active")), "badge bg-label-success", "badge bg-label-secondary") %>'><%#: If(Convert.ToBoolean(Eval("Is_Active")), "فعال", "موقوف") %></span></td><td data-title="الإجراءات"><div class="type-flex type-row-actions">
<asp:LinkButton runat="server" CssClass="btn btn-sm btn-icon type-row-action text-secondary" CommandName="EditGuide" CommandArgument='<%# Eval("ID") %>' ToolTip="تعديل" aria-label="تعديل" data-bs-toggle="tooltip" CausesValidation="false"><i class="fa-solid fa-pen-to-square" aria-hidden="true"></i></asp:LinkButton>
<asp:LinkButton runat="server" CssClass="btn btn-sm btn-icon type-row-action text-warning" CommandName="Deactivate" CommandArgument='<%# Eval("ID") %>' Visible='<%# Convert.ToBoolean(Eval("Is_Active")) %>' ToolTip="إيقاف" aria-label="إيقاف" data-bs-toggle="tooltip" CausesValidation="false"><i class="fa-solid fa-pause" aria-hidden="true"></i></asp:LinkButton>
<asp:LinkButton runat="server" CssClass="btn btn-sm btn-icon type-row-action text-success" CommandName="Activate" CommandArgument='<%# Eval("ID") %>' Visible='<%# Not Convert.ToBoolean(Eval("Is_Active")) %>' ToolTip="تفعيل" aria-label="تفعيل" data-bs-toggle="tooltip" CausesValidation="false"><i class="fa-solid fa-play" aria-hidden="true"></i></asp:LinkButton>
<asp:LinkButton runat="server" CssClass="btn btn-sm btn-icon type-row-action text-danger" CommandName="AskDelete" CommandArgument='<%# Eval("ID") %>' ToolTip="حذف" aria-label="حذف" data-bs-toggle="tooltip" CausesValidation="false"><i class="fa-solid fa-trash-can" aria-hidden="true"></i></asp:LinkButton>
    </div></td></tr></ItemTemplate></asp:ListView>
   </tbody></table></div>
