<div class="correspondence-sidebar-header">
<div class="d-flex align-items-center justify-content-between gap-2 mb-2"><div class="d-flex align-items-center gap-2"><a class="btn btn-sm btn-icon btn-label-secondary" href='<%= If(IsAdministrator,"Dashboard.aspx","/Modules/Employees/MyProfile.aspx") %>' title="العودة" aria-label="العودة"><i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a><h5 class="mb-0">المراسلات</h5></div><asp:HyperLink ID="lnkNew" runat="server" NavigateUrl="AddCorrespondence.aspx" data-correspondence-create="true" CssClass="btn btn-sm btn-primary"><i class="fa-solid fa-plus me-1" aria-hidden="true"></i>مراسلة جديدة</asp:HyperLink></div>
<asp:Panel ID="pnlNavigation" runat="server" Visible="false" />
<asp:UpdatePanel ID="upFilters" runat="server" UpdateMode="Conditional"><ContentTemplate>
<asp:Panel ID="pnlTitleSearch" runat="server" CssClass="correspondence-search mb-2"><label for="txtTitleSearch" class="visually-hidden">البحث بالاسم أو العنوان أو رقم المراسلة</label><asp:TextBox ID="txtTitleSearch" runat="server" ClientIDMode="Static" CssClass="form-control" MaxLength="200" placeholder="البحث بالاسم أو العنوان أو رقم المراسلة…" /></asp:Panel>
<details class="correspondence-filters"><summary class="text-primary py-2"><i class="bx bx-filter-alt me-1"></i>فلاتر البحث والمتابعة</summary><div class="pt-2 pb-3"><asp:Panel ID="pnlSearch" runat="server" DefaultButton="btnSearch" CssClass="row g-3"><div class="col-12 col-sm-6 col-lg-12"><asp:Label runat="server" AssociatedControlID="txtPerson" CssClass="form-label" Text="اسم أحد الأطراف" /><asp:TextBox ID="txtPerson" runat="server" ClientIDMode="Static" CssClass="form-control" MaxLength="200" /></div><div class="col-12 col-sm-6 col-lg-12"><asp:Label runat="server" AssociatedControlID="ddlFilter" CssClass="form-label" Text="الحالة" /><asp:DropDownList ID="ddlFilter" runat="server" CssClass="form-select" ><asp:ListItem Value="all">جميع الحالات</asp:ListItem><asp:ListItem Value="unread">غير مقروءة لي</asp:ListItem><asp:ListItem Value="active">فعالة</asp:ListItem><asp:ListItem Value="noReply">مفتوحة دون رد</asp:ListItem><asp:ListItem Value="overdue">متأخرة</asp:ListItem><asp:ListItem Value="closed">منتهية</asp:ListItem><asp:ListItem Value="archived">مؤرشفة إداريًا</asp:ListItem><asp:ListItem Value="followup">تحتاج متابعة حساب معطل</asp:ListItem><asp:ListItem Value="legacy">سابقة لحفظ التبعية</asp:ListItem></asp:DropDownList></div><div class="col-12 col-sm-6 col-lg-12"><asp:Label runat="server" AssociatedControlID="ddlKind" CssClass="form-label" Text="النوع" /><asp:DropDownList ID="ddlKind" runat="server" CssClass="form-select" ><asp:ListItem Value="0">جميع الأنواع</asp:ListItem><asp:ListItem Value="1">مراسلة عادية</asp:ListItem><asp:ListItem Value="2">تكليف</asp:ListItem></asp:DropDownList></div><div class="col-12 col-sm-6 col-lg-12"><asp:Label runat="server" AssociatedControlID="ddlPriority" CssClass="form-label" Text="الأولوية" /><asp:DropDownList ID="ddlPriority" runat="server" CssClass="form-select" ></asp:DropDownList></div><div class="col-12 col-sm-6 col-lg-12"><asp:Label runat="server" AssociatedControlID="txtFrom" CssClass="form-label" Text="من تاريخ الإنشاء" /><asp:TextBox ID="txtFrom" runat="server" CssClass="form-control" TextMode="Date" /></div><div class="col-12 col-sm-6 col-lg-12"><asp:Label runat="server" AssociatedControlID="txtTo" CssClass="form-label" Text="إلى تاريخ الإنشاء" /><asp:TextBox ID="txtTo" runat="server" CssClass="form-control" TextMode="Date" /></div><div class="col-12 col-sm-6 col-lg-12"><asp:Button ID="btnSearch" runat="server" Text="عرض النتائج" CssClass="btn btn-primary w-100" OnClick="Search_Click" /></div></asp:Panel><asp:Panel ID="pnlAdminFilters" runat="server" CssClass="row g-3 mt-1"><div class="col-12 col-sm-6 col-lg-12"><asp:Label runat="server" AssociatedControlID="ddlBrand" CssClass="form-label" Text="العلامة وقت الإنشاء" /><asp:DropDownList ID="ddlBrand" runat="server" CssClass="form-select" AutoPostBack="true" OnSelectedIndexChanged="Brand_Changed"><asp:ListItem Value="0">جميع العلامات</asp:ListItem></asp:DropDownList></div><div class="col-12 col-sm-6 col-lg-12"><asp:Label runat="server" AssociatedControlID="ddlBranch" CssClass="form-label" Text="الفرع وقت الإنشاء" /><asp:DropDownList ID="ddlBranch" runat="server" CssClass="form-select" ><asp:ListItem Value="0">جميع الفروع</asp:ListItem></asp:DropDownList></div><div class="col-12 col-sm-6 col-lg-12"><asp:Label runat="server" AssociatedControlID="txtSender" CssClass="form-label" Text="المرسل" /><asp:TextBox ID="txtSender" runat="server" CssClass="form-control" MaxLength="200" /></div><div class="col-12 col-sm-6 col-lg-12"><asp:Label runat="server" AssociatedControlID="txtReceiver" CssClass="form-label" Text="المستلم" /><asp:TextBox ID="txtReceiver" runat="server" CssClass="form-control" MaxLength="200" /></div></asp:Panel></div></details>
<asp:Button ID="btnQuickSearch" runat="server" Text="بحث" CssClass="d-none" OnClick="Search_Click" OnClientClick="return false;" />
<div class="d-flex justify-content-between gap-2 mt-2 small text-muted"><span id="correspondence-search-count" role="status" aria-live="polite"></span><span title="قراءة الرسالة لا تعني إنجاز التكليف">قناة عمل رسمية</span></div>
</ContentTemplate></asp:UpdatePanel></div>
<div id="correspondence-thread-list" class="correspondence-thread-list">
<div id="correspondence-search-empty" class="text-center p-3 text-muted small" hidden>لا توجد مراسلات مطابقة للبحث.</div>
<asp:UpdatePanel ID="upList" runat="server" UpdateMode="Conditional" ChildrenAsTriggers="false"><ContentTemplate>
<asp:Panel ID="pnlList" runat="server">
<asp:ListView ID="lstThreads" runat="server"><LayoutTemplate><asp:PlaceHolder ID="itemPlaceholder" runat="server" /></LayoutTemplate><ItemTemplate>
<a class='correspondence-thread <%# If(CInt(Eval("ID"))=SelectedThreadID,"is-active","") %>' href='<%# ThreadLink(Eval("ID")) %>' data-thread-id='<%#: Eval("ID") %>' data-search-text='<%#: Convert.ToString(Eval("OtherName")) & " " & Convert.ToString(Eval("Title")) & " " & Convert.ToString(Eval("ID")) %>' data-person='<%#: Eval("OtherName") %>'>
<img class="correspondence-avatar" src='<%#: CRM.CorrespondenceData.Avatar(Eval("OtherImage")) %>' alt="" />
<div class="correspondence-thread-content"><div class="correspondence-thread-top"><strong class="correspondence-thread-name"><%#: Eval("OtherName") %></strong><small class="correspondence-thread-time"><%#: CRM.CorrespondenceData.DisplayDate(Eval("LastMessageDate")) %></small></div>
<div class="correspondence-thread-title"><%#: Eval("Title") %></div><div class="correspondence-thread-preview">#<%#: Eval("ID") %> · <%#: Eval("MessageCount") %> رسائل</div>
<div class="correspondence-thread-badges"><span class='<%# "badge " & CRM.CorrespondenceData.StateCss(Eval("State")) %>'><%#: CRM.CorrespondenceData.StateText(Eval("State")) %></span><span class='<%# If(CBool(Eval("PriorityUrgent")),"badge bg-label-danger","badge bg-label-secondary") %>'><%#: Eval("PriorityName") %></span><span class="badge bg-label-primary"><%#: CRM.CorrespondenceData.KindText(Eval("RequiresCompletion")) %></span><asp:Label runat="server" CssClass="badge bg-warning text-dark" Visible='<%# CInt(Eval("UnreadCount")) > 0 %>' Text='<%# CStr(Eval("UnreadCount")) & " غير مقروءة" %>' /></div></div></a>
</ItemTemplate><EmptyDataTemplate><div class="text-center p-4 text-muted"><i class="bx bx-envelope d-block fs-1 mb-2"></i>لا توجد مراسلات مطابقة للفلاتر.</div></EmptyDataTemplate></asp:ListView></asp:Panel>
<asp:Panel ID="pnlOversight" runat="server"><div id="correspondence-overview"><asp:Literal ID="litStatistics" runat="server" /><asp:Panel ID="pnlReport" runat="server" CssClass="card mb-3"><div class="card-header"><h5 class="mb-1">تقرير المتابعة حسب جهة المستلم وقت الإنشاء</h5><p class="text-muted small mb-0">التقرير يتبع الفلاتر أعلاه. متوسط أول رد يحسب للمراسلات التي تلقت ردًا فقط. المراسلات القديمة ذات التبعية غير المحفوظة تظهر منفصلة.</p></div><div class="table-responsive"><table class="table table-sm"><thead><tr><th>العلامة / الفرع</th><th>العدد</th><th>دون رد</th><th>تكليفات متأخرة</th><th>تم الإنجاز</th><th>لم ينجز</th><th>أرشفة إدارية</th><th>متوسط أول رد</th></tr></thead><tbody><asp:Repeater ID="rptReport" runat="server"><ItemTemplate><tr><td><%#: Eval("Organization") %></td><td><%#: Eval("Count") %></td><td><%#: Eval("NoReply") %></td><td><%#: Eval("Overdue") %></td><td><%#: Eval("Completed") %></td><td><%#: Eval("NotCompleted") %></td><td><%#: Eval("Archived") %></td><td><%#: Eval("AverageReply") %></td></tr></ItemTemplate></asp:Repeater></tbody></table></div></asp:Panel>
<section class="card"><div class="card-header"><h5 class="mb-0">المراسلات</h5></div><div class="card-datatable table-responsive"><table id="ERPTable" data-enhanced="1" class="ERP_ProstoTBL card-list-table table border-top crm-table"><thead><tr><th>المراسلة</th><th>النوع والأولوية</th><th>الحالة</th><th>آخر تفاعل</th><th data-orderable="false">الإجراءات</th></tr></thead><tbody><asp:ListView ID="lstOversight" runat="server"><LayoutTemplate><asp:PlaceHolder ID="itemPlaceholder" runat="server" /></LayoutTemplate><ItemTemplate><tr data-search-text='<%#: Convert.ToString(Eval("OtherName")) & " " & Convert.ToString(Eval("Title")) & " " & Convert.ToString(Eval("ID")) %>' data-person='<%#: Eval("OtherName") %>'>
<td data-title="المراسلة"><div class="d-flex align-items-start gap-2"><div class="avatar avatar-sm flex-shrink-0"><img class="rounded-circle" src='<%#: CRM.CorrespondenceData.Avatar(Eval("OtherImage")) %>' alt="" /></div><div><a class="fw-semibold" href='<%# ThreadLink(Eval("ID")) %>' data-thread-id='<%#: Eval("ID") %>'><%#: Eval("Title") %></a><div class="small text-muted"><%#: Eval("OtherName") %></div><div class="small text-muted">#<%#: Eval("ID") %> · <%#: Eval("MessageCount") %> رسائل</div><asp:Label runat="server" CssClass="badge bg-label-warning" Visible='<%# CInt(Eval("UnreadCount")) > 0 %>' Text="غير مقروءة" /></div></div></td>
<td data-title="النوع والأولوية"><span class="badge bg-label-primary mb-1"><%#: CRM.CorrespondenceData.KindText(Eval("RequiresCompletion")) %></span><br /><span class='<%# If(CBool(Eval("PriorityUrgent")),"badge bg-label-danger","badge bg-label-secondary") %>'><%#: Eval("PriorityName") %></span></td>
<td data-title="الحالة"><span class='<%# "badge " & CRM.CorrespondenceData.StateCss(Eval("State")) %>'><%#: CRM.CorrespondenceData.StateText(Eval("State")) %></span></td><td data-title="آخر تفاعل"><%#: CRM.CorrespondenceData.DisplayDate(Eval("LastMessageDate")) %></td><td data-title="الإجراءات"><div class="type-flex type-row-actions"><a class="btn btn-sm btn-icon type-row-action text-secondary" href='<%# ThreadLink(Eval("ID")) %>' data-thread-id='<%#: Eval("ID") %>' data-bs-toggle="tooltip" title="عرض المراسلة" aria-label="عرض المراسلة"><i class="fa-solid fa-eye" aria-hidden="true"></i></a></div></td>
</tr></ItemTemplate></asp:ListView></tbody></table></div></section></div></asp:Panel>
</ContentTemplate></asp:UpdatePanel></div></aside>
<section class="correspondence-main" aria-label="المحادثة المختارة">
<asp:UpdatePanel ID="upConversation" runat="server" ClientIDMode="Static" UpdateMode="Conditional" ChildrenAsTriggers="false"><ContentTemplate>
<asp:Literal ID="litSync" runat="server" />
<asp:Panel ID="pnlEmpty" runat="server" ClientIDMode="Static" CssClass="correspondence-empty"><div id="correspondence-empty"><i class="bx bx-conversation display-3 text-primary"></i><h5 class="mt-3">اختر مراسلة لعرض المحادثة</h5><p class="text-muted mb-0">تظهر هنا الرسائل والمرفقات وإجراءات المتابعة.</p></div></asp:Panel>
<asp:Panel ID="pnlConversation" runat="server" Visible="false" CssClass="correspondence-conversation">
<header class="correspondence-header"><div class="correspondence-header-identity"><a href="ManageCorrespondence.aspx" data-correspondence-back class="btn btn-icon btn-label-secondary" aria-label="العودة إلى القائمة"><i class="bx bx-arrow-back"></i></a><asp:Image ID="imgOther" runat="server" CssClass="correspondence-avatar" AlternateText="صورة الطرف الآخر" /><div class="min-w-0"><strong><asp:Literal ID="litOtherName" runat="server" Mode="Encode" /></strong><h5 class="correspondence-header-title mb-1"><asp:Literal ID="litTitle" runat="server" Mode="Encode" /></h5><small class="text-muted">مراسلة #<asp:Literal ID="litThreadID" runat="server" Mode="Encode" /></small> <asp:Label ID="lblState" runat="server" /></div></div>
<div class="correspondence-header-actions"><button type="button" class="btn btn-icon btn-label-secondary" data-bs-toggle="collapse" data-bs-target="#correspondence-details" aria-controls="correspondence-details" aria-expanded="false" title="تفاصيل المراسلة" aria-label="تفاصيل المراسلة"><i class="bx bx-info-circle"></i></button><div class="dropdown"><button type="button" class="btn btn-icon btn-label-secondary dropdown-toggle hide-arrow" data-bs-toggle="dropdown" aria-label="إجراءات المراسلة"><i class="bx bx-dots-vertical-rounded"></i></button><div class="dropdown-menu"><asp:Button ID="btnCloseStart" runat="server" ClientIDMode="Static" Text="إنهاء المراسلة وتحديد النتيجة" CssClass="dropdown-item" OnClick="CloseStart_Click" /><asp:HyperLink ID="lnkTransfer" runat="server" CssClass="dropdown-item text-wrap" data-correspondence-create="true">إنشاء تكليف مرتبط للمسؤول البديل</asp:HyperLink><asp:Panel ID="pnlArchiveAction" runat="server"><button type="button" class="dropdown-item" data-bs-toggle="collapse" data-bs-target="#correspondence-archive">الأرشفة الإدارية</button></asp:Panel><span class="dropdown-item-text small text-muted">الإجراءات بحسب الصلاحيات والحالة</span></div></div></div></header>
<div id="correspondence-details" class="correspondence-details collapse"><div class="p-3 border-bottom"><p class="text-muted text-break"><asp:Literal ID="litBrief" runat="server" Mode="Encode" /></p><asp:Literal ID="litDetails" runat="server" /><div class="mt-2 mb-3"><asp:Literal ID="litDates" runat="server" /></div><asp:Literal ID="litOrganization" runat="server" /><asp:Literal ID="litRelated" runat="server" /><asp:Panel ID="pnlAudit" runat="server" CssClass="mt-3"><h6>سجل الاطلاع الإداري</h6><small class="text-muted">آخر 100 عملية؛ لا يتكرر تسجيل الزيارة مع التحديث التلقائي.</small><asp:Repeater ID="rptAudit" runat="server"><ItemTemplate><div class="border-bottom py-2"><strong class="small"><%#: Eval("ActorName") %></strong><div class="small"><%#: If(CStr(Eval("Action"))="view","اطلاع إداري","أرشفة إدارية") %> · <%#: CRM.CorrespondenceData.DisplayDate(Eval("CreatedAt")) %></div><div class="small text-muted"><%#: Eval("Note") %></div></div></ItemTemplate></asp:Repeater></asp:Panel></div></div>
<asp:Panel ID="pnlArchive" runat="server"><div class="collapse" id="correspondence-archive"><div class="p-3 border-bottom"><p class="small text-muted">حساب المنشئ معطل. توقف الأرشفة المتابعة دون تحديد نتيجة الإنجاز.</p><asp:Label runat="server" AssociatedControlID="txtArchiveReason" CssClass="form-label" Text="سبب الأرشفة *" /><asp:TextBox ID="txtArchiveReason" runat="server" TextMode="MultiLine" Rows="2" MaxLength="1000" CssClass="form-control mb-2" /><button type="button" class="btn btn-outline-secondary btn-sm" data-bs-toggle="modal" data-bs-target="#correspondence-archive-confirm">تأكيد الأرشفة الإدارية</button></div></div></asp:Panel>
<asp:Literal ID="litRefresh" runat="server" />
<div class="correspondence-message-area"><div id="correspondence-messages" tabindex="0" aria-label="رسائل المراسلة">
<asp:Repeater ID="rptMessages" runat="server" EnableViewState="false"><ItemTemplate>
<article class='correspondence-message <%# If(CInt(Eval("SenderID"))=ActorID,"is-own","is-other") %>' data-message-id='<%#: Eval("ID") %>' data-own='<%# If(CInt(Eval("SenderID"))=ActorID,"1","0") %>'>
<img class="correspondence-avatar" src='<%#: MessageAvatar(Eval("SenderID")) %>' alt="" /><div class="correspondence-message-content"><div class="correspondence-bubble"><div class="small fw-semibold mb-1"><%#: If(CInt(Eval("SenderID"))=ActorID,"أنت",Convert.ToString(Eval("SenderName"))) %></div><div class="text-break" dir="auto"><%# CRM.CorrespondenceData.MessageHtml(Eval("Body")) %></div><div class="correspondence-message-files"><asp:Repeater ID="rptFiles" runat="server" DataSource='<%# AttachmentsFor(Eval("ID")) %>'><ItemTemplate><span class="d-inline-flex align-items-center gap-1 mt-2"><a class="d-inline-block" href='<%#: CRM.CorrespondenceData.FileUrl(Eval("FileName")) %>' data-correspondence-file="true"><asp:PlaceHolder runat="server" Visible='<%# IsImage(Eval("FileName")) %>'><span class="btn btn-sm btn-label-primary d-inline-flex align-items-center gap-2"><i class="fa-solid fa-image" aria-hidden="true"></i><span>صورة مرفقة <%#: (Container.ItemIndex+1).ToString() %></span></span></asp:PlaceHolder><asp:Label runat="server" Visible='<%# Not IsImage(Eval("FileName")) %>' CssClass="btn btn-sm btn-label-primary" Text='<%# "مرفق " & (Container.ItemIndex+1).ToString() & " · " & IO.Path.GetExtension(CStr(Eval("FileName"))).TrimStart("."c).ToUpperInvariant() %>' /></a><asp:PlaceHolder runat="server" Visible='<%# IsImage(Eval("FileName")) %>'><a class="btn btn-sm btn-icon btn-label-secondary" href='<%#: CRM.CorrespondenceData.FileUrl(Eval("FileName")) %>' download title="تحميل الصورة" aria-label="تحميل الصورة"><i class="fa-solid fa-download" aria-hidden="true"></i></a></asp:PlaceHolder></span></ItemTemplate></asp:Repeater></div></div><div class="correspondence-message-meta"><time datetime='<%#: CRM.CorrespondenceData.Utc(Eval("CreatedDate")) %>'><%#: CRM.CorrespondenceData.DisplayDate(Eval("CreatedDate")) %></time><span title='<%#: If(CBool(Eval("IsRead")),"قرأها المستلم: " & CRM.CorrespondenceData.DisplayDate(Eval("ReadDate")),"لم يقرأها المستلم بعد") %>'><i class='bx <%# If(CBool(Eval("IsRead")),"bx-check-double text-primary","bx-check") %>'></i><%#: If(CBool(Eval("IsRead")),"مقروءة","غير مقروءة") %></span></div></div></article>
</ItemTemplate></asp:Repeater></div>
<button type="button" id="correspondence-new-messages" class="btn btn-primary btn-sm" hidden>رسائل جديدة <i class="bx bx-chevron-down"></i></button></div>
<asp:Panel ID="pnlClosedNote" runat="server" CssClass="alert alert-secondary rounded-0 mb-0 small"><asp:Literal ID="litClosedText" runat="server" Mode="Encode" /></asp:Panel>
 <asp:Panel ID="pnlClose" runat="server" Width="100%" Style="display:none;" role="dialog" aria-modal="true" aria-labelledby="closeConversationTitle">
  <div class="modal-dialog modal-dialog-centered" role="document"><div class="modal-content">
   <div class="modal-header"><h5 class="modal-title" id="closeConversationTitle"><i class="bx bx-check-shield me-2" aria-hidden="true"></i>إنهاء المحادثة</h5></div>
   <div class="modal-body"><p>بعد الإنهاء ستبقى المحادثة ومرفقاتها متاحة للقراءة فقط.</p><asp:Literal ID="litCloseError" runat="server" /><asp:Panel ID="pnlOutcome" runat="server"><label class="form-label">هل تم الإنجاز؟ <span class="text-danger">*</span></label><asp:RadioButtonList ID="rblOutcome" runat="server" CssClass="mb-3"><asp:ListItem Value="1">تم الإنجاز</asp:ListItem><asp:ListItem Value="0">لم يتم الإنجاز</asp:ListItem></asp:RadioButtonList></asp:Panel><div class="mb-3"><asp:Label runat="server" AssociatedControlID="ddlClosureKind" CssClass="form-label" Text="سبب الإنهاء" /><asp:DropDownList ID="ddlClosureKind" runat="server" CssClass="form-select"></asp:DropDownList></div><asp:Label runat="server" AssociatedControlID="txtCloseReason" CssClass="form-label" Text="التوضيح (مطلوب لنقل المسؤولية)" /><asp:TextBox ID="txtCloseReason" runat="server" CssClass="form-control" TextMode="MultiLine" Rows="3" MaxLength="1000" /></div>
   <div class="modal-footer"><asp:Button ID="btnCloseCancel" runat="server" Text="إلغاء" CssClass="btn btn-label-secondary" OnClick="CloseCancel_Click" CausesValidation="false" /><asp:Button ID="btnCloseConfirm" runat="server" Text="تأكيد الإنهاء" CssClass="btn btn-primary" OnClick="CloseConfirm_Click" /></div>
  </div></div>
