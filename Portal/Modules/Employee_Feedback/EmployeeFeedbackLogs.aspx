<asp:Content ID="Main" ContentPlaceHolderID="ContentPlaceHolder1" runat="server"><div class="container-xxl flex-grow-1 container-p-y crm-shell crm-types" dir="rtl"><asp:Literal ID="litMessage" runat="server" /><div class="card"><div class="card-header type-flex w-100 flex-wrap justify-content-between align-items-center gap-2"><div><h1 class="h5 mb-1">سجل المتابعة والإجراءات</h1><asp:Label ID="lblScope" runat="server" CssClass="small text-muted" /></div><asp:HyperLink ID="lnkBack" runat="server" CssClass="btn btn-label-secondary" Text="العودة" /></div><div class="card-header type-filter-header pt-0"><p class="form-text mb-0">تاريخ ووقت كل مشاهدة وإجراء بتوقيت الأردن، مع الحفاظ على خصوصية الطلبات المجهولة.</p></div><div class="card-datatable table-responsive"><table id="ERPTable" data-enhanced="1" class="ERP_ProstoTBL card-list-table table border-top crm-table"><thead><tr><th>الطلب</th><th>الحدث</th><th>بواسطة</th><th>التاريخ والوقت</th><th data-orderable="false">الإجراءات</th></tr></thead><tbody><asp:ListView ID="lstData" runat="server"><LayoutTemplate><asp:PlaceHolder ID="itemPlaceholder" runat="server" /></LayoutTemplate><ItemTemplate><tr><td class="py-2" data-title="الطلب"><a href='<%# "ViewEmployeeFeedback.aspx?report=1&ID=" & Eval("Request_ID").ToString() %>'>#<%#: Eval("Request_ID") %></a></td><td class="py-2" data-title="الحدث"><span class="badge bg-label-info"><i class="bx bx-history me-1"></i><%#: Eval("EventType") %></span></td><td class="py-2" data-title="بواسطة"><%#: Eval("ActorName") %></td><td class="py-2" data-title="التاريخ والوقت"><span dir="ltr"><%#: CRM.EmployeeFeedbackData.LogDate(Eval("EventDate")) %></span></td><td data-title="الإجراءات"><div class="type-flex type-row-actions"><a class="btn btn-sm btn-icon type-row-action text-secondary" href='<%# "ViewEmployeeFeedback.aspx?report=1&ID=" & Eval("Request_ID").ToString() %>' aria-label="تفاصيل الطلب" title="تفاصيل الطلب" data-bs-toggle="tooltip"><i class="fa-solid fa-eye" aria-hidden="true"></i></