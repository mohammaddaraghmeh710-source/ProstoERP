<%@ Page Title="متابعة الطلبات" Language="vb" AutoEventWireup="false" MasterPageFile="~/Site.Master" CodeBehind="ManageEmployeeFeedback.aspx.vb" Inherits="CRM.ManageEmployeeFeedback" %>
<%@ Register Assembly="AjaxControlToolkit" Namespace="AjaxControlToolkit" TagPrefix="cc1" %>
<asp:Content ID="Head" ContentPlaceHolderID="HeadContent" runat="server"><link rel="stylesheet" href="/assets/vendor/fonts/fontawesome.css"/><link rel="stylesheet" href="/assets/vendor/libs/datatables-bs5/datatables.bootstrap5.css"/><link rel="stylesheet" href="/assets/css/crm.css"/><link rel="stylesheet" href="/assets/css/crm-list.css"/><link rel="stylesheet" href="/assets/css/feedback-workspace.css?v=20261022g"/></asp:Content>
<asp:Content ID="Main" ContentPlaceHolderID="ContentPlaceHolder1" runat="server">
<div class="container-xxl container-p-y crm-types feedback-workspace" dir="rtl"><asp:Literal ID="litMessage" runat="server" />
<div class="type-page-header type-flex align-items-center justify-content-between"><div><h1 class="h4 mb-1">متابعة الطلبات</h1><p class="text-muted small mb-0">تظهر الطلبات التي تنتظر إجراءك أولًا، مع متابعة حالة الطلب وسير العمل.</p></div><div class="type-flex flex-wrap gap-2"><a class="btn btn-label-secondary" href="Dashboard.aspx"><i class="bx bx-grid-alt me-1" aria-hidden="true"></i>لوحة المتابعة</a></div></div>
<asp:Literal ID="litStatistics" runat="server" />
<section class="card"><div class="card-header type-filter-header"><h2 class="h5 card-title">البحث في الطلبات</h2><div class="row g-3 align-items-center" data-feedback-filters><div class="col-12 col-md-4"><asp:TextBox ID="txtSearch" runat="server" CssClass="form-control" MaxLength="300" placeholder="العنوان أو رقم الطلب..." aria-label="العنوان أو رقم الطلب" data-feedback-filter-name="1"/></div><div class="col-12 col-md-3"><asp:DropDownList ID="ddlType" runat="server" CssClass="form-select" aria-label="نوع الطلب" data-feedback-filter-type="1"/></div><div class="col-12 col-md-3"><asp:DropDownList ID="ddlStatus" runat="server" CssClass="form-select" aria-label="حالة الطلب" data-feedback-filter-status="1"><asp:ListItem Value="0">جميع الحالات</asp:ListItem><asp:ListItem Value="4">الطلبات الفعالة</asp:ListItem><asp:ListItem Value="1">جديد</asp:ListItem><asp:ListItem Value="2">قيد المعالجة</asp:ListItem><asp:ListItem Value="3">مغلق</asp:ListItem></asp:DropDownList></div><div class="col-12 col-md-2"><button type="button" class="btn btn-label-secondary w-100" data-feedback-reset-filters>مسح الفلاتر</button></div></div></div><div class="px-4 pt-3 small text-muted"><asp:Label ID="lblTotal" runat="server" CssClass="small text-muted"/></div><div id="pnlTableActions" class="type-flex type-toolbar-controls align-items-center"><asp:HyperLink ID="lnkNew" runat="server" NavigateUrl="AddEmployeeFeedback.aspx" CssClass="btn btn-primary"><i class="fa-solid fa-plus me-1" aria-hidden="true"></i>تقديم طلب جديد</asp:HyperLink></div><div class="card-datatable table-responsive">
<table id="ERPTable" data-enhanced="1" data-feedback-table="1" class="ERP_ProstoTBL card-list-table table border-top crm-table"><thead><tr><th>رقم الطلب</th><th>النوع</th><th>العنوان / مقدّم الطلب</th><th>الحالة</th><th>الجهة الحالية</th><th>تاريخ التقديم</th><th data-orderable="false">الإجراءات</th></tr></thead><tbody><asp:ListView ID="lstData" runat="server"><LayoutTemplate><asp:PlaceHolder ID="itemPlaceholder" runat="server" /></LayoutTemplate><ItemTemplate><tr data-feedback-row="1" data-feedback-id='<%# Eval("ID") %>' data-feedback-type='<%# Eval("Type") %>' data-feedback-status='<%# Eval("Status") %>' data-feedback-title='<%# CRM.CRMData.H(Eval("Title")) %>' class='<%# If(NeedsAction(Eval("ID")),"feedback-needs-action","") %>' data-priority='<%# If(NeedsAction(Eval("ID")),0,If(Convert.ToInt32(Eval("Status"))=3,2,1)) %>'><td class="py-2" data-title="رقم الطلب"><%#: Eval("ID") %></td><td class="py-2" data-title="النوع"><%#: CRM.EmployeeFeedbackData.TypeText(Eval("Type")) %></td><td class="py-2" data-title="العنوان / مقدّم الطلب"><a class="fw-semibold text-body" href='<%# DetailLink(Eval("ID")) %>'><%#: Eval("Title") %></a><div class="small text-muted my-1"><%#: Eval("BrandName") %> · <%#: Eval("BranchName") %> · <%#: Eval("EmployeeName") %></div><div class="d-inline-flex flex-wrap gap-1"><span class="badge bg-label-secondary"><%#: RowScope(Eval("ID")) %></span><span class="badge bg-label-info"><%#: CRM.EmployeeFeedbackCatalog.SourceName(Eval("SourceType")) %></span><asp:Label runat="server" CssClass="badge bg-label-danger" Visible='<%# NeedsAction(Eval("ID")) %>' Text="بانتظار إجرائك" /><asp:Label runat="server" CssClass="badge bg-label-warning" Visible='<%# Convert.ToInt32(Eval("UnreadCount"))>0 %>' Text="غير مقروء" /></div></td><td class="py-2" data-title="الحالة"><span class='<%# CRM.EmployeeFeedbackData.StatusCss(Eval("Status")) %>'><%#: CRM.EmployeeFeedbackData.StatusText(Eval("Status")) %></span></td><td class="py-2" data-title="الجهة الحالية"><%#: Eval("CurrentRecipient") %></td><td class="py-2" data-title="تاريخ التقديم"><%#: CRM.CorrespondenceData.DisplayDate(Eval("AddedDate")) %></td><td class="py-2" data-title="الإجراءات"><div class="type-flex type-row-actions"><a class="btn btn-sm btn-icon type-row-action text-secondary" href='<%# DetailLink(Eval("ID")) %>' aria-label="تفاصيل الطلب" title="تفاصيل الطلب" data-bs-toggle="tooltip"><i class="fa-solid fa-eye" aria-hidden="true"></i></a></div></td></tr></ItemTemplate></asp:ListView></tbody></table></div></section></div><script src="/assets/vendor/libs/datatables/jquery.dataTables.js"></script><script src="/assets/vendor/libs/datatables-bs5/datatables-bootstrap5.js"></script><script src="/assets/js/crm-list.js?v=20261021suppliers"></script><script src="/assets/js/feedback-wizard.js?v=20261022b"></script></asp:Content>