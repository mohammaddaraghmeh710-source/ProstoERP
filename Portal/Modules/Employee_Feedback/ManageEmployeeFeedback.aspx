<%@ Page Title="متابعة الطلبات" Language="vb" AutoEventWireup="false" MasterPageFile="~/Site.Master" CodeBehind="ManageEmployeeFeedback.aspx.vb" Inherits="CRM.ManageEmployeeFeedback" %>
<%@ Register Assembly="AjaxControlToolkit" Namespace="AjaxControlToolkit" TagPrefix="cc1" %>
<asp:Content ID="Head" ContentPlaceHolderID="HeadContent" runat="server"></asp:Content>
<asp:Content ID="Main" ContentPlaceHolderID="ContentPlaceHolder1" runat="server">
<div class="container-xxl flex-grow-1 container-p-y" dir="rtl"><asp:Literal ID="litMessage" runat="server" />
<div class="row align-items-center g-2 mb-3"><div class="col"><h4 class="mb-1"><i class="bx bx-conversation text-primary me-2"></i>متابعة الشكاوى والاقتراحات</h4><p class="text-muted small mb-0">طلباتك المرسلة والواردة، مرتبة حسب أولوية المتابعة.</p></div><div class="col-auto"><asp:HyperLink ID="lnkNew" runat="server" NavigateUrl="AddEmployeeFeedback.aspx" CssClass="btn btn-primary"><i class="bx bx-plus me-1"></i>تقديم طلب جديد</asp:HyperLink><a href="EmployeeFeedbackNotifications.aspx" class="btn btn-label-secondary ms-2" aria-label="الإشعارات"><i class="bx bx-bell"></i></a></div></div>
<asp:Literal ID="litStatistics" runat="server" />
<section class="card"><div class="card-header py-3 d-inline-flex w-100 flex-wrap align-items-center justify-content-between gap-2"><h5 class="mb-0">سجل الطلبات</h5><a class="btn btn-sm btn-label-secondary" href="ManageEmployeeFeedback.aspx"><i class="bx bx-list-ul me-1"></i>عرض الجميع</a></div><div class="card-body pt-0"><div class="row g-3 align-items-end mb-3"><div class="col-md-4"><asp:Label runat="server" AssociatedControlID="txtSearch" CssClass="form-label" Text="العنوان أو رقم الطلب" /><asp:TextBox ID="txtSearch" runat="server" CssClass="form-control" MaxLength="300" /></div><div class="col-md-3"><asp:Label runat="server" AssociatedControlID="ddlType" CssClass="form-label" Text="نوع الطلب" /><asp:DropDownList ID="ddlType" runat="server" CssClass="form-select select2" ></asp:DropDownList></div><div class="col-md-3"><asp:Label runat="server" AssociatedControlID="ddlStatus" CssClass="form-label" Text="الحالة" /><asp:DropDownList ID="ddlStatus" runat="server" CssClass="form-select select2" ><asp:ListItem Value="0">جميع الحالات</asp:ListItem><asp:ListItem Value="4">الطلبات الفعالة</asp:ListItem><asp:ListItem Value="1">جديد</asp:ListItem><asp:ListItem Value="2">قيد المعالجة</asp:ListItem><asp:ListItem Value="3">مغلق</asp:ListItem></asp:DropDownList></div><div class="col-md-2"><asp:Button ID="btnSearch" runat="server" Text="بحث" OnClick="Search_Click" CssClass="btn btn-primary"  /></div></div><asp:Label ID="lblTotal" runat="server" CssClass="small text-muted" /><table id="ERPTable" class="ERP_ProstoTBL card-list-table table table-sm table-bordered dt-responsive nowrap"><thead><tr><th>رقم الطلب</th><th>النوع</th><th>العنوان / مقدّم الطلب</th><th>الحالة</th><th>الجهة الحالية</th><th>تاريخ التقديم</th><th>عرض</th></tr></thead><tbody><asp:ListView ID="lstData" runat="server"><LayoutTemplate><asp:PlaceHolder ID="itemPlaceholder" runat="server" /></LayoutTemplate><ItemTemplate><tr data-priority='<%# If(NeedsAction(Eval("ID")),0,If(Convert.ToInt32(Eval("Status"))=3,2,1)) %>'><td class="py-2" data-title="رقم الطلب"><%#: Eval("ID") %></td><td class="py-2" data-title="النوع"><%#: CRM.EmployeeFeedbackData.TypeText(Eval("Type")) %></td><td class="py-2" data-title="العنوان / مقدّم الطلب"><a class="fw-semibold text-body" href='<%# DetailLink(Eval("ID")) %>'><%#: Eval("Title") %></a><div class="small text-muted my-1"><%#: Eval("BrandName") %> · <%#: Eval("BranchName") %> · <%#: Eval("EmployeeName") %></div><div class="d-inline-flex flex-wrap gap-1"><span class="badge bg-label-secondary"><%#: If(IsSent(Eval("ID")),"طلب مرسل","طلب وارد") %></span><span class="badge bg-label-info"><%#: CRM.EmployeeFeedbackCatalog.SourceName(Eval("SourceType")) %></span><asp:Label runat="server" CssClass="badge bg-label-danger" Visible='<%# NeedsAction(Eval("ID")) %>' Text="بانتظار إجرائك" /><asp:Label runat="server" CssClass="badge bg-label-warning" Visible='<%# Convert.ToInt32(Eval("UnreadCount"))>0 %>' Text="غير مقروء" /></div></td><td class="py-2" data-title="الحالة"><span class='<%# CRM.EmployeeFeedbackData.StatusCss(Eval("Status")) %>'><%#: CRM.EmployeeFeedbackData.StatusText(Eval("Status")) %></span></td><td class="py-2" data-title="الجهة الحالية"><%#: Eval("CurrentRecipient") %></td><td class="py-2" data-title="تاريخ التقديم"><%#: CRM.CorrespondenceData.DisplayDate(Eval("AddedDate")) %></td><td class="py-2" data-title="عرض"><a class="btn btn-sm btn-label-primary" href='<%# DetailLink(Eval("ID")) %>'>التفاصيل</a></td></tr></ItemTemplate><EmptyDataTemplate><tr><td colspan="7" class="text-center py-4">لا توجد طلبات مطابقة.</td></tr></EmptyDataTemplate></asp:ListView></tbody></table></div></section></div></asp:Content>