<%@ Page Title="تفاصيل الطلب" Language="vb" AutoEventWireup="false" MasterPageFile="~/Site.Master" CodeBehind="ViewEmployeeFeedback.aspx.vb" Inherits="CRM.ViewEmployeeFeedback" %>
<%@ Register Assembly="AjaxControlToolkit" Namespace="AjaxControlToolkit" TagPrefix="cc1" %>
<asp:Content ID="Head" ContentPlaceHolderID="HeadContent" runat="server"><link rel="stylesheet" href="/assets/css/crm.css"/><link rel="stylesheet" href="/assets/css/crm-list.css"/><link rel="stylesheet" href="/assets/css/feedback-workspace.css?v=20261022j"/></asp:Content>
<asp:Content ID="Main" ContentPlaceHolderID="ContentPlaceHolder1" runat="server">
<div class="container-xxl container-p-y crm-types feedback-workspace feedback-detail" dir="rtl">
    <asp:Literal ID="litMessage" runat="server" />
    <asp:Panel ID="pnlDetails" runat="server" Visible="false">

<div class="row invoice-preview"><div class="col-12"><div class="card invoice-preview-card feedback-detail-card"><div class="nav-align-top"><ul class="nav nav-tabs nav-fill feedback-detail-tabs border-bottom" role="tablist" aria-label="تفاصيل الطلب"><li class="nav-item" role="presentation"><button type="button" id="feedback-details-tab" class='nav-link text-wrap <%= If(IsPostBack, "", "active") %>' data-bs-toggle="tab" data-bs-target="#feedback-details" role="tab" aria-controls="feedback-details" aria-selected='<%= If(IsPostBack, "false", "true") %>'><i class="fa-solid fa-file-lines me-1" aria-hidden="true"></i>معلومات الطلب</button></li><li class="nav-item" role="presentation"><button type="button" id="feedback-workflow-tab" class='nav-link text-wrap' data-bs-toggle="tab" data-bs-target="#feedback-workflow" role="tab" aria-controls="feedback-workflow" aria-selected='false'><i class="fa-solid fa-diagram-project me-1" aria-hidden="true"></i>سير العمل</button></li><li class="nav-item" role="presentation"><button type="button" id="feedback-actions-tab" class='nav-link text-wrap <%= If(IsPostBack, "active", "") %>' data-bs-toggle="tab" data-bs-target="#feedback-actions" role="tab" aria-controls="feedback-actions" aria-selected='<%= If(IsPostBack, "true", "false") %>'><i class="fa-solid fa-list-check me-1" aria-hidden="true"></i>الإجراءات</button></li><li ID="liLogs" runat="server" class="nav-item" role="presentation"><button type="button" id="feedback-logs-tab" class="nav-link" data-bs-toggle="tab" data-bs-target="#pnlLogs" role="tab" aria-controls="pnlLogs" aria-selected="false"><i class="fa-solid fa-clock-rotate-left me-1" aria-hidden="true"></i>السجلات</button></li></ul><div class="tab-content p-0"><div class='tab-pane fade <%= If(IsPostBack, "", "show active") %>' id="feedback-details" role="tabpanel" aria-labelledby="feedback-details-tab" tabindex="0"><section class="card-body feedback-request-summary" aria-label="معلومات الطلب">
 <dl class="d-flex flex-wrap align-items-center gap-2 gap-sm-3 mb-2 feedback-request-meta">
  <div class="d-flex align-items-baseline gap-1"><dt class="text-muted">رقم الطلب:</dt><dd class="fw-semibold text-primary">#<asp:Literal ID="litID" runat="server" Mode="Encode" /></dd></div>
  <div class="d-flex align-items-center gap-1"><dt class="visually-hidden">المصدر</dt><dd><asp:Label ID="lblSource" runat="server" CssClass="badge bg-label-secondary" /></dd></div>
  <div class="d-flex align-items-center gap-1"><dt class="visually-hidden">النوع</dt><dd><asp:Label ID="lblType" runat="server" CssClass="badge bg-label-info" /></dd></div>
  <div class="d-flex align-items-center gap-1"><dt class="visually-hidden">الحالة</dt><dd><asp:Label ID="lblStatus" runat="server" /></dd></div>
 </dl>
 <h1 class="h6 feedback-request-title mb-2"><asp:Literal ID="litTitle" runat="server" Mode="Encode" /></h1>
 <dl class="row g-1 mb-0 feedback-request-meta"><asp:Literal ID="litMeta" runat="server" /></dl>
</section>
<div class="card-body pt-0"><div class="row g-3 align-items-stretch">
 <section class="col-12 col-lg-8 feedback-request-body" aria-labelledby="feedback-text-title"><h2 id="feedback-text-title" class="feedback-section-title mb-2">تفاصيل الطلب</h2><div class="feedback-request-text"><asp:Literal ID="litDetails" runat="server" /></div></section>
 <section class="col-12 col-lg-4 feedback-request-applicant" id="feedback-applicant" aria-labelledby="feedback-applicant-title"><div class="bg-lighter rounded p-3 h-100"><h2 class="feedback-section-title mb-2" id="feedback-applicant-title">معلومات مقدم الطلب</h2><asp:Literal ID="litContact" runat="server" /></div></section>
</div></div>
<hr class="my-0" />
<section class="card-body" aria-label="المرفقات"><div><h2 class="feedback-section-title mb-2"><i class="fa-solid fa-paperclip me-1" aria-hidden="true"></i>المرفقات</h2>
<asp:Repeater ID="rptFiles" runat="server"><ItemTemplate><span class="d-inline-flex align-items-center gap-2 border rounded p-2 me-2 mb-2"><i class="bx bx-file text-primary fs-4" aria-hidden="true"></i><span class="small">مرفق <%#: Container.ItemIndex+1 %> · <%#: Eval("File_Type") %></span><asp:PlaceHolder runat="server" Visible='<%# CanPreview(Eval("File_Type")) %>'><a class="btn btn-sm btn-label-primary" data-feedback-preview="true" data-bs-toggle="modal" data-bs-target="#feedback-preview" href='<%# FileLink(Eval("ID")) & "&preview=1" %>'>معاينة</a></asp:PlaceHolder><a class="btn btn-sm btn-label-secondary" href='<%# FileLink(Eval("ID")) %>' aria-label="تنزيل المرفق"><i class="bx bx-download"></i></a></span></ItemTemplate></asp:Repeater><asp:Label ID="lblNoFiles" runat="server" Text="لا توجد مرفقات لهذا الطلب." CssClass="text-muted" /></div></section></div><div class="tab-pane fade" id="feedback-workflow" role="tabpanel" aria-labelledby="feedback-workflow-tab" tabindex="0"><div class="card-body"><ol class="timeline mt-2 mb-0"><asp:Repeater ID="rptWorkflow" runat="server"><ItemTemplate><li class="timeline-item timeline-item-transparent ps-4"><span class='<%# "timeline-point timeline-point-" & If(Convert.ToInt32(Eval("ActionType"))=3,"success",If(Convert.ToInt32(Eval("ActionType"))=2,"warning","primary")) %>'></span><div class="timeline-event pb-2"><div class="d-inline-flex w-100 flex-wrap justify-content-between gap-2"><h6 class="mb-1"><i class="bx bx-history me-1"></i><%#: CRM.EmployeeFeedbackData.ActionText(Eval("ActionType")) %></h6><small dir="ltr"><%#: CRM.CorrespondenceData.DisplayDate(Eval("AddedDate")) %></small></div><p class="small"><%#: Eval("SenderName") %> ← <%#: Eval("ReceiverNames") %></p><div class="text-break mb-2"><%# CRM.CorrespondenceData.MessageHtml(Eval("Comment")) %></div><asp:Repeater ID="rptActionFiles" runat="server" DataSource='<%# FilesFor(Eval("GroupID")) %>'><ItemTemplate><span class="d-inline-flex align-items-center gap-2 border rounded p-2 me-2 mb-2"><i class="bx bx-file text-primary fs-4" aria-hidden="true"></i><span class="small">مرفق <%#: Container.ItemIndex+1 %> · <%#: Eval("File_Type") %></span><asp:PlaceHolder runat="server" Visible='<%# CanPreview(Eval("File_Type")) %>'><a class="btn btn-sm btn-label-primary" data-feedback-preview="true" data-bs-toggle="modal" data-bs-target="#feedback-preview" href='<%# FileLink(Eval("ID")) & "&preview=1" %>'>معاينة</a></asp:PlaceHolder><a class="btn btn-sm btn-label-secondary" href='<%# FileLink(Eval("ID")) %>' aria-label="تنزيل المرفق"><i class="bx bx-download"></i></a></span></ItemTemplate></asp:Repeater></div></li></ItemTemplate></asp:Repeater></ol></div></div><div class='tab-pane fade <%= If(IsPostBack, "show active", "") %>' id="feedback-actions" role="tabpanel" aria-labelledby="feedback-actions-tab" tabindex="0"><div class="card-body"><asp:Panel ID="pnlReadOnly" runat="server" CssClass="alert alert-secondary small mb-3"><i class="bx bx-info-circle me-2"></i>لا توجد إجراءات متاحة لك على هذا الطلب. يمكنك الاطلاع على تفاصيله ومتابعة سير العمل.</asp:Panel><asp:Panel ID="pnlActions" runat="server" CssClass="mb-3"><div><p class="small text-muted mb-3">اختر تحويل الطلب للمتابعة أو إغلاقه، مع توضيح الإجراء في حقل الشروحات.</p><div class="d-inline-flex w-100 flex-wrap gap-2"><asp:Button ID="btnTransfer" runat="server" Text="تحويل" OnClick="Transfer_Click" CssClass="btn btn-primary"  /><asp:Button ID="btnClose" runat="server" Text="إغلاق الطلب" OnClick="Close_Click" CssClass="btn btn-label-danger"  /></div></div></asp:Panel></div></div><asp:Panel ID="pnlLogs" runat="server" ClientIDMode="Static" CssClass="tab-pane fade" role="tabpanel" aria-labelledby="feedback-logs-tab"><section class="card-body" aria-labelledby="feedback-logs-title"><div><h2 id="feedback-logs-title" class="feedback-section-title mb-2">السجلات</h2><p class="form-text">أوقات المشاهدة والإجراءات بتوقيت الأردن. تسجيل المشاهدات متاح منذ تفعيل هذه الميزة.</p><asp:Repeater ID="rptLogs" runat="server"><HeaderTemplate><div class="list-group list-group-flush"></HeaderTemplate><ItemTemplate><div class="list-group-item px-0"><div class="d-inline-flex w-100 flex-wrap justify-content-between gap-2"><strong><%#: Eval("EventType") %></strong><span class="small text-muted" dir="ltr"><%#: CRM.EmployeeFeedbackData.LogDate(Eval("EventDate")) %></span></div><div class="small mt-1"><%#: Eval("ActorName") %></div></div></ItemTemplate><FooterTemplate></div></FooterTemplate></asp:Repeater></div></section></asp:Panel></div></div></div></div></div>
<div class="feedback-detail-footer d-flex justify-content-end mt-3"><asp:HyperLink ID="lnkBack" runat="server" CssClass="btn btn-primary"><i class="fa-solid fa-arrow-right me-2" aria-hidden="true"></i>العودة للقائمة</asp:HyperLink></div>
<asp:Panel ID="pnlActionModal" runat="server" Width="100%" Style="display:none;" role="dialog" aria-modal="true" aria-labelledby="actionTitle"><div class="modal-dialog modal-dialog-centered modal-dialog-scrollable"><div class="modal-content"><div class="modal-header"><h5 id="actionTitle" class="modal-title"><asp:Literal ID="litActionTitle" runat="server" Mode="Encode" /></h5></div><div class="modal-body"><asp:Literal ID="litActionError" runat="server" /><asp:Panel ID="pnlTransferTarget" runat="server" CssClass="mb-3"><asp:Label runat="server" AssociatedControlID="ddlTransferTarget" Text="التحويل إلى *" CssClass="form-label" /><asp:DropDownList ID="ddlTransferTarget" runat="server" CssClass="form-select" data-feedback-routing-select="1" data-feedback-routing-target="lblTransferRouting" /><asp:Label ID="lblTransferRouting" runat="server" ClientIDMode="Static" CssClass="form-text" role="status" aria-live="polite" /></asp:Panel><asp:Label runat="server" AssociatedControlID="txtComment" CssClass="form-label" Text="الشروحات *" /><asp:TextBox ID="txtComment" runat="server" CssClass="form-control" TextMode="MultiLine" Rows="4" MaxLength="10000" /><div class="mt-3"><asp:Label runat="server" AssociatedControlID="AttachmentUpload" CssClass="form-label" Text="المرفقات (اختياري)" /><cc1:AjaxFileUpload ID="AttachmentUpload" runat="server" AllowedFileTypes="pdf,doc,docx,xls,xlsx,jpg,jpeg,png,gif" AutoStartUpload="true" MaximumNumberOfFiles="5" MaxFileSize="10240" OnUploadStart="AttachmentUpload_UploadStart" OnUploadComplete="AttachmentUpload_UploadComplete" /><div class="form-text mt-2">PDF، Word، Excel أو صور · حتى 5 ملفات، 10 ميجابايت لكل ملف. ارفع المرفقات أولًا ثم نفّذ الإجراء.</div><asp:Label ID="lblQueued" runat="server" CssClass="form-text" /><p class="small text-muted mt-2 mb-0" data-feedback-upload-status role="status" aria-live="polite"></p><div><asp:Button ID="btnClearUploads" runat="server" Text="مسح المرفقات المحددة" OnClick="ClearUploads_Click" CssClass="btn btn-sm btn-label-secondary mt-2" CausesValidation="false" /></div></div></div><div class="modal-footer"><asp:Button ID="btnCancel" runat="server" Text="إلغاء" OnClick="Cancel_Click" CssClass="btn btn-label-secondary" CausesValidation="false" /><asp:Button ID="btnConfirm" runat="server" data-feedback-action-submit="1" Text="تأكيد الإجراء" OnClick="Confirm_Click" CssClass="btn btn-primary"  /></div></div></div></asp:Panel><asp:Label ID="lblModalTarget" runat="server" /><cc1:ModalPopupExtender ID="ActionModal" runat="server" TargetControlID="lblModalTarget" PopupControlID="pnlActionModal" BackgroundCssClass="modal-backdrop fade show" />
<div class="modal fade" id="feedback-preview" tabindex="-1" aria-labelledby="feedback-preview-title" aria-hidden="true"><div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable"><div class="modal-content"><div class="modal-header"><h5 id="feedback-preview-title" class="modal-title">معاينة المرفق</h5><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="إغلاق"></button></div><div class="modal-body p-3">
 <div id="feedback-preview-status" class="text-muted small py-3" role="status" aria-live="polite">جارٍ تحميل المرفق للمعاينة…</div>
 <div id="feedback-preview-controls" hidden><div class="d-flex flex-wrap align-items-center justify-content-center gap-3 border-top border-bottom py-2 mb-3" dir="rtl" role="group" aria-label="التنقل بين صفحات المرفق"><button type="button" id="feedback-preview-previous" class="btn btn-sm btn-label-secondary" disabled><i class="bx bx-chevron-right me-1" aria-hidden="true"></i>السابق</button><span id="feedback-preview-page" class="small" dir="ltr" aria-live="polite">—</span><button type="button" id="feedback-preview-next" class="btn btn-sm btn-label-secondary" disabled>التالي<i class="bx bx-chevron-left ms-1" aria-hidden="true"></i></button></div></div>
 <div id="feedback-preview-surface" class="text-center rounded p-2 overflow-auto bg-lighter" style="max-height:70vh" hidden><canvas id="feedback-preview-canvas" aria-label="صفحة ملف PDF" style="max-width:100%;height:auto;background:white" hidden></canvas><img id="feedback-preview-image" alt="معاينة صورة المرفق" style="max-width:100%;height:auto" hidden /></div>
</div></div></div></div>
    </asp:Panel>
<script src="/assets/js/pdf.min.js"></script><script src="/assets/js/feedback-preview.js?v=20261022c"></script>
</div><script src="/assets/js/feedback-wizard.js?v=20261022b"></script>
</asp:Content>
