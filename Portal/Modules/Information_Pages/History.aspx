<%@ Page Title="إصدارات الصفحة" Language="vb" AutoEventWireup="false" MasterPageFile="~/Site.Master" CodeBehind="History.aspx.vb" Inherits="CRM.InformationPageHistory" %>
<asp:Content ID="Head" ContentPlaceHolderID="HeadContent" runat="server"><link rel="stylesheet" href="/assets/vendor/fonts/fontawesome.css"/><link rel="stylesheet" href="/assets/vendor/libs/datatables-bs5/datatables.bootstrap5.css"/><link rel="stylesheet" href="/assets/css/crm.css?v=20260913c"/><link rel="stylesheet" href="/assets/css/crm-list.css?v=20261017c"/></asp:Content>
<asp:Content ID="Main" ContentPlaceHolderID="ContentPlaceHolder1" runat="server"><div class="container-xxl flex-grow-1 container-p-y crm-shell crm-types" dir="rtl" data-information-report><div class="type-page-header type-flex align-items-center justify-content-between"><h1 class="h4 mb-0">إصدارات الصفحة</h1><nav aria-label="مسار التنقل"><ol class="breadcrumb mb-0"><li class="breadcrumb-item"><a href="Manage.aspx">إدارة الصفحات المعلوماتية</a></li><li class="breadcrumb-item active" aria-current="page">إصدارات الصفحة</li></ol></nav></div><asp:Literal ID="litMessage" runat="server"/><div class="row g-4 mb-4" aria-label="إحصائيات الصفحة"><div class="col-12 col-md-4"><div class="card type-stat-card"><div class="card-body type-flex align-items-start justify-content-between"><div><span>إجمالي الإصدارات</span><div class="type-stat-count"><asp:Literal ID="statTotal" runat="server" Text="0"/></div></div><span class="badge bg-label-primary rounded type-stat-icon"><i class="bx bx-layer" aria-hidden="true"></i></span></div></div></div><div class="col-12 col-md-4"><div class="card type-stat-card"><div class="card-body type-flex align-items-start justify-content-between"><div><span>إصدارات التعديل</span><div class="type-stat-count"><asp:Literal ID="statUpdates" runat="server" Text="0"/></div></div><span class="badge bg-label-success rounded type-stat-icon"><i class="bx bx-edit" aria-hidden="true"></i></span></div></div></div><div class="col-12 col-md-4"><div class="card type-stat-card"><div class="card-body type-flex align-items-start justify-content-between"><div><span>إصدارات الاسترجاع</span><div class="type-stat-count"><asp:Literal ID="statRestores" runat="server" Text="0"/></div></div><span class="badge bg-label-warning rounded type-stat-icon"><i class="bx bx-history" aria-hidden="true"></i></span></div></div></div></div>
<div class="card"><div class="card-header type-filter-header"><h2 class="card-title h5 mb-0">تصفية البحث</h2><div class="row g-3 align-items-center"><div class="col-12 col-md"><input class="form-control" type="search" placeholder="عنوان الصفحة أو اسم المنفذ" aria-label="عنوان الصفحة أو اسم المنفذ" data-history-name/></div><div class="col-12 col-md"><select class="form-select" aria-label="نوع العملية" data-history-action><option value="">جميع العمليات</option><option>إنشاء</option><option>تعديل</option><option>استرجاع إصدار سابق</option><option>حذف منطقي</option></select></div><div class="col-auto"><button type="button" class="btn btn-icon btn-label-secondary" data-history-reset aria-label="إعادة تعيين" title="إعادة تعيين"><i class="fa-solid fa-rotate-left" aria-hidden="true"></i></button></div></div><p class="small text-muted mb-0 mt-3">استرجاع إصدار سابق ينشئ نسخة جديدة بالمحتوى وإعدادات النشر والترتيب، مع بقاء صلاحيات الاطلاع الحالية.</p></div>
<div id="pnlTableActions" class="type-flex type-toolbar-controls"><a href="Manage.aspx" class="btn btn-label-secondary"><i class="fa-solid fa-arrow-right me-2" aria-hidden="true"></i>العودة إلى الإدارة</a></div>
<div class="table-responsive"><table id="ERPTable" data-enhanced="1" class="table type-table" aria-label="إصدارات الصفحة"><thead><tr><th>الإصدار</th><th>العنوان</th><th>العملية</th><th>المنفذ</th><th>التاريخ — عمّان</th><th>إعدادات النشر</th><th>الإجراءات</th></tr></thead><tbody>
<asp:ListView ID="lstVersions" runat="server" OnItemCommand="Version_Command"><LayoutTemplate><asp:PlaceHolder ID="itemPlaceholder" runat="server"/></LayoutTemplate><ItemTemplate><tr>
<td data-title="الإصدار"><span class="badge bg-label-primary"><%#: Eval("VersionNumber") %></span></td><td data-title="العنوان"><div class="fw-semibold type-record-name"><%#: Eval("Title_Ar") %></div><small class="text-muted d-block" dir="ltr"><%#: Eval("Title_En") %></small></td><td data-title="العملية"><%#: CRM.InformationPagesData.ActionText(Eval("Action")) %><small class="text-muted d-block"><%#: If(IsDBNull(Eval("RestoredFromVersion")), "", "من الإصدار " & Convert.ToString(Eval("RestoredFromVersion"))) %></small></td><td data-title="المنفذ"><%#: Eval("ActorName") %> <small class="text-muted">(<%#: Eval("ActorID") %>)</small></td><td data-title="التاريخ — عمّان"><%#: CRM.InformationPagesData.LocalDate(Eval("OccurredUtc")) %></td>
<td data-title="إعدادات النشر"><span class='badge <%# If(CBool(Eval("IsDeleted")),"bg-label-danger",If(CBool(Eval("IsPublished")),"bg-label-success","bg-label-secondary")) %>'><%#: If(CBool(Eval("IsDeleted")),"محذوفة",If(CBool(Eval("IsPublished")),"منشورة","مسودة")) %></span> <small><%#: If(CStr(Eval("PublishMode"))="scheduled","مجدول","فوري") %></small><small class="d-block text-muted"><%#: CRM.InformationPagesData.LocalDate(Eval("StartUtc")) %> — <%#: CRM.InformationPagesData.LocalDate(Eval("EndUtc")) %></small></td>
<td data-title="الإجراءات"><div class="type-flex type-row-actions"><a class="btn btn-sm btn-icon type-row-action text-secondary" data-bs-toggle="tooltip" title="عرض الإصدار" aria-label="عرض الإصدار" href='<%# "View.aspx?preview=1&ID=" & Eval("PageID").ToString() & "&version=" & Eval("VersionNumber").ToString() %>'><i class="fa-solid fa-eye" aria-hidden="true"></i></a><asp:LinkButton ID="btnRestore" runat="server" CommandName="RestoreVersion" CommandArgument='<%# Eval("VersionNumber").ToString() & ":" & Eval("CurrentVersion").ToString() %>' Visible='<%# CBool(Eval("CanRestore")) %>' CssClass="btn btn-sm btn-icon type-row-action text-warning" data-restore-version='<%# Eval("VersionNumber") %>' data-bs-toggle="tooltip" ToolTip="استرجاع هذا الإصدار" aria-label="استرجاع هذا الإصدار" CausesValidation="false"><i class="fa-solid fa-clock-rotate-left" aria-hidden="true"></i></asp:LinkButton></div></td>
</tr></ItemTemplate></asp:ListView></tbody></table></div></div>
<div class="modal fade" id="restoreVersionModal" tabindex="-1" aria-labelledby="restoreVersionTitle" aria-hidden="true"><div class="modal-dialog modal-dialog-centered"><div class="modal-content"><div class="modal-header"><h2 class="modal-title h5" id="restoreVersionTitle">تأكيد استرجاع الإصدار</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="إغلاق"></button></div><div class="modal-body">هل تريد استرجاع الإصدار <strong data-restore-number></strong> كنسخة جديدة؟ ستُستعاد إعدادات النشر والترتيب، وستبقى صلاحيات الاطلاع الحالية.</div><div class="modal-footer"><button type="button" class="btn btn-label-secondary" data-bs-dismiss="modal">إلغاء</button><button type="button" class="btn btn-warning" data-restore-confirm>تأكيد الاسترجاع</button></div></div></div></div>
</div><script src="/assets/js/crm-list.js?v=20261021suppliers"></script><script src="/assets/js/information-reports.js?v=20261018"></script></asp:Content>
