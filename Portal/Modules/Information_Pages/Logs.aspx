<%@ Page Title="سجل الصفحات المعلوماتية" Language="vb" AutoEventWireup="false" MasterPageFile="~/Site.Master" CodeBehind="Logs.aspx.vb" Inherits="CRM.InformationPageLogs" %>
<asp:Content ID="Head" ContentPlaceHolderID="HeadContent" runat="server"><link rel="stylesheet" href="/assets/vendor/fonts/fontawesome.css"/><link rel="stylesheet" href="/assets/vendor/libs/datatables-bs5/datatables.bootstrap5.css"/><link rel="stylesheet" href="/assets/css/crm.css?v=20260913c"/><link rel="stylesheet" href="/assets/css/crm-list.css?v=20261017c"/></asp:Content>
<asp:Content ID="Main" ContentPlaceHolderID="ContentPlaceHolder1" runat="server"><div class="container-xxl flex-grow-1 container-p-y crm-shell crm-types" dir="rtl" data-information-report><div class="type-page-header type-flex align-items-center justify-content-between"><h1 class="h4 mb-0">سجل العمليات والزيارات</h1><nav aria-label="مسار التنقل"><ol class="breadcrumb mb-0"><li class="breadcrumb-item"><a href="Manage.aspx">إدارة الصفحات المعلوماتية</a></li><li class="breadcrumb-item active" aria-current="page">سجل العمليات والزيارات</li></ol></nav></div><asp:Literal ID="litMessage" runat="server"/><div class="row g-4 mb-4" aria-label="إحصائيات الصفحة"><div class="col-12 col-md-4"><div class="card type-stat-card"><div class="card-body type-flex align-items-start justify-content-between"><div><span>إجمالي السجلات المطابقة</span><div class="type-stat-count"><asp:Literal ID="statTotal" runat="server" Text="0"/></div></div><span class="badge bg-label-primary rounded type-stat-icon"><i class="bx bx-history" aria-hidden="true"></i></span></div></div></div><div class="col-12 col-md-4"><div class="card type-stat-card"><div class="card-body type-flex align-items-start justify-content-between"><div><span>زيارات ومعاينات الدفعة</span><div class="type-stat-count"><asp:Literal ID="statVisits" runat="server" Text="0"/></div></div><span class="badge bg-label-success rounded type-stat-icon"><i class="bx bx-show" aria-hidden="true"></i></span></div></div></div><div class="col-12 col-md-4"><div class="card type-stat-card"><div class="card-body type-flex align-items-start justify-content-between"><div><span>عمليات الإدارة في الدفعة</span><div class="type-stat-count"><asp:Literal ID="statChanges" runat="server" Text="0"/></div></div><span class="badge bg-label-warning rounded type-stat-icon"><i class="bx bx-edit" aria-hidden="true"></i></span></div></div></div></div><div class="card"><div class="card-header type-filter-header"><h2 class="card-title h5 mb-0">تصفية البحث</h2><asp:Panel ID="pnlSearch" runat="server" DefaultButton="btnSearch" CssClass="row g-3 align-items-center"><div class="col-12 col-md"><asp:TextBox ID="txtEmployee" runat="server" CssClass="form-control" MaxLength="250" placeholder="اسم الموظف أو العميل" aria-label="اسم الموظف أو العميل"/></div><div class="col-12 col-md"><asp:DropDownList ID="ddlAction" runat="server" CssClass="form-select" aria-label="نوع العملية"><asp:ListItem Value="">جميع العمليات</asp:ListItem><asp:ListItem Value="view">زيارة</asp:ListItem><asp:ListItem Value="create">إنشاء</asp:ListItem><asp:ListItem Value="update">تعديل</asp:ListItem><asp:ListItem Value="delete">حذف منطقي</asp:ListItem><asp:ListItem Value="access">تعديل صلاحيات الاطلاع</asp:ListItem><asp:ListItem Value="restore">استرجاع إصدار سابق</asp:ListItem><asp:ListItem Value="preview">معاينة مدير النظام</asp:ListItem></asp:DropDownList></div><div class="col-auto type-flex gap-2"><asp:LinkButton ID="btnSearch" runat="server" OnClick="Search_Click" CssClass="btn btn-icon btn-label-secondary" aria-label="بحث" ToolTip="بحث" CausesValidation="false"><i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i></asp:LinkButton><asp:LinkButton ID="btnReset" runat="server" OnClick="Reset_Click" CssClass="btn btn-icon btn-label-secondary" aria-label="إعادة تعيين" ToolTip="إعادة تعيين" CausesValidation="false"><i class="fa-solid fa-rotate-left" aria-hidden="true"></i></asp:LinkButton></div></asp:Panel><p class="small text-muted mb-0 mt-3">تُحمَّل السجلات على دفعات من 50 سجلًا. فلاتر المنفذ والعملية تبحث في جميع السجلات؛ البحث السريع يصفّي الدفعة المعروضة.</p></div><div id="pnlTableActions" class="type-flex type-toolbar-controls"><a href="Manage.aspx" class="btn btn-label-secondary"><i class="fa-solid fa-arrow-right me-2" aria-hidden="true"></i>العودة إلى الإدارة</a></div><div class="table-responsive"><table id="ERPTable" data-enhanced="1" class="table type-table" aria-label="سجل العمليات والزيارات"><thead><tr><th>الصفحة</th><th>الإصدار</th><th>العملية</th><th>المنفذ</th><th>التاريخ — عمّان</th><th>لغة العرض</th><th>تفاصيل العملية</th></tr></thead><tbody>
<asp:ListView ID="lstLogs" runat="server"><LayoutTemplate><asp:PlaceHolder ID="itemPlaceholder" runat="server" /></LayoutTemplate><ItemTemplate><tr><td data-title="الصفحة"><a href='<%# "History.aspx?ID=" & Eval("PageID").ToString() %>'><%#: Eval("Title_Ar") %></a></td><td data-title="الإصدار"><%#: Eval("VersionNumber") %></td><td data-title="العملية"><%#: CRM.InformationPagesData.ActionText(Eval("Action")) %></td><td data-title="المنفذ"><div class="fw-semibold"><%#: Eval("ActorName") %></div><small class="text-muted"><%#: If(IsDBNull(Eval("CustomerAccountID")), If(Convert.ToInt32(Eval("ActorID"))=0,"النظام","موظف"),"عميل") %> · <%#: If(IsDBNull(Eval("CustomerAccountID")), Eval("ActorID"), Eval("CustomerAccountID")) %></small></td><td data-title="التاريخ — عمّان" class="text-nowrap"><%#: CRM.InformationPagesData.LocalDate(Eval("OccurredUtc")) %></td><td data-title="لغة العرض"><%#: If(Convert.ToString(Eval("Language"))="ar","العربية",If(Convert.ToString(Eval("Language"))="en","English","—")) %></td><td data-title="تفاصيل العملية" style="min-width:200px;white-space:normal"><%#: Eval("Details") %></td></tr></ItemTemplate></asp:ListView></tbody></table></div><div class="d-flex align-items-center justify-content-between flex-wrap gap-2 p-3 border-top"><asp:Button ID="btnPrevious" runat="server" Text="الدفعة السابقة" OnClick="Previous_Click" CssClass="btn btn-sm btn-label-secondary"/><asp:Label ID="lblCount" runat="server" CssClass="small text-muted"/><asp:Button ID="btnNext" runat="server" Text="الدفعة التالية" OnClick="Next_Click" CssClass="btn btn-sm btn-label-secondary"/></div></div></div><script src="/assets/js/crm-list.js?v=20261021suppliers"></script><script src="/assets/js/information-reports.js?v=20261018"></script></asp:Content>
