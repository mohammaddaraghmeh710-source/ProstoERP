<%@ Page Title="سجل الصفحات المعلوماتية" Language="vb" AutoEventWireup="false" MasterPageFile="~/Site.Master" CodeBehind="Logs.aspx.vb" Inherits="CRM.InformationPageLogs" %>
<asp:Content ID="Head" ContentPlaceHolderID="HeadContent" runat="server"></asp:Content>
<asp:Content ID="Main" ContentPlaceHolderID="ContentPlaceHolder1" runat="server"><div class="container-xxl flex-grow-1 container-p-y" dir="rtl"><asp:Literal ID="litMessage" runat="server" /><section class="card"><div class="card-header d-flex justify-content-between flex-wrap gap-2"><h4 class="mb-0">سجل العمليات والزيارات</h4><a href="Manage.aspx" class="btn btn-outline-secondary">إدارة الصفحات</a></div><div class="card-body">
<div class="row g-3 align-items-end mb-4"><div class="col-md-5"><asp:Label runat="server" AssociatedControlID="txtEmployee" CssClass="form-label" Text="اسم الموظف" /><asp:TextBox ID="txtEmployee" runat="server" CssClass="form-control" MaxLength="250" /></div><div class="col-md-5"><asp:Label runat="server" AssociatedControlID="ddlAction" CssClass="form-label" Text="نوع العملية" /><asp:DropDownList ID="ddlAction" runat="server" CssClass="form-select"><asp:ListItem Value="">الكل</asp:ListItem><asp:ListItem Value="view">زيارة</asp:ListItem><asp:ListItem Value="create">إنشاء</asp:ListItem><asp:ListItem Value="update">تعديل</asp:ListItem><asp:ListItem Value="delete">حذف منطقي</asp:ListItem><asp:ListItem Value="access">تعديل صلاحيات الاطلاع</asp:ListItem><asp:ListItem Value="restore">استرجاع إصدار سابق</asp:ListItem><asp:ListItem Value="preview">معاينة مدير النظام</asp:ListItem></asp:DropDownList></div><div class="col-md-2"><asp:Button ID="btnSearch" runat="server" Text="بحث" OnClick="Search_Click" CssClass="btn btn-primary" /></div></div>
<p class="text-muted">تُسجَّل كل مرة تُفتح فيها تفاصيل الصفحة، مع اسم الموظف وقت العملية والإصدار المعروض. إعادة تحميل الصفحة تُعد زيارة جديدة.</p>
<div class="table-responsive"><table class="table table-bordered"><thead><tr><th>الصفحة</th><th>الإصدار</th><th>العملية</th><th>اسم الموظف</th><th>رقم المستخدم</th><th>التاريخ — عمّان</th><th>لغة العرض</th><th>تفاصيل العملية</th></tr></thead><tbody>
<asp:ListView ID="lstLogs" runat="server"><LayoutTemplate><asp:PlaceHolder ID="itemPlaceholder" runat="server" /></LayoutTemplate><ItemTemplate><tr><td><a href='<%# "History.aspx?ID=" & Eval("PageID").ToString() %>'><%#: Eval("Title_Ar") %></a></td><td><%#: Eval("VersionNumber") %></td><td><%#: CRM.InformationPagesData.ActionText(Eval("Action")) %></td><td><%#: Eval("ActorName") %></td><td><%#: Eval("ActorID") %></td><td><%#: CRM.InformationPagesData.LocalDate(Eval("OccurredUtc")) %></td><td><%#: If(Convert.ToString(Eval("Language"))="ar","العربية",If(Convert.ToString(Eval("Language"))="en","English","—")) %></td><td style="min-width:200px;white-space:normal"><%#: Eval("Details") %></td></tr></ItemTemplate><EmptyDataTemplate><tr><td colspan="8" class="text-center py-4">لا توجد سجلات مطابقة.</td></tr></EmptyDataTemplate></asp:ListView></tbody></table></div>
<div class="d-flex align-items-center justify-content-between mt-3"><asp:Button ID="btnPrevious" runat="server" Text="السابق" OnClick="Previous_Click" CssClass="btn btn-outline-secondary" /><asp:Label ID="lblCount" runat="server" /><asp:Button ID="btnNext" runat="server" Text="التالي" OnClick="Next_Click" CssClass="btn btn-outline-secondary" /></div>
</div></section></div></asp:Content>
