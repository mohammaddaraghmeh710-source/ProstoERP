<script runat="server">
Protected Overrides Sub OnInit(e As EventArgs)
 MyBase.OnInit(e)
 Dim raw=Request.QueryString("view"),id As Integer
 If raw Is Nothing Then Return
 If Not Integer.TryParse(raw,id) OrElse id<1 Then Throw New System.Web.HttpException(400,"رابط التعميم غير صحيح.")
 DirectCast(FindControl("circularReader"),CRM.CircularReader).InitialID=id
End Sub
</script>
