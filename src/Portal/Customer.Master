<li class="menu-item"><a href="/CustomerPortal/Feedback.aspx" class="menu-link"><i class="menu-icon tf-icons bx bx-message-square-detail" aria-hidden="true"></i><div>الشكاوى والاقتراحات</div></a></li>
</ul></div></aside><main class="container-xxl flex-grow-1 container-p-y" id="erp-main-content" tabindex="-1"><asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server"/></main><footer class="content-footer footer bg-footer-theme"><div class="container-xxl py-3 text-muted small">مايوركا · بوابة العملاء والتواصل</div></footer><div class="content-backdrop fade"></div></div></div>
</div><div class="layout-overlay layout-menu-toggle"></div><div class="drag-target"></div></div></form><script src="/assets/vendor/libs/jquery/jquery.js"></script><script src="/assets/vendor/libs/popper/popper.js"></script><script src="/assets/vendor/js/bootstrap.js"></script><script src="/assets/vendor/libs/perfect-scrollbar/perfect-scrollbar.js"></script><script src="/assets/vendor/libs/hammer/hammer.js"></script><script src="/assets/vendor/js/menu.js"></script><script src="/assets/vendor/libs/select2/select2.js"></script><script src="/assets/js/main.js"></script><script>(function(){function update(){var current=new URL(location.href),path=current.pathname.toLowerCase(),circular=path.endsWith('/dashboard.aspx')&&(current.hash==='#customerCirculars'||current.searchParams.has('circular'));document.querySelectorAll('#layout-menu .menu-item.active').forEach(function(item){item.classList.remove('active');});document.querySelectorAll('#layout-menu .menu-link').forEach(function(link){var target=new URL(link.href),destination=target.pathname.toLowerCase(),match=false;if(path.endsWith('/dashboard.aspx')&&destination.endsWith('/dashboard.aspx'))match=circular?target.hash==='#customerCirculars':!target.hash;else if(path===destination)match=path.endsWith('/informationpage.aspx')?target.searchParams.get('id')===current.searchParams.get('id'):true;else if(path.indexOf('/customerportal/newsdetail')===0)match=destination.endsWith('/dashboard.aspx')&&!target.hash;else if(path.indexOf('/customerportal/workguide')===0)match=destination.endsWith('/workguide.aspx');else if(path.indexOf('/customerportal/feedback')===0)match=destination.endsWith('/feedback.aspx');if(match){link.parentElement.classList.add('active');var parent=link.closest('.menu-sub');if(parent)parent.parentElement.classList.add('active','open');}});}update();window.addEventListener('hashchange',update);})();</script></body></html>
