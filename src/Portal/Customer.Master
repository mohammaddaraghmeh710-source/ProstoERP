<!doctype html><html lang="ar" dir="rtl" class="light-style" data-theme="theme-default" data-assets-path="/assets/" data-template="horizontal-menu-template"><head runat="server"><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>بوابة العملاء | مايوركا</title><link rel="icon" href="/assets/img/Prosto/Fav-Red.png"/><link rel="stylesheet" href="/assets/vendor/fonts/boxicons.css"/><link rel="stylesheet" href="/assets/vendor/css/rtl/core.css"/><link rel="stylesheet" href="/assets/vendor/css/rtl/theme-default.css"/><link rel="stylesheet" href="/assets/css/demo.css"/><link rel="stylesheet" href="/assets/vendor/libs/perfect-scrollbar/perfect-scrollbar.css"/><link rel="stylesheet" href="/assets/vendor/libs/select2/select2.css"/><script src="/assets/vendor/js/helpers.js"></script><script src="/assets/js/config.js"></script><asp:ContentPlaceHolder ID="HeadContent" runat="server"/><link rel="stylesheet" href="/assets/css/erp-theme.css?v=20260906"/><style>.customer-header-logo{object-fit:contain;background:#fff}.customer-header-name{max-width:18rem;overflow-wrap:anywhere}.customer-information-menu .menu-sub{max-height:60vh;overflow-y:auto}.customer-information-menu .menu-sub .menu-link div{white-space:normal;overflow-wrap:anywhere}.customer-notifications-menu{width:min(22rem,90vw)}@media(max-width:575.98px){.customer-header-name{max-width:9rem;font-size:.8125rem}}</style></head>
<body class="erp-ui"><a class="erp-skip-link" href="#erp-main-content">انتقل إلى المحتوى</a><form runat="server"><div class="layout-wrapper layout-navbar-full layout-horizontal layout-without-menu"><div class="layout-container">
<nav class="layout-navbar navbar navbar-expand-xl align-items-center bg-navbar-theme" id="layout-navbar" aria-label="ترويسة بوابة العميل"><div class="container-xxl"><div class="navbar-brand app-brand demo d-none d-xl-flex py-0 me-4"><a href="/CustomerPortal/Dashboard.aspx" class="app-brand-link gap-2"><span class="app-brand-logo demo"><img src="/assets/img/Prosto/Logo_Circle.png" class="erp-brand-logo" alt="بروستو"/></span><span class="erp-brand-name menu-text fw-bold">مايوركا للمأكولات الشامية</span></a></div><div class="layout-menu-toggle navbar-nav align-items-xl-center me-3 me-xl-0 d-xl-none"><a class="nav-item nav-link px-0 me-xl-4" href="#" aria-label="فتح القائمة الرئيسية"><i class="bx bx-menu bx-sm" aria-hidden="true"></i></a></div>
<div class="navbar-nav-right d-flex align-items-center" id="navbar-collapse"><span class="text-muted small d-none d-sm-block">بوابة العملاء</span><ul class="navbar-nav flex-row align-items-center ms-auto">
<li class="nav-item dropdown-notifications navbar-dropdown dropdown me-3 me-xl-2"><uc:CircularNotifications ID="circularNotificationMenu" runat="server"/></li>
<li class="nav-item navbar-dropdown dropdown-user dropdown"><button type="button" class="nav-link dropdown-toggle hide-arrow btn btn-link p-0 d-flex align-items-center gap-2" data-bs-toggle="dropdown" aria-expanded="false" aria-label="حساب العميل"><span class="customer-header-name text-body"><asp:Literal ID="litCustomer" runat="server" Mode="Encode"/></span><span class="avatar"><img src="/CustomerPortal/Logo.aspx" alt="شعار العميل" class="rounded-circle customer-header-logo" width="40" height="40"/></span></button><ul class="dropdown-menu dropdown-menu-end"><li><a class="dropdown-item" href="/CustomerPortal/Dashboard.aspx"><i class="bx bx-user me-2" aria-hidden="true"></i>حسابي</a></li><li><div class="dropdown-divider"></div></li><li><asp:LinkButton ID="btnLogout" runat="server" OnClick="Logout_Click" CssClass="dropdown-item" CausesValidation="false"><i class="bx bx-power-off me-2" aria-hidden="true"></i>تسجيل الخروج</asp:LinkButton></li></ul></li>
</ul></div></div></nav>
<div class="layout-page"><div class="content-wrapper"><aside id="layout-menu" class="layout-menu-horizontal menu-horizontal menu bg-menu-theme flex-grow-0" aria-label="القائمة الرئيسية للعميل"><div class="container-xxl d-flex h-100"><ul class="menu-inner">
<li class="menu-item"><a href="/CustomerPortal/Dashboard.aspx" class="menu-link"><i class="menu-icon tf-icons bx bx-home-alt" aria-hidden="true"></i><div>الصفحة الرئيسية</div></a></li>
