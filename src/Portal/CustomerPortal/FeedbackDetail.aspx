<%@ Page Title="تفاصيل الطلب" Language="vb" AutoEventWireup="false" MasterPageFile="~/Customer.Master" CodeBehind="FeedbackDetail.aspx.vb" Inherits="CRM.CustomerFeedbackDetail" %>
<%@ Import Namespace="CRM" %>
<asp:Content ID="head" runat="server" ContentPlaceHolderID="HeadContent"><link rel="stylesheet" href="/assets/vendor/fonts/fontawesome.css" /><link rel="stylesheet" href="/assets/css/crm.css" /><link rel="stylesheet" href="/assets/css/crm-list.css" /><link rel="stylesheet" href="/assets/css/feedback-workspace.css?v=20261022j" /><link rel="stylesheet" href="/assets/css/customer-feedback.css?v=20261022e" /></asp:Content>
<asp:Content ID="body" runat="server" ContentPlaceHolderID="ContentPlaceHolder1">
<div class="crm-types feedback-workspace feedback-detail feedback-customer-detail" dir="rtl">

<div class="row invoice-preview"><div class="col-12"><div class="card invoice-preview-card feedback-detail-card"><div class="nav-align-top"><ul class="nav nav-tabs nav-fill feedback-detail-tabs border-bottom" role="tablist" aria-label="تفاصيل الطلب"><li class="nav-item" role="presentation"><button type="button" id="customer-feedback-details-tab" class='nav-link text-wrap active' data-bs-toggle="tab" data-bs-target="#customer-feedback-details" role="tab" aria-controls="customer-feedback-details" aria-selected='true'><i class="fa-solid fa-file-lines me-1" aria-hidden="true"></i>معلومات الطلب</button></li><li class="nav-item" role="presentation"><button type="button" id="customer-feedback-workflow-tab" class='nav-link text-wrap' data-bs-toggle="tab" data-bs-target="#customer-feedback-workflow" role="tab" aria-controls="customer-feedback-workflow" aria-selected='false'><i class="fa-solid fa-diagram-project me-1" aria-hidden="true"></i>سير العمل</button></li></ul><div class="tab-content p-0"><div class='tab-pane fade show active' id="customer-feedback-details" role="tabpanel" aria-labelledby="customer-feedback-details-tab" tabindex="0"><section class="card-body feedback-request-summary" aria-label="معلومات الطلب">
 <dl class="d-flex flex-wrap align-items-center gap-2 gap-sm-3 mb-2 feedback-request-meta">
  <div class="d-flex align-items-baseline gap-1"><dt class="text-muted">رقم الطلب:</dt><dd class="fw-semibold text-primary">#<asp:Literal ID="litID" runat="server" Mode="Encode" /></dd></div>
  <div class="d-flex align-items-center gap-1"><dt class="visually-hidden">المصدر</dt><dd><asp:Label ID="lblSource" runat="server" CssClass="badge bg-label-secondary" /></dd></div>
  <div class="d-flex align-items-center gap-1"><dt class="visually-hidden">النوع</dt><dd><asp:Label ID="lblType" runat="server" CssClass="badge bg-label-info" /></dd></div>
  <div class="d-flex align-items-center gap-1"><dt class="visually-hidden">الحالة</dt><dd><asp:Label ID="lblStatus" runat="server" /></dd></div>
 </dl>
 <h1 class="h6 feedback-request-title mb-2"><asp:Literal ID="litTitle" runat="server" Mode="Encode" /></h1>
 <dl class="row g-1 mb-0 feedback-request-meta"><asp:Literal ID="litMeta" runat="server" /></dl>
</section>
<div class="card-body pt-0"><div class="row g-3 align-items-stretch">
 <section class="col-12 col-lg-8 feedback-request-body" aria-labelledby="customer-feedback-text-title"><h2 id="customer-feedback-text-title" class="feedback-section-title mb-2">تفاصيل الطلب</h2><div class="feedback-request-text"><asp:Literal ID="litDetails" runat="server" /></div></section>
 <section class="col-12 col-lg-4 feedback-request-applicant" id="customer-feedback-applicant" aria-labelledby="customer-feedback-applicant-title"><div class="bg-lighter rounded p-3 h-100"><h2 class="feedback-section-title mb-2" id="customer-feedback-applicant-title">معلومات مقدم الطلب</h2><asp:Literal ID="litContact" runat="server" /></div></section>
</div></div>
<hr class="my-0" />
<section class="card-body" aria-label="المرفقات"><div><h2 class="feedback-section-title mb-2"><i class="fa-solid fa-paperclip me-1" aria-hidden="true"></i>المرفقات</h2><asp:Repeater ID="attachments" runat="server"><ItemTemplate><span class="d-inline-flex align-items-center gap-2 border rounded p-2 me-2 mb-2"><i class="bx bx-file text-primary fs-4" aria-hidden="true"></i><span class="small">مرفق <%#: Container.ItemIndex+1 %> · <%#: Eval("File_Type") %></span><asp:PlaceHolder runat="server" Visible='<%# CanPreview(Eval("File_Type")) %>'><a class="btn btn-sm btn-label-primary" data-feedback-preview="true" data-bs-toggle="modal" data-bs-target="#feedback-preview" href='FeedbackFile.aspx?id=<%# Eval("ID") %>&amp;preview=1'>معاينة</a></asp:PlaceHolder><a class="btn btn-sm btn-label-secondary" href='FeedbackFile.aspx?id=<%# Eval("ID") %>' aria-label="تنزيل المرفق"><i class="bx bx-download"></i></a></span></ItemTemplate></asp:Repeater><asp:Label ID="lblNoFiles" runat="server" Text="لا توجد مرفقات لهذا الطلب." CssClass="text-muted" /></div></section></div><div class="tab-pane fade" id="customer-feedback-workflow" role="tabpanel" aria-labelledby="customer-feedback-workflow-tab" tabindex="0"><div class="card-body"><ol class="timeline mt-2 mb-0"><asp:Repeater ID="workflow" runat="server"><ItemTemplate><li class="timeline-item timeline-item-transparent ps-4"><span class='<%# "timeline-point timeline-point-" & If(CInt(Eval("ActionType"))=3,"success",If(CInt(Eval("ActionType"))=2,"warning","primary")) %>'></span><div class="timeline-event pb-2"><div class="d-inline-flex w-100 flex-wrap justify-content-between gap-2"><h6 class="mb-1"><i class="bx bx-history me-1"></i><%#: CRM.EmployeeFeedbackData.ActionText(Eval("ActionType")) %></h6><small dir="ltr"><%#: CRM.CorrespondencePresentation.DisplayDate(Eval("AddedDate")) %></small></div><p class="small"><%#: Eval("SenderName") %> ← <%#: Eval("ReceiverNames") %></p><div class="text-break mb-2"><%# CRM.CorrespondencePresentation.MessageHtml(Eval("Comment")) %></div><asp:Repeater ID="actionAttachments" runat="server" DataSource='<%# FilesFor(Eval("GroupID")) %>'><ItemTemplate><span class="d-inline-flex align-items-center gap-2 border rounded p-2 me-2 mb-2"><i class="bx bx-file text-primary fs-4" aria-hidden="true"></i><span class="small">مرفق <%#: Container.ItemIndex+1 %> · <%#: Eval("File_Type") %></span><asp:PlaceHolder runat="server" Visible='<%# CanPreview(Eval("File_Type")) %>'><a class="btn btn-sm btn-label-primary" data-feedback-preview="true" data-bs-toggle="modal" data-bs-target="#feedback-preview" href='FeedbackFile.aspx?id=<%# Eval("ID") %>&amp;preview=1'>معاينة</a></asp:PlaceHolder><a class="btn btn-sm btn-label-secondary" href='FeedbackFile.aspx?id=<%# Eval("ID") %>' aria-label="تنزيل المرفق"><i class="bx bx-download"></i></a></span></ItemTemplate></asp:Repeater></div></li></ItemTemplate></asp:Repeater></ol></div></div></div></div></div></div></div>
<div class="feedback-detail-footer d-flex justify-content-end mt-3"><a href="Feedback.aspx" class="btn btn-primary"><i class="fa-solid fa-arrow-right me-2" aria-hidden="true"></i>العودة للقائمة</a></div>
<div class="modal fade" id="feedback-preview" tabindex="-1" aria-labelledby="feedback-preview-title" aria-hidden="true"><div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable"><div class="modal-content"><div class="modal-header"><h5 id="feedback-preview-title" class="modal-title">معاينة المرفق</h5><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="إغلاق"></button></div><div class="modal-body p-3">
 <div id="feedback-preview-status" class="text-muted small py-3" role="status" aria-live="polite">جارٍ تحميل المرفق للمعاينة…</div>
 <div id="feedback-preview-controls" hidden><div class="d-flex flex-wrap align-items-center justify-content-center gap-3 border-top border-bottom py-2 mb-3" dir="rtl" role="group" aria-label="التنقل بين صفحات المرفق"><button type="button" id="feedback-preview-previous" class="btn btn-sm btn-label-secondary" disabled><i class="bx bx-chevron-right me-1" aria-hidden="true"></i>السابق</button><span id="feedback-preview-page" class="small" dir="ltr" aria-live="polite">—</span><button type="button" id="feedback-preview-next" class="btn btn-sm btn-label-secondary" disabled>التالي<i class="bx bx-chevron-left ms-1" aria-hidden="true"></i></button></div></div>
 <div id="feedback-preview-surface" class="text-center rounded p-2 overflow-auto bg-lighter" style="max-height:70vh" hidden><canvas id="feedback-preview-canvas" aria-label="صفحة ملف PDF" style="max-width:100%;height:auto;background:white" hidden></canvas><img id="feedback-preview-image" alt="معاينة صورة المرفق" style="max-width:100%;height:auto" hidden /></div>
</div></div></div></div>
</div><script src="/assets/js/pdf.min.js"></script><script src="/assets/js/feedback-preview.js?v=20261022c"></script><script>document.addEventListener('DOMContentLoaded',function(){document.dispatchEvent(new CustomEvent('feedback-updated'));});</script>
</asp:Content>
