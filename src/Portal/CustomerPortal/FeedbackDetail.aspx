<%@ Page Title="تفاصيل الطلب" Language="vb" AutoEventWireup="false" MasterPageFile="~/Customer.Master" CodeBehind="FeedbackDetail.aspx.vb" Inherits="CRM.CustomerFeedbackDetail" %>
<%@ Import Namespace="CRM" %>
<asp:Content ID="body" runat="server" ContentPlaceHolderID="ContentPlaceHolder1">
<div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4"><h3 class="mb-0">تفاصيل الطلب</h3><a href="Feedback.aspx" class="btn btn-label-secondary">العودة لطلباتي</a></div>
<asp:Repeater ID="detail" runat="server"><ItemTemplate><article class="card mb-4"><div class="card-header"><div class="d-flex justify-content-between gap-3 mb-3"><span class="badge bg-label-primary"><%#: Eval("TypeName")%> #<%#: Eval("ID")%></span><span class='<%# EmployeeFeedbackData.StatusCss(Eval("Status"))%>'><%#: EmployeeFeedbackData.StatusText(Eval("Status"))%></span></div><h4 class="mb-0"><%#: Eval("Title")%></h4></div><div class="card-body"><dl class="row"><dt class="col-sm-3">العلامة التجارية</dt><dd class="col-sm-9"><%#: Eval("Brand_Title_Ar")%></dd><dt class="col-sm-3">الفرع</dt><dd class="col-sm-9"><%#: Eval("Branch_Title_Ar")%></dd><dt class="col-sm-3">الموضوع</dt><dd class="col-sm-9"><%#: Eval("Topic_Title_Ar")%></dd><dt class="col-sm-3">تاريخ التقديم</dt><dd class="col-sm-9"><%#: EmployeeFeedbackData.LogDate(Eval("AddedDate"))%></dd><dt class="col-sm-3">تاريخ الإغلاق</dt><dd class="col-sm-9"><%#: EmployeeFeedbackData.LogDate(Eval("CloseDate"))%></dd></dl><h6>التفاصيل المقدمة</h6><div class="border rounded p-3" style="white-space:pre-wrap;overflow-wrap:anywhere"><%#: Eval("Details")%></div></div></article></ItemTemplate></asp:Repeater>
<div class="card"><div class="card-header"><h5 class="mb-0">مرفقات الطلب</h5></div><div class="card-body"><asp:Literal ID="empty" runat="server"/><div class="d-flex flex-wrap gap-2"><asp:Repeater ID="attachments" runat="server"><ItemTemplate><a class="btn btn-outline-primary" href='FeedbackFile.aspx?id=<%# Eval("ID")%>'>تحميل المرفق #<%#: Eval("ID")%> (<%#: Eval("File_Type")%>)</a></ItemTemplate></asp:Repeater></div></div></div>
</asp:Content>
