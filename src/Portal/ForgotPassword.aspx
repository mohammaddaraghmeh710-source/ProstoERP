<%@ Page Language="vb" AutoEventWireup="false" Async="true" CodeBehind="ForgotPassword.aspx.vb" Inherits="CRM.ForgotPassword" %>
<!doctype html><html lang="ar" dir="rtl" class="light-style customizer-hide" data-theme="theme-default" data-assets-path="/assets/">
<head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" /><title>استعادة كلمة المرور</title>
<link rel="stylesheet" href="/assets/vendor/fonts/boxicons.css" />
<link rel="stylesheet" href="/assets/vendor/css/rtl/core.css" /><link rel="stylesheet" href="/assets/vendor/css/rtl/theme-default.css" />
<link rel="stylesheet" href="/assets/vendor/css/pages/page-auth.css" /><link rel="stylesheet" href="/assets/vendor/libs/bs-stepper/bs-stepper.css" />
<link rel="stylesheet" href="/assets/css/erp-theme.css" /><script src="/assets/vendor/js/helpers.js"></script>
<style>.password-reset-wizard .bs-stepper-header{gap:.25rem}.password-reset-wizard .step{flex:1;min-width:0;margin:0}.password-reset-wizard .step-trigger{flex-direction:column;white-space:normal;padding:.5rem 0;min-width:0;width:100%;gap:.5rem}.password-reset-wizard .bs-stepper-label{margin:0;text-align:center}.password-reset-wizard .bs-stepper-title{font-size:.85rem}.password-reset-wizard .line{flex:0 0 .5rem;margin:0}</style></head>
<body class="erp-ui"><form runat="server"><div class="authentication-wrapper authentication-cover"><div class="authentication-inner row m-0">
<div class="d-none d-lg-flex col-lg-7 col-xl-8 align-items-center justify-content-center p-5"><div class="text-center"><img src="/assets/img/pages/login-light.png" class="img-fluid authentication-cover-img" alt="" /><h2 class="mt-4">استعد الوصول إلى حسابك</h2><p class="text-muted">تحقق من بريدك الإلكتروني، ثم اختر كلمة مرور جديدة.</p></div></div>
<div class="d-flex col-12 col-lg-5 col-xl-4 align-items-center authentication-bg p-sm-5 p-4"><div class="w-100 mx-auto">
<div class="app-brand mb-4 d-flex align-items-center gap-3"><img src="/assets/img/Prosto/Logo_Circle.png" width="56" height="56" alt="مايوركا" /><span class="h3 mb-0">مايوركا</span></div>
<h3>نسيت كلمة المرور؟</h3><p class="text-muted">استعادة حساب الموظف عبر بريده المسجّل.</p>
<asp:Panel ID="pnlAlert" runat="server" Visible="false" CssClass="alert alert-danger" role="alert"><asp:Label ID="lblAlert" runat="server" /></asp:Panel>
<div class="bs-stepper wizard-numbered shadow-none password-reset-wizard"><div class="bs-stepper-header px-0" aria-label="خطوات استعادة كلمة المرور">
<div class="step <%=If(wizard.ActiveViewIndex = 0, "active", "")%>"><span class="step-trigger px-1"><span class="bs-stepper-circle">1</span><span class="bs-stepper-label"><span class="bs-stepper-title">الموظف</span></span></span></div><div class="line"></div>
<div class="step <%=If(wizard.ActiveViewIndex = 1, "active", "")%>"><span class="step-trigger px-1"><span class="bs-stepper-circle">2</span><span class="bs-stepper-label"><span class="bs-stepper-title">التحقق</span></span></span></div><div class="line"></div>
<div class="step <%=If(wizard.ActiveViewIndex >= 2, "active", "")%>"><span class="step-trigger px-1"><span class="bs-stepper-circle">3</span><span class="bs-stepper-label"><span class="bs-stepper-title">كلمة المرور</span></span></span></div></div>
<div class="bs-stepper-content px-0"><asp:MultiView ID="wizard" runat="server" ActiveViewIndex="0">
<asp:View runat="server" ID="viewEmployee"><div class="mb-3"><asp:Label runat="server" AssociatedControlID="txtEmployee" CssClass="form-label" Text="الرقم الوظيفي" /><asp:TextBox ID="txtEmployee" runat="server" CssClass="form-control" inputmode="numeric" MaxLength="10" dir="ltr" autocomplete="username" /></div><asp:Button runat="server" Text="إرسال رمز التحقق" CssClass="btn btn-primary w-100" OnClick="RequestCode" /></asp:View>
<asp:View runat="server" ID="viewOTP"><p role="status">تم إرسال رمز التحقق إلى <asp:Label ID="lblEmail" runat="server" dir="ltr" />.</p><p class="text-muted small">الرمز صالح لمدة 10 دقائق. تحقق أيضًا من البريد غير المرغوب فيه.</p><div class="mb-3"><asp:Label runat="server" AssociatedControlID="txtOTP" Text="رمز التحقق" CssClass="form-label" /><asp:TextBox ID="txtOTP" runat="server" CssClass="form-control text-center" MaxLength="6" inputmode="numeric" dir="ltr" autocomplete="one-time-code" EnableViewState="false" /></div><asp:Button runat="server" Text="التحقق من الرمز" CssClass="btn btn-primary w-100" OnClick="VerifyCode" /><asp:Button ID="btnResend" runat="server" Text="إعادة إرسال الرمز" CssClass="btn btn-outline-primary w-100 mt-3" OnClick="RequestCode" /><asp:Button runat="server" Text="تغيير الرقم الوظيفي" CssClass="btn btn-link w-100" OnClick="StartAgain" /></asp:View>
<asp:View runat="server" ID="viewPassword"><div class="mb-3"><asp:Label runat="server" AssociatedControlID="txtNewPassword" Text="كلمة المرور الجديدة" CssClass="form-label" /><div class="input-group"><asp:TextBox ID="txtNewPassword" runat="server" TextMode="Password" EnableViewState="false" CssClass="form-control" MaxLength="128" autocomplete="new-password" /><button type="button" class="btn btn-outline-secondary" onclick="toggleResetPassword(this)" aria-label="إظهار كلمة المرور" aria-pressed="false"><i class="bx bx-hide"></i></button></div><small class="text-muted">من 8 إلى 128 حرفًا.</small></div><div class="mb-3"><asp:Label runat="server" AssociatedControlID="txtConfirm" Text="تأكيد كلمة المرور" CssClass="form-label" /><asp:TextBox ID="txtConfirm" runat="server" TextMode="Password" EnableViewState="false" CssClass="form-control" MaxLength="128" autocomplete="new-password" /></div><asp:Button runat="server" Text="حفظ كلمة المرور" CssClass="btn btn-primary w-100" OnClick="SavePassword" /></asp:View>
<asp:View runat="server" ID="viewDone"><div class="alert alert-success" role="status">تم تغيير كلمة المرور بنجاح. يمكنك الآن تسجيل الدخول بكلمة المرور الجديدة.</div><a href="/Login.aspx" class="btn btn-primary w-100">تسجيل الدخول</a></asp:View>
</asp:MultiView></div></div><a href="/Login.aspx" class="d-flex justify-content-center mt-3">العودة إلى تسجيل الدخول</a></div></div></div></div></form>
<script>function toggleResetPassword(button){var input=button.parentNode.querySelector('input');var show=input.type==='password';input.type=show?'text':'password';button.setAttribute('aria-pressed',show);button.setAttribute('aria-label',show?'إخفاء كلمة المرور':'إظهار كلمة المرور');}</script></body></html>
