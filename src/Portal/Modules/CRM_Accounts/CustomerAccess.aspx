<%@ Page Title="حساب العميل" Language="vb" AutoEventWireup="false" MasterPageFile="~/Site.Master" CodeBehind="CustomerAccess.aspx.vb" Inherits="CRM.CustomerAccess" %>
<asp:Content ID="head" ContentPlaceHolderID="HeadContent" runat="server" />
<asp:Content ID="body" ContentPlaceHolderID="ContentPlaceHolder1" runat="server">
<div class="container-xxl flex-grow-1 container-p-y" dir="rtl">
<div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-4"><div><p class="text-muted mb-1">إدارة العملاء</p><h4 class="mb-0">حساب <asp:Literal ID="litName" runat="server" /></h4></div><a href="ManageCRMAccounts.aspx" class="btn btn-label-secondary">العودة للعملاء</a></div>
<asp:Literal ID="litMessage" runat="server" />
<asp:HiddenField ID="activeTab" runat="server" Value="credentials"/><ul class="nav nav-pills mb-4" role="tablist"><li class="nav-item"><button type="button" class="nav-link active" data-bs-toggle="tab" data-bs-target="#credentials">بيانات الدخول</button></li><li class="nav-item"><button type="button" class="nav-link" data-bs-toggle="tab" data-bs-target="#history">سجل النشاط</button></li></ul>
<div class="tab-content p-0 bg-transparent shadow-none"><div id="credentials" class="tab-pane fade show active"><div class="card"><div class="card-header"><h5 class="mb-1">حساب دخول مستقل للعميل</h5><p class="text-muted mb-0">يدير مدير النظام بيانات الدخول. إيقاف العميل أو حسابه يمنع الدخول إلى خدماته.</p></div><div class="card-body"><div class="row g-3">
<div class="col-md-6"><asp:Label runat="server" AssociatedControlID="txtUsername" Text="اسم المستخدم" CssClass="form-label" /><asp:TextBox ID="txtUsername" runat="server" CssClass="form-control" MaxLength="100" autocomplete="off" dir="ltr" /></div>
<div class="col-md-6"><asp:Label runat="server" AssociatedControlID="txtPassword" Text="كلمة مرور جديدة" CssClass="form-label" /><asp:TextBox ID="txtPassword" runat="server" TextMode="Password" CssClass="form-control" MaxLength="128" autocomplete="new-password" /><div class="form-text">8 أحرف على الأقل. اتركها فارغة للإبقاء على كلمة المرور الحالية.</div></div>
<div class="col-12"><asp:CheckBox ID="chkLoginActive" runat="server" Text=" السماح للعميل بتسجيل الدخول" Checked="true" /></div><div class="col-12"><asp:Button runat="server" ID="btnLoginSave" Text="حفظ بيانات الدخول" CssClass="btn btn-primary" OnClick="SaveLogin_Click" /></div></div></div></div></div>
<div id="history" class="tab-pane fade"><div class="card"><div class="card-header"><h5 class="mb-0">آخر 100 حدث</h5></div><div class="table-responsive"><asp:GridView ID="activity" runat="server" AutoGenerateColumns="false" CssClass="table mb-0" GridLines="None" EmptyDataText="لا توجد أحداث بعد."><Columns><asp:BoundField DataField="CreatedUtc" HeaderText="الوقت (UTC)" DataFormatString="{0:yyyy/MM/dd HH:mm}" /><asp:BoundField DataField="Action" HeaderText="الإجراء" /><asp:BoundField DataField="ActorName" HeaderText="المنفّذ" /><asp:BoundField DataField="Source_Name" HeaderText="المصدر" /><asp:BoundField DataField="Note" HeaderText="التفاصيل" /></Columns></asp:GridView></div></div></div></div></div>
<script>document.addEventListener('DOMContentLoaded',function(){var field=document.getElementById('<%= activeTab.ClientID %>');var tabs=document.querySelectorAll('[data-bs-toggle="tab"]');tabs.forEach(function(t){t.addEventListener('click',function(){field.value=t.getAttribute('data-bs-target').substring(1);});});if(['credentials','permissions','history'].indexOf(field.value)>=0){var t=document.querySelector('[data-bs-target="#'+field.value+'"]');if(t) bootstrap.Tab.getOrCreateInstance(t).show();}});</script></asp:Content>
