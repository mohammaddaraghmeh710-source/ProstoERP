<%@ Page Title="جهات الاتصال" Language="vb" AutoEventWireup="false" MasterPageFile="~/Site.Master" CodeBehind="ManageCRMContacts.aspx.vb" Inherits="CRM.ManageCRMContacts" %>
<asp:Content ID="head" ContentPlaceHolderID="HeadContent" runat="server">
<link rel="stylesheet" href="/assets/vendor/libs/datatables-bs5/datatables.bootstrap5.css" />
<link rel="stylesheet" href="/assets/css/crm.css?v=20260913c" />
<link rel="stylesheet" href="/assets/css/crm-list.css?v=20261017c" />
</asp:Content>
<asp:Content ID="body" ContentPlaceHolderID="ContentPlaceHolder1" runat="server">
<div class="container-xxl flex-grow-1 container-p-y crm-shell crm-types" dir="rtl">
  <div class="type-page-header type-flex align-items-center justify-content-between"><h1 class="h4 mb-0">جهات الاتصال</h1><nav aria-label="مسار التنقل"><ol class="breadcrumb mb-0"><li class="breadcrumb-item"><a href="/Modules/CRM_Account_Types/Overview.aspx">إدارة العملاء</a></li><li class="breadcrumb-item active" aria-current="page">جهات الاتصال</li></ol></nav></div>
  <asp:Literal ID="litMessage" runat="server" EnableViewState="false" />
  <asp:Panel ID="pnlBody" runat="server">
    <div class="row g-4 mb-4" aria-label="إحصائيات جهات الاتصال">
      <div class="col-12 col-md-4"><div class="card type-stat-card"><div class="card-body type-flex align-items-start justify-content-between"><div><span>إجمالي العناصر</span><div class="type-stat-count"><asp:Literal ID="statTotal" runat="server" Text="—" /></div></div><span class="badge bg-label-primary rounded type-stat-icon"><i class="bx bx-category" aria-hidden="true"></i></span></div></div></div>
      <div class="col-12 col-md-4"><div class="card type-stat-card"><div class="card-body type-flex align-items-start justify-content-between"><div><span>العناصر الفعالة</span><div class="type-stat-count"><asp:Literal ID="statActive" runat="server" Text="—" /></div></div><span class="badge bg-label-success rounded type-stat-icon"><i class="bx bx-check-circle" aria-hidden="true"></i></span></div></div></div>
      <div class="col-12 col-md-4"><div class="card type-stat-card"><div class="card-body type-flex align-items-start justify-content-between"><div><span>العناصر الموقوفة</span><div class="type-stat-count"><asp:Literal ID="statInactive" runat="server" Text="—" /></div></div><span class="badge bg-label-warning rounded type-stat-icon"><i class="bx bx-pause-circle" aria-hidden="true"></i></span></div></div></div>
    </div>
    <div class="card">
      <div class="card-header type-filter-header">
        <h2 class="card-title h5 mb-0">تصفية البحث</h2>
      <asp:Panel ID="pnlSearch" runat="server" DefaultButton="btnSearch" CssClass="row g-3 align-items-center" ClientIDMode="Static"><div class="col-12 col-md-6 col-xl-4"><asp:TextBox ID="filterName" runat="server" CssClass="form-control" MaxLength="200" placeholder="اسم جهة الاتصال" aria-label="اسم جهة الاتصال" /></div><div class="col-12 col-md-6 col-xl-4"><asp:DropDownList ID="filterAccount" runat="server" CssClass="form-select" aria-label="العميل"></asp:DropDownList></div><div class="col-12 col-md-6 col-xl-4"><asp:TextBox ID="filterEmail" runat="server" CssClass="form-control" MaxLength="200" placeholder="البريد الإلكتروني" aria-label="البريد الإلكتروني" /></div><div class="col-12 col-md-6 col-xl-4"><asp:TextBox ID="filterJob" runat="server" CssClass="form-control" MaxLength="200" placeholder="المسمى الوظيفي" aria-label="المسمى الوظيفي" /></div><div class="col-12 col-md-6 col-xl-4"><asp:DropDownList ID="filterStatus" runat="server" CssClass="form-select" aria-label="الحالة"><asp:ListItem Value="" Text="اختر الحالة" /><asp:ListItem Value="1" Text="فعال" /><asp:ListItem Value="0" Text="موقوف" /></asp:DropDownList></div><div class="col-12 col-md-6 col-xl-4 type-flex gap-2"><asp:LinkButton ID="btnSearch" runat="server" CssClass="btn btn-icon btn-label-secondary" OnClick="Search_Click" CausesValidation="false" ToolTip="بحث" aria-label="بحث" data-bs-toggle="tooltip"><i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i></asp:LinkButton><asp:LinkButton ID="btnReset" runat="server" CssClass="btn btn-icon btn-label-secondary" OnClick="ResetFilters_Click" CausesValidation="false" ToolTip="إعادة تعيين" aria-label="إعادة تعيين" data-bs-toggle="tooltip"><i class="fa-solid fa-rotate-left" aria-hidden="true"></i></asp:LinkButton></div></asp:Panel>
      </div>
      <asp:Panel ID="pnlTableActions" runat="server" CssClass="type-flex type-toolbar-controls align-items-center" ClientIDMode="Static">
        <asp:LinkButton ID="btnNewRecord" runat="server" CssClass="btn btn-primary" OnClick="NewRecord_Click" CausesValidation="false"><i class="fa-solid fa-plus me-2" aria-hidden="true"></i>إضافة جهة اتصال</asp:LinkButton>
      </asp:Panel>
      <div class="card-datatable table-responsive">
        <table id="ERPTable" data-enhanced="1" class="ERP_ProstoTBL card-list-table table border-top crm-table"><thead><tr><th>الرقم</th><th>الاسم</th><th>العميل</th><th>المسمى الوظيفي</th><th>الهاتف</th><th>البريد الإلكتروني</th><th>الحالة</th><th data-orderable="false">الإجراءات</th></tr></thead><tbody><asp:ListView ID="lstData" runat="server" DataKeyNames="ID,Row_Version" OnItemCommand="Inline_RowCommand"><LayoutTemplate><asp:PlaceHolder ID="itemPlaceholder" runat="server" /></LayoutTemplate><ItemTemplate><tr><td data-title="الرقم"><%#: Eval("ID") %></td><td data-title="الاسم"><div class="type-flex align-items-center gap-3"><span class="type-record-icon badge bg-label-primary rounded"><i class="bx bx-user fs-4" aria-hidden="true"></i></span><span class="type-record-name fw-semibold"><%#: Eval("Name_AR") %><small class="d-block text-muted" dir="ltr"><%#: Eval("Name_EN") %></small></span></div></td><td data-title="العميل"><%#: Eval("Account_Name") %></td><td data-title="المسمى الوظيفي"><div><%#: Eval("Job_Title") %></div><small class="d-block text-muted" dir="ltr"><%#: Eval("Job_Title_EN") %></small></td><td data-title="الهاتف"><%#: Eval("Phone") %></td><td data-title="البريد الإلكتروني"><%#: Eval("Email") %></td><td data-title="الحالة"><span class='<%# If(Convert.ToBoolean(Eval("Is_Active")), "badge bg-label-success", "badge bg-label-secondary") %>'><%#: If(Convert.ToBoolean(Eval("Is_Active")), "فعال", "موقوف") %></span></td><td data-title="الإجراءات"><div class="type-flex type-row-actions">
<asp:LinkButton runat="server" CssClass="btn btn-sm btn-icon type-row-action text-secondary" CommandName="EditRecord" CommandArgument='<%# Eval("ID") %>' ToolTip="تعديل" aria-label="تعديل" data-bs-toggle="tooltip" CausesValidation="false"><i class="fa-solid fa-pen-to-square" aria-hidden="true"></i></asp:LinkButton>
<asp:LinkButton runat="server" CssClass="btn btn-sm btn-icon type-row-action text-warning" CommandName="Deactivate" CommandArgument='<%# Eval("ID") %>' Visible='<%# Convert.ToBoolean(Eval("Is_Active")) %>' ToolTip="إيقاف" aria-label="إيقاف" data-bs-toggle="tooltip" CausesValidation="false"><i class="fa-solid fa-pause" aria-hidden="true"></i></asp:LinkButton>
<asp:LinkButton runat="server" CssClass="btn btn-sm btn-icon type-row-action text-success" CommandName="Activate" CommandArgument='<%# Eval("ID") %>' Visible='<%# Not Convert.ToBoolean(Eval("Is_Active")) %>' ToolTip="تفعيل" aria-label="تفعيل" data-bs-toggle="tooltip" CausesValidation="false"><i class="fa-solid fa-play" aria-hidden="true"></i></asp:LinkButton>
<asp:LinkButton runat="server" CssClass="btn btn-sm btn-icon type-row-action text-danger" CommandName="AskDelete" CommandArgument='<%# Eval("ID") %>' ToolTip="حذف" aria-label="حذف" data-bs-toggle="tooltip" CausesValidation="false"><i class="fa-solid fa-trash-can" aria-hidden="true"></i></asp:LinkButton>
</div></td></tr></ItemTemplate></asp:ListView></tbody></table>
      </div>
    </div>
    <div class="modal fade" id="crmDeleteModal" tabindex="-1" aria-labelledby="crmDeleteTitle" aria-hidden="true">
      <div class="modal-dialog modal-dialog-centered"><div class="modal-content">
        <div class="modal-header"><h2 class="modal-title h5" id="crmDeleteTitle">حذف جهة اتصال</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="إغلاق"></button></div>
        <div class="modal-body"><p class="mb-0">هل تريد حذف جهة اتصال «<strong><asp:Literal ID="litDeleteName" runat="server" Mode="Encode" /></strong>»؟</p></div>
        <div class="modal-footer"><button type="button" class="btn btn-label-secondary" data-bs-dismiss="modal">إلغاء</button><asp:LinkButton ID="btnConfirmDelete" runat="server" CssClass="btn btn-danger" CausesValidation="false" OnClick="ConfirmDelete_Click"><i class="fa-solid fa-trash-can me-2" aria-hidden="true"></i>تأكيد الحذف</asp:LinkButton></div>
      </div></div>
    </div>
<div class="offcanvas offcanvas-end type-editor crm-editor-wide" tabindex="-1" id="crmEditor" aria-labelledby="crmEditorTitle"><div class="offcanvas-header border-bottom"><h2 class="offcanvas-title h5" id="crmEditorTitle"><asp:Literal ID="litEditorTitle" runat="server" Text="إضافة جهة اتصال" /></h2><button type="button" class="btn-close text-reset" data-bs-dismiss="offcanvas" aria-label="إغلاق"></button></div><div class="offcanvas-body"><asp:Panel ID="pnlEditor" runat="server" DefaultButton="btnSaveRecord"><asp:Literal ID="litEditorMessage" runat="server" EnableViewState="false" /><asp:ValidationSummary runat="server" ValidationGroup="CRMEditor" CssClass="alert alert-danger" HeaderText="يرجى مراجعة البيانات التالية:" /><section class="crm-form-section"><h6 class="crm-section-title">بيانات جهة الاتصال</h6><div class="row g-3"><div class="col-12 col-md-6"><asp:Label runat="server" AssociatedControlID="f_Account_ID" CssClass="form-label" Text="العميل" /><asp:DropDownList ID="f_Account_ID" runat="server" CssClass="form-select" /><asp:RequiredFieldValidator runat="server" ControlToValidate="f_Account_ID" ValidationGroup="CRMEditor" ErrorMessage="اختر العميل." CssClass="text-danger small" Display="Dynamic" /></div><div class="col-12 col-md-6"><asp:Label runat="server" AssociatedControlID="f_Name_AR" CssClass="form-label" Text="الاسم بالعربية" /><asp:TextBox ID="f_Name_AR" runat="server" CssClass="form-control" MaxLength="200" /><asp:RequiredFieldValidator runat="server" ControlToValidate="f_Name_AR" ValidationGroup="CRMEditor" ErrorMessage="أدخل الاسم." CssClass="text-danger small" Display="Dynamic" /></div><div class="col-12 col-md-6"><asp:Label runat="server" AssociatedControlID="f_Name_EN" CssClass="form-label" Text="الاسم بالإنجليزية" /><asp:TextBox ID="f_Name_EN" runat="server" CssClass="form-control" MaxLength="200" dir="ltr" /><asp:RequiredFieldValidator runat="server" ControlToValidate="f_Name_EN" ValidationGroup="CRMEditor" ErrorMessage="أدخل الاسم الإنجليزي لجهة الاتصال." CssClass="text-danger small" Display="Dynamic" /></div><div class="col-12 col-md-6"><asp:Label runat="server" AssociatedControlID="f_Job_Title" CssClass="form-label" Text="المسمى الوظيفي بالعربية" /><asp:TextBox ID="f_Job_Title" runat="server" CssClass="form-control" MaxLength="200" /><asp:RequiredFieldValidator runat="server" ControlToValidate="f_Job_Title" ValidationGroup="CRMEditor" ErrorMessage="أدخل المسمى الوظيفي بالعربية." CssClass="text-danger small" Display="Dynamic" /></div><div class="col-12 col-md-6"><asp:Label runat="server" AssociatedControlID="f_Job_Title_EN" CssClass="form-label" Text="المسمى الوظيفي بالإنجليزية" /><asp:TextBox ID="f_Job_Title_EN" runat="server" CssClass="form-control" MaxLength="200" dir="ltr" /><asp:RequiredFieldValidator runat="server" ControlToValidate="f_Job_Title_EN" ValidationGroup="CRMEditor" ErrorMessage="أدخل المسمى الوظيفي بالإنجليزية." CssClass="text-danger small" Display="Dynamic" /></div><div class="col-12 col-md-6"><asp:Label runat="server" AssociatedControlID="f_Gender" CssClass="form-label" Text="الجنس" /><asp:DropDownList ID="f_Gender" runat="server" CssClass="form-select"><asp:ListItem Value="" Text="— اختر —" /><asp:ListItem Value="M" Text="ذكر" /><asp:ListItem Value="F" Text="أنثى" /></asp:DropDownList></div></div></section><section class="crm-form-section"><h6 class="crm-section-title">بيانات التواصل</h6><div class="row g-3"><div class="col-12 col-md-6"><asp:Label runat="server" AssociatedControlID="f_Phone" CssClass="form-label" Text="الهاتف" /><asp:TextBox ID="f_Phone" runat="server" CssClass="form-control" MaxLength="50" dir="ltr" /></div><div class="col-12 col-md-6"><asp:Label runat="server" AssociatedControlID="f_Email" CssClass="form-label" Text="البريد الإلكتروني" /><asp:TextBox ID="f_Email" runat="server" CssClass="form-control" MaxLength="254" TextMode="Email" dir="ltr" /></div></div></section><section class="crm-form-section"><h6 class="crm-section-title">ملاحظات وحالة جهة الاتصال</h6><div class="row g-3"><div class="col-12"><asp:Label runat="server" AssociatedControlID="f_Notes" CssClass="form-label" Text="ملاحظات" /><asp:TextBox ID="f_Notes" runat="server" CssClass="form-control" MaxLength="2000" TextMode="MultiLine" Rows="3" /></div></div></section><div class="mb-4"><asp:CheckBox ID="chkIsActive" runat="server" Text=" فعال" Checked="true" /></div><div class="type-flex flex-wrap gap-2"><asp:LinkButton ID="btnSaveRecord" runat="server" CssClass="btn btn-primary" OnClick="SaveRecord_Click" ValidationGroup="CRMEditor" Text="حفظ" /><button type="button" class="btn btn-label-secondary" data-bs-dismiss="offcanvas">إلغاء</button></div></asp:Panel></div></div>
  </asp:Panel>
</div>
<script src="/assets/js/crm-list.js?v=20261021suppliers"></script>
</asp:Content>
