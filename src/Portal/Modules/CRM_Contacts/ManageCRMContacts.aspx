<%@ Page Title="جهات الاتصال" Language="vb" AutoEventWireup="false" MasterPageFile="~/Site.Master" CodeBehind="ManageCRMContacts.aspx.vb" Inherits="CRM.ManageCRMContacts" %>
<asp:Content ID="head" ContentPlaceHolderID="HeadContent" runat="server"><link rel="stylesheet" href="/assets/vendor/libs/datatables-bs5/datatables.bootstrap5.css" /><link rel="stylesheet" href="/assets/css/crm.css?v=20260913c" /></asp:Content>
<asp:Content ID="body" ContentPlaceHolderID="ContentPlaceHolder1" runat="server">
<div class="container-xxl flex-grow-1 container-p-y crm-shell" dir="rtl"><div class="card mb-4">
<div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2"><h5 class="card-title mb-0">جهات الاتصال</h5>
<a class="btn btn-primary" href="AddCRMContacts.aspx"><i class="bx bx-plus me-2"></i>إضافة جديد</a></div><div class="card-body"><asp:Literal ID="litMessage" runat="server" /><asp:Panel ID="pnlBody" runat="server">
<asp:Panel ID="pnlSearch" runat="server" DefaultButton="btnSearch" CssClass="row g-3 mb-4"><div class="col-12 col-md-6 col-xl-3"><asp:Label runat="server" AssociatedControlID="filterAccount" CssClass="form-label" Text="العميل" /><asp:DropDownList ID="filterAccount" runat="server" CssClass="form-select" /></div><div class="col-12 col-md-6 col-xl-3"><asp:Label runat="server" AssociatedControlID="filterName" CssClass="form-label" Text="الاسم" /><asp:TextBox ID="filterName" runat="server" CssClass="form-control" MaxLength="200" /></div><div class="col-12 col-md-6 col-xl-3"><asp:Label runat="server" AssociatedControlID="filterEmail" CssClass="form-label" Text="البريد الإلكتروني" /><asp:TextBox ID="filterEmail" runat="server" CssClass="form-control" MaxLength="200" /></div><div class="col-12 col-md-6 col-xl-3"><asp:Label runat="server" AssociatedControlID="filterJob" CssClass="form-label" Text="المسمى الوظيفي" /><asp:TextBox ID="filterJob" runat="server" CssClass="form-control" MaxLength="200" /></div><div class="col-12 col-md-6 col-xl-3"><asp:Label runat="server" AssociatedControlID="filterStatus" CssClass="form-label" Text="الحالة" /><asp:DropDownList ID="filterStatus" runat="server" CssClass="form-select"><asp:ListItem Value="" Text="الكل" /><asp:ListItem Value="1" Text="فعال" /><asp:ListItem Value="0" Text="موقوف" /></asp:DropDownList></div><div class="col-12 col-md-auto d-flex gap-2 align-items-end"><asp:LinkButton ID="btnSearch" runat="server" CssClass="btn btn-primary" Text="بحث" OnClick="Search_Click" /><a class="btn btn-outline-secondary" href="ManageCRMContacts.aspx">إعادة تعيين</a></div></asp:Panel><div class="table-responsive"><table id="ERPTable" data-enhanced="1" class="ERP_ProstoTBL card-list-table table table-bordered crm-table"><thead><tr><th>الرقم</th><th>الاسم</th><th>العميل</th><th>المسمى الوظيفي</th><th>الهاتف</th><th>البريد الإلكتروني</th><th>الحالة</th><th data-orderable="false">الإجراءات</th></tr></thead><tbody><asp:ListView ID="lstData" runat="server" DataKeyNames="ID,Row_Version" OnItemCommand="Row_Command"><LayoutTemplate><asp:PlaceHolder ID="itemPlaceholder" runat="server" /></LayoutTemplate><ItemTemplate><tr><td data-title="الرقم"><%#: Eval("ID")%></td><td data-title="الاسم"><%#: Eval("Name_AR")%></td><td data-title="العميل"><%#: Eval("Account_Name")%></td><td data-title="المسمى الوظيفي"><%#: Eval("Job_Title")%></td><td data-title="الهاتف"><%#: Eval("Phone")%></td><td data-title="البريد الإلكتروني"><%#: Eval("Email")%></td><td data-title="الحالة"><%#: If(Convert.ToBoolean(Eval("Is_Active")), "فعال", "موقوف")%></td><td data-title="الإجراءات"><div class="d-flex flex-wrap gap-2"><asp:HyperLink runat="server" CssClass="btn btn-sm btn-label-secondary" Text="تعديل" NavigateUrl='<%# "EditCRMContacts.aspx?id=" & Convert.ToString(Eval("ID"))%>' /><asp:LinkButton runat="server" CssClass="btn btn-sm btn-label-warning" CommandName="Deactivate" CommandArgument='<%# Eval("ID")%>' Visible='<%# Convert.ToBoolean(Eval("Is_Active"))%>' Text="إيقاف" CausesValidation="false" />
<asp:LinkButton runat="server" CssClass="btn btn-sm btn-label-success" CommandName="Activate" CommandArgument='<%# Eval("ID")%>' Visible='<%# Not Convert.ToBoolean(Eval("Is_Active"))%>' Text="تفعيل" CausesValidation="false" />
<asp:LinkButton runat="server" CssClass="btn btn-sm btn-label-danger" CommandName="DeleteItem" CommandArgument='<%# Eval("ID")%>' Text="حذف" CausesValidation="false" OnClientClick="return confirm('هل تريد حذف هذا العنصر؟');" /></div></td></tr></ItemTemplate></asp:ListView></tbody></table></div></asp:Panel></div></div></div><script src="/assets/js/crm.js?v=20260913c"></script></asp:Content>
