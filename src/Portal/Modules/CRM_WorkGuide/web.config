<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Allow multipart overhead; the application validates each document at 10 MiB. -->
  <system.web><httpRuntime maxRequestLength="12288" executionTimeout="120" /></system.web>
  <system.webServer><security><requestFiltering><requestLimits maxAllowedContentLength="12582912" /></requestFiltering></security></system.webServer>
</configuration>
