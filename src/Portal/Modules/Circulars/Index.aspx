<%@ Page Title="التعاميم" Language="vb" AutoEventWireup="false" MasterPageFile="~/Site.Master" CodeBehind="Index.aspx.vb" Inherits="CRM.CircularsIndex" %>
<%@ Register Src="~/Controls/CircularReader.ascx" TagPrefix="uc" TagName="CircularReader" %>
<asp:Content ID="Head" ContentPlaceHolderID="HeadContent" runat="server"><link rel="stylesheet" href="/assets/vendor/fonts/fontawesome.css"/><link rel="stylesheet" href="/assets/vendor/libs/datatables-bs5/datatables.bootstrap5.css"/><link rel="stylesheet" href="/assets/css/crm.css"/><link rel="stylesheet" href="/assets/css/crm-list.css"/></asp:Content>
<asp:Content ID="Main" ContentPlaceHolderID="ContentPlaceHolder1" runat="server">
<div class="container-xxl container-p-y circulars crm-types">
 <div class="type-page-header type-flex align-items-center justify-content-between"><h1 class="h4 mb-0">التعاميم</h1><nav aria-label="مسار التنقل"><ol class="breadcrumb mb-0"><li class="breadcrumb-item"><a href="/Index.aspx">الرئيسية</a></li><li class="breadcrumb-item active">التعاميم</li></ol></nav></div>
 <asp:Literal ID="litMessage" runat="server"/><asp:Literal ID="litStats" runat="server"/>
 <div class="card mb-4"><div class="card-header type-filter-header"><h2 class="h5 card-title">البحث في التعاميم</h2><asp:Panel runat="server" DefaultButton="btnSearch" CssClass="row g-3 align-items-center"><div class="col-12 col-md-7"><div class="input-group input-group-merge"><span class="input-group-text"><i class="bx bx-search" aria-hidden="true"></i></span><asp:TextBox ID="txtSearch" runat="server" MaxLength="250" CssClass="form-control" placeholder="بحث بالعنوان أو الملخص بالعربية والإنجليزية..." aria-label="بحث في التعاميم"/></div></div><div class="col-12 col-md-3"><asp:CheckBox ID="chkUnread" runat="server" Text=" غير المقروءة فقط" AutoPostBack="true" OnCheckedChanged="Search" data-circular-unread-filter="1"/></div><div class="col-12 col-md-2"><asp:LinkButton ID="btnSearch" runat="server" OnClick="Search" CssClass="btn btn-primary w-100"><i class="fa-solid fa-magnifying-glass me-2" aria-hidden="true"></i>بحث</asp:LinkButton></div></asp:Panel></div>
 <div class="card-datatable table-responsive"><table id="employeeCircularTable" data-enhanced="1" data-circular-employee-table="1" class="ERP_ProstoTBL card-list-table table border-top crm-table employee-circular-table"><thead><tr><th>الرقم</th><th>التعميم</th><th>تاريخ التعميم</th><th>الملخص</th><th>فترة الإتاحة</th><th>الاطلاع</th><th>التحميل</th><th data-orderable="false">الإجراءات</th></tr></thead><tbody><asp:ListView ID="lstCirculars" runat="server"><LayoutTemplate><asp:PlaceHolder ID="itemPlaceholder" runat="server"/></LayoutTemplate><ItemTemplate>
 <tr data-circular-row="1" data-circular-id='<%# Eval("ID") %>' data-circular-version='<%# Eval("Version") %>' data-read='<%# If(CBool(Eval("IsRead")),"1","0") %>'><td data-title="الرقم"><%#: Eval("ID") %></td><td data-title="التعميم" class="circular-title"><span class="fw-semibold"><%#: Eval("Title") %></span><small class="d-block text-muted" dir="ltr"><%#: Eval("Title_EN") %></small></td><td data-title="تاريخ التعميم"><bdi><%# CDate(Eval("CircularDate")).ToString("yyyy/MM/dd") %></bdi></td><td data-title="الملخص" class="circular-summary"><span><%#: Eval("Summary") %></span></td><td data-title="فترة الإتاحة" class="circular-period"><%# PeriodSummary(Container.DataItem) %></td><td data-title="الاطلاع"><span data-read-badge class='<%# If(CBool(Eval("IsRead")),"badge bg-label-success","badge bg-label-warning") %>'><%# If(CBool(Eval("IsRead")),"مقروء","غير مقروء") %></span></td><td data-title="التحميل"><span class='<%# If(CBool(Eval("AllowDownload")),"badge bg-label-primary","badge bg-label-secondary") %>'><%# If(CBool(Eval("AllowDownload")),"مسموح","مشاهدة فقط") %></span></td><td data-title="الإجراءات"><div class="type-flex type-row-actions"><button type="button" class="btn btn-sm btn-icon type-row-action text-primary" data-circular-open="1" data-circular-id='<%# Eval("ID") %>' title="عرض التعميم" aria-label="عرض التعميم" data-bs-toggle="tooltip"><i class="fa-solid fa-eye" aria-hidden="true"></i></button></div></td></tr>
 </ItemTemplate></asp:ListView></tbody></table></div>
 <div class="type-flex justify-content-between align-items-center flex-wrap gap-2 border-top p-3"><asp:Literal ID="litPaging" runat="server"/><div class="type-flex gap-2"><asp:LinkButton ID="btnPrev" runat="server" CssClass="btn btn-sm btn-label-secondary" OnClick="Previous">السابق</asp:LinkButton><asp:LinkButton ID="btnNext" runat="server" CssClass="btn btn-sm btn-label-secondary" OnClick="NextPage">التالي</asp:LinkButton></div></div>
 </div>
</div>
<script src="/assets/vendor/libs/datatables/jquery.dataTables.js"></script><script src="/assets/vendor/libs/datatables-bs5/datatables-bootstrap5.js"></script>
<uc:CircularReader ID="employeeCircularReader" runat="server" Mode="employee"/>
</asp:Content>
