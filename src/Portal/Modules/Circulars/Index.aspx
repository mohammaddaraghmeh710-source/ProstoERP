<%@ Page Title="تعاميم" Language="vb" AutoEventWireup="false" MasterPageFile="~/Site.Master" CodeBehind="Index.aspx.vb" Inherits="CRM.CircularsIndex" %>
<asp:Content ID="Head" ContentPlaceHolderID="HeadContent" runat="server"><link rel="stylesheet" href="/assets/css/circulars.css?v=20260924d" /></asp:Content>
<asp:Content ID="Main" ContentPlaceHolderID="ContentPlaceHolder1" runat="server">
<div class="container-xxl flex-grow-1 container-p-y circulars">
 <div class="d-flex align-items-center justify-content-between gap-2 flex-wrap mb-3">
  <div class="d-flex align-items-center gap-3"><span class="avatar avatar-md"><span class="avatar-initial rounded bg-label-primary"><i class="bx bx-broadcast fs-3"></i></span></span><div><h4 class="mb-1">تعاميم</h4><span class="text-muted small"><%=If(AdminMode, "نشر التعاميم وإدارة المستهدفين ومتابعة الاطلاع", "اطّلع على آخر التعاميم والملفات المنشورة")%></span></div></div>
  <% If IsAdministrator Then%><div class="d-flex gap-2"><a class="btn btn-label-secondary" href='<%=If(AdminMode, "Index.aspx", "Index.aspx?admin=1")%>'><i class="bx bx-slider-alt me-1"></i><%=If(AdminMode, "تعاميم", "إدارة التعاميم")%></a><a class="btn btn-primary" href="Index.aspx?admin=1&amp;new=1"><i class="bx bx-plus me-1"></i>تعميم جديد</a></div><% End If%>
 </div>
 <asp:Literal ID="litMessage" runat="server" /><asp:Literal ID="litStats" runat="server" />
 <div class="card mb-4"><div class="card-body py-3"><div class="row g-3 align-items-center"><div class="col-md-8"><asp:Label runat="server" AssociatedControlID="txtSearch" Text="البحث في التعاميم" CssClass="visually-hidden" /><div class="input-group input-group-merge"><span class="input-group-text"><i class="bx bx-search"></i></span><asp:TextBox ID="txtSearch" runat="server" MaxLength="250" CssClass="form-control" placeholder="ابحث بالعنوان أو الملخص..." /><asp:LinkButton ID="btnSearch" runat="server" OnClick="Search" CssClass="btn btn-primary">بحث</asp:LinkButton></div></div><div class="col-md-4 text-md-end"><asp:CheckBox ID="chkUnread" runat="server" Text=" غير المقروءة فقط" AutoPostBack="true" OnCheckedChanged="Search" /></div></div></div></div>
 <asp:ListView ID="lstCirculars" runat="server"><LayoutTemplate><div class="row g-4"><asp:PlaceHolder ID="itemPlaceholder" runat="server" /></div></LayoutTemplate><ItemTemplate>
  <div class="col-md-6 col-xl-4"><article class="card circular-file-card h-100" data-circular-id='<%# Eval("ID")%>'>
   <div class="card-header pb-2"><div class="d-flex align-items-start gap-3"><span class="circular-file-icon"><i class="bx bxs-file-pdf"></i></span><div class="flex-grow-1 min-w-0"><h5 class="mb-2 circular-card-title"><%#: Eval("Title")%></h5><div class="d-flex gap-2 flex-wrap"><span class='<%# If(CBool(Eval("IsRead")), "badge bg-label-secondary", "badge bg-label-warning")%>' data-read-badge><%# If(CBool(Eval("IsRead")), "مقروء", "غير مقروء")%></span><% If AdminMode Then%><span class="badge bg-label-primary"><%# NameOfState(Eval("Status"))%></span><% End If%></div></div></div></div>
   <div class="card-body pt-2"><p class="circular-card-summary mb-3"><%#: Eval("Summary")%></p><div class="bg-lighter rounded p-3 small"><div class="d-flex justify-content-between gap-2 mb-2"><span class="text-muted"><i class="bx bx-calendar me-1"></i>تاريخ التعميم</span><span><%# CDate(Eval("CircularDate")).ToString("yyyy/MM/dd")%></span></div><div class="d-flex justify-content-between gap-2 mb-1"><span class="text-muted">بداية الصلاحية</span><bdi><%# Stamp(Eval("StartUtc"))%></bdi></div><div class="d-flex justify-content-between gap-2"><span class="text-muted">نهاية الصلاحية</span><bdi><%# Stamp(Eval("EndUtc"))%></bdi></div></div><div class="d-flex align-items-center gap-2 small text-muted mt-3"><i class='bx <%# If(CBool(Eval("AllowDownload")), "bx-download", "bx-lock-alt")%>'></i><span><%# If(CBool(Eval("AllowDownload")), "متاح للمشاهدة والتنزيل", "متاح للمشاهدة")%></span><span class="ms-auto">PDF · <%# (CInt(Eval("FileSizeBytes"))/1024.0).ToString("N0")%> KB</span></div></div>
   <div class="card-footer border-top py-3"><div class="d-flex gap-2"><a class="btn btn-primary flex-grow-1" href='<%# CardUrl(Eval("ID"), "view")%>'><i class="bx bx-show me-1"></i>معاينة الملف</a><asp:PlaceHolder runat="server" Visible='<%# CBool(Eval("AllowDownload"))%>'><a class="btn btn-label-primary" href='<%# CardUrl(Eval("ID"), "download")%>' aria-label="تنزيل الملف"><i class="bx bx-download"></i></a></asp:PlaceHolder><%                           If AdminMode Then%><div class="dropdown"><button type="button" class="btn btn-label-secondary px-2" data-bs-toggle="dropdown" aria-expanded="false" aria-label="إدارة التعميم"><i class="bx bx-dots-vertical-rounded"></i></button><ul class="dropdown-menu dropdown-menu-end"><li><a class="dropdown-item" href='<%# CardUrl(Eval("ID"), "edit")%>'><i class="bx bx-edit-alt me-2"></i>تعديل التعميم</a></li><li><a class="dropdown-item" href='<%# CardUrl(Eval("ID"), "logs")%>'><i class="bx bx-history me-2"></i>سجل الاطلاع والعمليات</a></li></ul></div><% End If%></div></div>
  </article></div>
 </ItemTemplate><EmptyDataTemplate><div class="card"><div class="card-body text-center py-5"><span class="avatar avatar-lg mx-auto mb-3"><span class="avatar-initial rounded bg-label-primary"><i class="bx bx-broadcast fs-1"></i></span></span><h5>لا توجد تعاميم مطابقة</h5><p class="text-muted mb-0">ستظهر التعاميم المتاحة هنا. جرّب تعديل خيارات البحث.</p></div></div></EmptyDataTemplate></asp:ListView>
 <div class="d-flex justify-content-between align-items-center gap-2 mt-4"><asp:Literal ID="litPaging" runat="server" /><div class="d-flex gap-2"><asp:LinkButton ID="btnPrev" runat="server" CssClass="btn btn-sm btn-label-secondary" OnClick="Previous">السابق</asp:LinkButton><asp:LinkButton ID="btnNext" runat="server" CssClass="btn btn-sm btn-label-secondary" OnClick="NextPage">التالي</asp:LinkButton></div></div>
 <asp:Panel ID="pnlContent" runat="server">
 <div class="modal fade circular-workspace" id="circularWorkspace" tabindex="-1" aria-labelledby="workspaceTitle" data-open="true" data-initial-tab='<%=If(IsPostBack, "", If(Request.QueryString("action") = "edit", "editTab", If(Request.QueryString("action") = "logs", "logsTab", "")))%>'><div class="modal-dialog modal-xl modal-dialog-scrollable modal-fullscreen-lg-down"><div class="modal-content"><div class="modal-header border-bottom"><h5 class="modal-title" id="workspaceTitle"><i class="bx bx-broadcast text-primary me-2"></i><%=If(PageID = 0, "تعميم جديد", "تعاميم")%></h5><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="إغلاق"></button></div><div class="modal-body"><div class="pb-0">
  <ul class="nav nav-pills gap-2 flex-wrap mb-3" role="tablist">
   <% If PageID > 0 Then%><li class="nav-item" role="presentation"><button class="nav-link active" type="button" id="detailsTab" data-bs-toggle="tab" data-bs-target="#circularDetails" role="tab" aria-controls="circularDetails" aria-selected="true"><i class="bx bx-file me-1"></i>التعميم والملف</button></li><% End If%>
   <% If AdminMode Then%><li class="nav-item" role="presentation"><button class='nav-link <%=If(PageID = 0, "active", "")%>' type="button" id="editTab" data-bs-toggle="tab" data-bs-target="#circularEdit" role="tab" aria-controls="circularEdit" aria-selected='<%=If(PageID = 0, "true", "false")%>'><i class="bx bx-edit-alt me-1"></i>البيانات والمستهدفون</button></li>
   <%     If PageID > 0 Then%><li class="nav-item" role="presentation"><button class="nav-link" type="button" id="logsTab" data-bs-toggle="tab" data-bs-target="#circularLogs" role="tab" aria-controls="circularLogs" aria-selected="false"><i class="bx bx-history me-1"></i>سجل العمليات والاطلاع</button></li><%     End If%><% End If%>
  </ul>
 </div>
 <div class="tab-content shadow-none pt-0">
  <%  If PageID > 0 Then%><div class="tab-pane fade show active" id="circularDetails" role="tabpanel" aria-labelledby="detailsTab">
   <asp:Literal ID="litDetails" runat="server" />
   <%      If AdminMode Then%><div class="border rounded p-3 mt-3"><h6><i class="bx bx-group text-primary me-1"></i>المستهدفون</h6><asp:Literal ID="litAudience" runat="server" /></div><%      End If%>
   <div id="circularViewer" class="border rounded mt-3" data-initial-action="<%=InitialFileAction%>" data-admin='<%=If(AdminMode, "1", "0")%>' data-file-url='<%="File.aspx?ID=" & PageID.ToString() & If(AdminMode, "&amp;admin=1", "")%>' data-csrf="<%=H(CsrfToken)%>">
    <div class="p-3 d-flex justify-content-between align-items-center gap-2 flex-wrap border-bottom"><div class="d-flex gap-2 align-items-center"><i class="bx bxs-file-pdf text-danger fs-3"></i><div><strong><asp:Literal ID="litFileName" runat="server" /></strong><div class="small text-muted"><asp:Literal ID="litFileInfo" runat="server" /></div></div></div>
     <div class="d-flex gap-2"><button type="button" class="btn btn-primary" id="circularOpen"><i class="bx bx-show me-1"></i>مشاهدة الملف</button><asp:Panel ID="pnlDownload" runat="server"><button type="button" class="btn btn-label-primary" id="circularDownload"><i class="bx bx-download me-1"></i>تنزيل PDF</button></asp:Panel></div>
    </div>
    <div id="circularPdfStatus" class="p-3 text-muted small" role="status">اضغط «مشاهدة الملف» لعرض PDF هنا. <%=If(AdminMode, "تُسجل المعاينة الإدارية دون احتسابها قراءة موظف.", "سيُحدّث التعميم إلى مقروء عند جلب الملف.")%></div>
    <div id="circularPdfControls" class="p-2 d-none align-items-center justify-content-center gap-2 border-bottom"><button type="button" id="pdfPrevious" class="btn btn-sm btn-label-secondary">الصفحة السابقة</button><span id="pdfPageLabel" class="small"></span><button type="button" id="pdfNext" class="btn btn-sm btn-label-secondary">الصفحة التالية</button></div>
    <div class="circular-canvas-wrap"><canvas id="circularPdfCanvas" class="d-none"></canvas></div>
   </div>
  </div><% End If%>
  <asp:PlaceHolder ID="pnlEditor" runat="server">
   <div class='tab-pane fade <%=If(PageID = 0, "show active", "")%>' id="circularEdit" role="tabpanel" aria-labelledby="editTab">
    <div class="row g-3">
     <div class="col-md-8"><asp:Label runat="server" AssociatedControlID="txtTitle" Text="عنوان التعميم" CssClass="form-label" /><asp:TextBox ID="txtTitle" runat="server" MaxLength="250" CssClass="form-control" /></div>
     <div class="col-md-4"><asp:Label runat="server" AssociatedControlID="txtDate" Text="تاريخ التعميم" CssClass="form-label" /><asp:TextBox ID="txtDate" runat="server" TextMode="Date" CssClass="form-control" /></div>
     <div class="col-12"><asp:Label runat="server" AssociatedControlID="txtSummary" Text="ملخص التعميم" CssClass="form-label" /><asp:TextBox ID="txtSummary" runat="server" TextMode="MultiLine" Rows="3" MaxLength="2000" CssClass="form-control" /></div>
     <div class="col-md-6"><asp:Label runat="server" AssociatedControlID="txtStart" Text="بداية الصلاحية — بتوقيت الأردن" CssClass="form-label" /><asp:TextBox ID="txtStart" runat="server" TextMode="DateTimeLocal" CssClass="form-control" /></div>
     <div class="col-md-6"><asp:Label runat="server" AssociatedControlID="txtEnd" Text="نهاية الصلاحية — بتوقيت الأردن" CssClass="form-label" /><asp:TextBox ID="txtEnd" runat="server" TextMode="DateTimeLocal" CssClass="form-control" /></div>
     <div class="col-md-8"><asp:Label runat="server" AssociatedControlID="pdfUpload" Text="ملف PDF" CssClass="form-label" /><asp:FileUpload ID="pdfUpload" runat="server" CssClass="form-control" accept=".pdf,application/pdf" /><div class="form-text">ملف واحد حتى 10MB. عند التعديل، اتركه فارغًا للاحتفاظ بالملف الحالي.</div></div>
     <div class="col-md-4 d-flex flex-column justify-content-center gap-2"><asp:CheckBox ID="chkEnabled" runat="server" Text=" تفعيل التعميم ضمن فترة الصلاحية" Checked="true" /><asp:CheckBox ID="chkDownload" runat="server" Text=" السماح بتنزيل الملف" /></div>
     <div class="col-12"><hr class="my-1" /></div>
     <div class="col-md-5"><asp:Label runat="server" AssociatedControlID="ddlAudience" Text="التعميم موجّه إلى" CssClass="form-label" /><asp:DropDownList ID="ddlAudience" runat="server" CssClass="form-select" data-circular-audience="true"><asp:ListItem Value="all">جميع الموظفين</asp:ListItem><asp:ListItem Value="roles">أنواع مستخدمين محددة</asp:ListItem><asp:ListItem Value="organization">حسب العلامة والفرع والقسم والوردية</asp:ListItem></asp:DropDownList></div>
     <div class="col-12" data-audience-panel="roles"><asp:Label runat="server" AssociatedControlID="roles" Text="أنواع المستخدمين" CssClass="form-label" /><asp:ListBox ID="roles" runat="server" SelectionMode="Multiple" CssClass="form-select circular-select" /></div>
     <div class="col-12" data-audience-panel="organization"><div class="alert alert-info py-2 small">اترك الفلتر فارغًا ليشمل الجميع ضمنه. تُطبّق الفلاتر المختارة معًا، والقيم المتعددة داخل الفلتر بدائل لبعضها. اختر فلترًا واحدًا على الأقل.</div><div class="row g-3">
      <div class="col-md-6"><asp:Label runat="server" AssociatedControlID="brands" Text="العلامات التجارية" CssClass="form-label" /><asp:ListBox ID="brands" runat="server" SelectionMode="Multiple" CssClass="form-select circular-select" /></div>
      <div class="col-md-6"><asp:Label runat="server" AssociatedControlID="branches" Text="الفروع" CssClass="form-label" /><asp:ListBox ID="branches" runat="server" SelectionMode="Multiple" CssClass="form-select circular-select" /></div>
      <div class="col-md-6"><asp:Label runat="server" AssociatedControlID="departments" Text="الأقسام" CssClass="form-label" /><asp:ListBox ID="departments" runat="server" SelectionMode="Multiple" CssClass="form-select circular-select" /></div>
      <div class="col-md-6"><asp:Label runat="server" AssociatedControlID="shifts" Text="الورديات" CssClass="form-label" /><asp:ListBox ID="shifts" runat="server" SelectionMode="Multiple" CssClass="form-select circular-select" /></div>
     </div></div>
     <div class="col-12 d-flex flex-wrap justify-content-between align-items-center gap-2 border-top pt-3 mt-4"><span class="small text-muted">الحفظ ينشئ إصدارًا جديدًا يظهر غير مقروء، وتبقى سجلات الإصدارات السابقة محفوظة.</span><asp:LinkButton ID="btnSave" runat="server" OnClick="Save" CssClass="btn btn-primary"><i class="bx bx-save me-1"></i>حفظ التعميم</asp:LinkButton></div>
    </div>
   </div>
  </asp:PlaceHolder>
  <asp:PlaceHolder ID="pnlLogs" runat="server"><div class="tab-pane fade" id="circularLogs" role="tabpanel" aria-labelledby="logsTab">
   <div class="d-flex justify-content-between gap-2 align-items-center mb-3"><div><h6 class="mb-1">سجل التعميم</h6><small class="text-muted">كل مشاهدة وتنزيل، مع الموظف والمصدر والإصدار والوقت. الأوقات بتوقيت الأردن.</small></div><asp:LinkButton ID="btnRefreshLogs" runat="server" OnClick="RefreshLogs" CssClass="btn btn-sm btn-label-primary"><i class="bx bx-refresh me-1"></i>تحديث</asp:LinkButton></div>
   <asp:Literal ID="litLogs" runat="server" />
   <div class="d-flex justify-content-between align-items-center border-top pt-3"><asp:Literal ID="litLogPaging" runat="server" /><div class="d-flex gap-2"><asp:LinkButton ID="btnLogPrev" runat="server" OnClick="PreviousLogs" CssClass="btn btn-sm btn-label-secondary">السابق</asp:LinkButton><asp:LinkButton ID="btnLogNext" runat="server" OnClick="NextLogs" CssClass="btn btn-sm btn-label-secondary">التالي</asp:LinkButton></div></div>
  </div></asp:PlaceHolder>
 </div></div>
</div></div></div> </asp:Panel>
</div><script src="/assets/js/pdf.min.js"></script><script src="/assets/js/circulars.js?v=20260924d"></script></asp:Content>
