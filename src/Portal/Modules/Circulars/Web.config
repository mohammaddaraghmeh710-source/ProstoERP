<?xml version="1.0" encoding="utf-8"?>
<configuration>
 <system.web><globalization fileEncoding="utf-8" requestEncoding="utf-8" responseEncoding="utf-8" /><httpRuntime maxRequestLength="12288" executionTimeout="120" /></system.web>
 <system.webServer><security><requestFiltering><requestLimits maxAllowedContentLength="12582912" /></requestFiltering></security></system.webServer>
</configuration>
