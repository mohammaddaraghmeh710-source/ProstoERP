<%@ Page Title="المراسلات الرسمية" Language="vb" AutoEventWireup="false" MasterPageFile="~/Site.Master" CodeBehind="ManageCorrespondence.aspx.vb" Inherits="CRM.ManageCorrespondence" ValidateRequest="false" %>
<%@ Register Assembly="AjaxControlToolkit" Namespace="AjaxControlToolkit" TagPrefix="cc1" %>
<%@ Import Namespace="CRM" %>
<asp:Content ID="Head" ContentPlaceHolderID="HeadContent" runat="server" />
<asp:Content ID="Main" ContentPlaceHolderID="ContentPlaceHolder1" runat="server">
<div class="container-xxl flex-grow-1 container-p-y" dir="rtl">
<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-3"><div><h4 class="mb-1"><i class="bx bx-envelope text-primary me-2"></i>مركز المراسلات الرسمية</h4><p class="text-muted mb-0">التواصل والتكليفات ومتابعة المسؤوليات في مكان واحد.</p></div><asp:HyperLink ID="lnkNew" runat="server" NavigateUrl="AddCorrespondence.aspx" CssClass="btn btn-primary"><i class="bx bx-plus me-2"></i>مراسلة جديدة</asp:HyperLink></div>
<div class="alert alert-info py-2"><i class="bx bx-shield-quarter me-2"></i>قناة عمل رسمية تخضع لاطلاع مدير النظام. تُحفظ الرسائل بعد الإرسال، وقراءة الرسالة لا تعني إنجاز التكليف.</div>
<asp:Literal ID="litMessage" runat="server" />
<asp:Panel ID="pnlNavigation" runat="server" CssClass="d-flex flex-row flex-wrap gap-2 mb-3"><a class='btn <%=If(Not Supervisory, "btn-primary", "btn-label-primary")%>' href="ManageCorrespondence.aspx"><i class="bx bx-user me-1"></i>مراسلاتي</a><a class='btn <%=If(Supervisory, "btn-primary", "btn-label-primary")%>' href="ManageCorrespondence.aspx?scope=all"><i class="bx bx-check-shield me-1"></i>جميع المراسلات والتقارير</a><a class="btn btn-label-secondary" href="Catalogs.aspx?kind=P">إدارة الأولويات</a><a class="btn btn-label-secondary" href="Catalogs.aspx?kind=R">إدارة أسباب الإنهاء</a></asp:Panel>
<asp:Panel ID="pnlList" runat="server"><asp:Literal ID="litStatistics" runat="server" />
<section class="card mb-3"><div class="card-header"><h5 class="mb-0">البحث والمتابعة</h5></div><div class="card-body"><asp:Panel ID="pnlSearch" runat="server" DefaultButton="btnSearch" CssClass="row g-3 align-items-end"><div class="col-md-3"><asp:Label runat="server" AssociatedControlID="txtPerson" CssClass="form-label" Text="اسم أحد الأطراف" /><asp:TextBox ID="txtPerson" runat="server" CssClass="form-control" MaxLength="200" /></div><div class="col-md-3"><asp:Label runat="server" AssociatedControlID="txtTitleSearch" CssClass="form-label" Text="عنوان المراسلة" /><asp:TextBox ID="txtTitleSearch" runat="server" CssClass="form-control" MaxLength="200" /></div><div class="col-md-3"><asp:Label runat="server" AssociatedControlID="ddlFilter" CssClass="form-label" Text="الحالة" /><asp:DropDownList ID="ddlFilter" runat="server" CssClass="form-select" ><asp:ListItem Value="all">جميع الحالات</asp:ListItem><asp:ListItem Value="unread">غير مقروءة لي</asp:ListItem><asp:ListItem Value="active">فعالة</asp:ListItem><asp:ListItem Value="noReply">مفتوحة دون رد</asp:ListItem><asp:ListItem Value="overdue">متأخرة</asp:ListItem><asp:ListItem Value="closed">منتهية</asp:ListItem><asp:ListItem Value="archived">مؤرشفة إداريًا</asp:ListItem><asp:ListItem Value="followup">تحتاج متابعة حساب معطل</asp:ListItem><asp:ListItem Value="legacy">سابقة لحفظ التبعية</asp:ListItem></asp:DropDownList></div><div class="col-md-3"><asp:Label runat="server" AssociatedControlID="ddlKind" CssClass="form-label" Text="النوع" /><asp:DropDownList ID="ddlKind" runat="server" CssClass="form-select" ><asp:ListItem Value="0">جميع الأنواع</asp:ListItem><asp:ListItem Value="1">مراسلة عادية</asp:ListItem><asp:ListItem Value="2">تكليف</asp:ListItem></asp:DropDownList></div><div class="col-md-3"><asp:Label runat="server" AssociatedControlID="ddlPriority" CssClass="form-label" Text="الأولوية" /><asp:DropDownList ID="ddlPriority" runat="server" CssClass="form-select" ></asp:DropDownList></div><div class="col-md-3"><asp:Label runat="server" AssociatedControlID="txtFrom" CssClass="form-label" Text="من تاريخ الإنشاء" /><asp:TextBox ID="txtFrom" runat="server" CssClass="form-control" TextMode="Date" /></div><div class="col-md-3"><asp:Label runat="server" AssociatedControlID="txtTo" CssClass="form-label" Text="إلى تاريخ الإنشاء" /><asp:TextBox ID="txtTo" runat="server" CssClass="form-control" TextMode="Date" /></div><div class="col-md-3"><asp:Button ID="btnSearch" runat="server" Text="عرض النتائج" CssClass="btn btn-primary w-100" OnClick="Search_Click" /></div></asp:Panel><asp:Panel ID="pnlAdminFilters" runat="server" CssClass="row g-3 mt-1"><div class="col-md-3"><asp:Label runat="server" AssociatedControlID="ddlBrand" CssClass="form-label" Text="العلامة وقت الإنشاء" /><asp:DropDownList ID="ddlBrand" runat="server" CssClass="form-select" AutoPostBack="true" OnSelectedIndexChanged="Brand_Changed"><asp:ListItem Value="0">جميع العلامات</asp:ListItem></asp:DropDownList></div><div class="col-md-3"><asp:Label runat="server" AssociatedControlID="ddlBranch" CssClass="form-label" Text="الفرع وقت الإنشاء" /><asp:DropDownList ID="ddlBranch" runat="server" CssClass="form-select" ><asp:ListItem Value="0">جميع الفروع</asp:ListItem></asp:DropDownList></div><div class="col-md-3"><asp:Label runat="server" AssociatedControlID="txtSender" CssClass="form-label" Text="المرسل" /><asp:TextBox ID="txtSender" runat="server" CssClass="form-control" MaxLength="200" /></div><div class="col-md-3"><asp:Label runat="server" AssociatedControlID="txtReceiver" CssClass="form-label" Text="المستلم" /><asp:TextBox ID="txtReceiver" runat="server" CssClass="form-control" MaxLength="200" /></div></asp:Panel></div></section>
<asp:Panel ID="pnlReport" runat="server" CssClass="card mb-3"><div class="card-header"><h5 class="mb-1">تقرير المتابعة حسب جهة المستلم وقت الإنشاء</h5><p class="text-muted small mb-0">التقرير يتبع الفلاتر أعلاه. متوسط أول رد يحسب للمراسلات التي تلقت ردًا فقط. المراسلات القديمة ذات التبعية غير المحفوظة تظهر منفصلة.</p></div><div class="table-responsive"><table class="table table-sm"><thead><tr><th>العلامة / الفرع</th><th>العدد</th><th>دون رد</th><th>تكليفات متأخرة</th><th>تم الإنجاز</th><th>لم ينجز</th><th>أرشفة إدارية</th><th>متوسط أول رد</th></tr></thead><tbody><asp:Repeater ID="rptReport" runat="server"><ItemTemplate><tr><td><%#: Eval("Organization")%></td><td><%#: Eval("Count")%></td><td><%#: Eval("NoReply")%></td><td><%#: Eval("Overdue")%></td><td><%#: Eval("Completed")%></td><td><%#: Eval("NotCompleted")%></td><td><%#: Eval("Archived")%></td><td><%#: Eval("AverageReply")%></td></tr></ItemTemplate></asp:Repeater></tbody></table></div></asp:Panel>
<section class="card"><div class="card-header"><h5 class="mb-0">المراسلات</h5></div><div class="card-body"><table id="ERPTable" class="ERP_ProstoTBL card-list-table table table-bordered table-sm"><thead><tr><th>المراسلة</th><th>النوع والأولوية</th><th>الحالة</th><th>آخر تفاعل</th><th>عرض</th></tr></thead><tbody><asp:ListView ID="lstThreads" runat="server"><LayoutTemplate><asp:PlaceHolder ID="itemPlaceholder" runat="server" /></LayoutTemplate><ItemTemplate><tr>
<td data-title="المراسلة"><div class="d-flex align-items-start gap-2"><div class="avatar avatar-sm flex-shrink-0"><img class="rounded-circle" src='<%#: CorrespondenceData.Avatar(Eval("OtherImage"))%>' alt="" /></div><div><a class="fw-semibold" href='<%# ThreadLink(Eval("ID"))%>'><%#: Eval("Title")%></a><div class="small text-muted"><%#: Eval("OtherName")%></div><div class="small text-muted">#<%#: Eval("ID")%> · <%#: Eval("MessageCount")%> رسائل</div><asp:Label runat="server" CssClass="badge bg-label-warning" Visible='<%# CInt(Eval("UnreadCount")) > 0%>' Text="غير مقروءة" /></div></div></td>
<td data-title="النوع والأولوية"><span class="badge bg-label-primary mb-1"><%#: CorrespondenceData.KindText(Eval("RequiresCompletion"))%></span><br /><span class='<%# If(CBool(Eval("PriorityUrgent")), "badge bg-label-danger", "badge bg-label-secondary")%>'><%#: Eval("PriorityName")%></span></td>
<td data-title="الحالة"><span class='<%# "badge " & CorrespondenceData.StateCss(Eval("State"))%>'><%#: CorrespondenceData.StateText(Eval("State"))%></span></td><td data-title="آخر تفاعل"><%#: CorrespondenceData.DisplayDate(Eval("LastMessageDate"))%></td><td data-title="عرض"><a class="btn btn-sm btn-label-primary" href='<%# ThreadLink(Eval("ID"))%>'>فتح</a></td>
</tr></ItemTemplate><EmptyDataTemplate><tr><td colspan="5" class="text-center py-5 text-muted"><i class="bx bx-envelope d-block fs-1 mb-2"></i>لا توجد مراسلات مطابقة للفلاتر.</td></tr></EmptyDataTemplate></asp:ListView></tbody></table></div></section></asp:Panel>
<asp:Panel ID="pnlConversation" runat="server" Visible="false"><asp:HyperLink ID="lnkBack" runat="server" CssClass="btn btn-sm btn-label-secondary mb-3">العودة إلى القائمة</asp:HyperLink><asp:HiddenField ID="hfVisible" runat="server" ClientIDMode="Static" Value="1" />
<div class="row g-3"><div class="col-lg-8"><asp:UpdatePanel ID="upConversation" runat="server" UpdateMode="Conditional" ChildrenAsTriggers="false"><ContentTemplate>
<div class="card mb-3"><div class="card-header border-bottom d-flex flex-wrap align-items-center justify-content-between gap-2"><div class="d-flex align-items-center gap-2"><div class="avatar"><asp:Image ID="imgOther" runat="server" CssClass="rounded-circle" AlternateText="صورة الطرف الآخر" /></div><div><strong><asp:Literal ID="litOtherName" runat="server" Mode="Encode" /></strong><div class="small text-muted">مراسلة رقم <asp:Literal ID="litThreadID" runat="server" Mode="Encode" /></div></div></div><asp:Label ID="lblState" runat="server" /></div><div class="card-body pt-3"><h5><asp:Literal ID="litTitle" runat="server" Mode="Encode" /></h5><p class="text-muted text-break"><asp:Literal ID="litBrief" runat="server" Mode="Encode" /></p><div><asp:Literal ID="litDetails" runat="server" /></div><div class="mt-2"><asp:Literal ID="litDates" runat="server" /></div></div></div>
<asp:Literal ID="litSync" runat="server" /><asp:Literal ID="litRefresh" runat="server" /><div class="card"><div class="card-header border-bottom"><h5 class="mb-0"><i class="bx bx-conversation me-2"></i>سجل المحادثة</h5><small class="text-muted">يُحدّث تلقائيًا كل 30 ثانية دون مسح مسودة الرد.</small></div><div class="card-body pt-4" id="correspondence-messages"><ol class="timeline mb-0"><asp:Repeater ID="rptMessages" runat="server" EnableViewState="false"><ItemTemplate>
<li class="timeline-item timeline-item-transparent ps-4"><span class='<%# "timeline-point timeline-point-" & If(CInt(Eval("SenderID")) = ActorID, "primary", "info")%>'></span><div class="timeline-event"><div class="d-flex flex-wrap justify-content-between gap-2 mb-2"><strong><%#: If(CInt(Eval("SenderID")) = ActorID, "أنت", Convert.ToString(Eval("SenderName")))%></strong><small class="text-muted"><%#: CorrespondenceData.DisplayDate(Eval("CreatedDate"))%></small></div><div class="p-3 bg-lighter rounded text-break"><%# CorrespondenceData.MessageHtml(Eval("Body"))%></div><div class="d-flex flex-wrap gap-2"><asp:Repeater ID="rptFiles" runat="server" DataSource='<%# AttachmentsFor(Eval("ID"))%>'><ItemTemplate><a class="btn btn-sm btn-label-primary mt-2" href='<%#: CorrespondenceData.FileUrl(Eval("FileName"))%>' data-correspondence-file="true"><i class="bx bx-paperclip me-1"></i><%#: "مرفق " & (Container.ItemIndex + 1).ToString()%></a></ItemTemplate></asp:Repeater></div><div class="small text-muted mt-2"><i class="bx bx-check-double me-1"></i><%#: If(CBool(Eval("IsRead")), "قرأها المستلم: " & CorrespondenceData.DisplayDate(Eval("ReadDate")), "لم يقرأها المستلم بعد")%></div></div></li>
</ItemTemplate></asp:Repeater></ol></div></div>
<details class="card mt-3"><summary class="card-header">التبعية التنظيمية والمراسلات المرتبطة</summary><div class="card-body"><asp:Literal ID="litOrganization" runat="server" /><asp:Literal ID="litRelated" runat="server" /></div></details>
</ContentTemplate></asp:UpdatePanel></div><div class="col-lg-4"><div class="card"><div class="card-header"><h5 class="mb-0">الرد والإجراءات</h5></div><div class="card-body"><div id="correspondence-live-note" class="alert alert-secondary" hidden role="status"></div><asp:Panel ID="pnlClosedNote" runat="server" CssClass="alert alert-secondary"><asp:Literal ID="litClosedText" runat="server" Mode="Encode" /></asp:Panel><asp:Panel ID="pnlCompose" runat="server" ClientIDMode="Static"><asp:Label runat="server" AssociatedControlID="txtReply" CssClass="form-label" Text="ردك" /><asp:TextBox ID="txtReply" runat="server" TextMode="MultiLine" Rows="5" MaxLength="4000" CssClass="form-control mb-3" placeholder="اكتب الرد أو أرفق ملفًا" /><details class="mb-3"><summary class="text-primary mb-2">إرفاق ملفات</summary><cc1:AjaxFileUpload ID="AttachmentUpload" runat="server" AllowedFileTypes="pdf,doc,docx,xls,xlsx,jpg,jpeg,png,gif" MaximumNumberOfFiles="5" MaxFileSize="10240" OnUploadComplete="AttachmentUpload_UploadComplete" OnUploadStart="AttachmentUpload_UploadStart" />
<div class="form-text mt-2">PDF، Word، Excel أو صور. ارفع المرفقات أولاً ثم اضغط إرسال.</div><div class="mt-2"><asp:Label ID="lblQueued" runat="server" CssClass="form-text" /></div><div class="mb-3"><asp:LinkButton ID="btnClearUploads" runat="server" CssClass="btn btn-sm btn-label-secondary mt-2" Text="مسح المرفقات المحددة" OnClick="ClearUploads_Click" CausesValidation="false" /></div>
</details><asp:Button ID="btnSend" runat="server" Text="إرسال الرد" CssClass="btn btn-primary w-100" OnClick="Send_Click" /><asp:Button ID="btnCloseStart" runat="server" ClientIDMode="Static" Text="إنهاء المراسلة وتحديد النتيجة" CssClass="btn btn-label-secondary w-100 mt-2" OnClick="CloseStart_Click" /></asp:Panel><asp:HyperLink ID="lnkTransfer" runat="server" CssClass="btn btn-label-primary w-100 mt-2">إنشاء تكليف مرتبط للمسؤول البديل</asp:HyperLink>
<asp:Panel ID="pnlArchive" runat="server" CssClass="border-top mt-3 pt-3"><h6>أرشفة إدارية</h6><p class="small text-muted">حساب المنشئ معطل. توقف الأرشفة المتابعة دون تحديد نتيجة الإنجاز، وتُحفظ مع السبب في السجل.</p><asp:Label runat="server" AssociatedControlID="txtArchiveReason" CssClass="form-label" Text="سبب الأرشفة *" /><asp:TextBox ID="txtArchiveReason" runat="server" TextMode="MultiLine" Rows="3" MaxLength="1000" CssClass="form-control mb-2" /><asp:Button ID="btnArchive" runat="server" Text="تأكيد الأرشفة الإدارية" CssClass="btn btn-outline-secondary w-100" OnClick="Archive_Click" OnClientClick="return confirm('أرشفة المراسلة دون تحديد نتيجة الإنجاز؟');" /></asp:Panel></div></div>
<asp:Panel ID="pnlAudit" runat="server" CssClass="card mt-3"><div class="card-header"><h6 class="mb-1">سجل الاطلاع الإداري</h6><small class="text-muted">آخر 100 عملية؛ التحديث التلقائي لا يكرر تسجيل الزيارة نفسها.</small></div><div class="card-body"><asp:Repeater ID="rptAudit" runat="server"><ItemTemplate><div class="border-bottom pb-2 mb-2"><strong class="small"><%#: Eval("ActorName")%></strong><div class="small"><%#: If(CStr(Eval("Action")) = "view", "اطلاع إداري", "أرشفة إدارية")%> · <%#: CorrespondenceData.DisplayDate(Eval("CreatedAt"))%></div><div class="small text-muted"><%#: Eval("Note")%></div></div></ItemTemplate></asp:Repeater></div></asp:Panel></div></div>
 <asp:Panel ID="pnlClose" runat="server" Width="100%" Style="display:none;" role="dialog" aria-modal="true" aria-labelledby="closeConversationTitle">
  <div class="modal-dialog modal-dialog-centered" role="document"><div class="modal-content">
   <div class="modal-header"><h5 class="modal-title" id="closeConversationTitle"><i class="bx bx-check-shield me-2" aria-hidden="true"></i>إنهاء المحادثة</h5></div>
   <div class="modal-body"><p>بعد الإنهاء ستبقى المحادثة ومرفقاتها متاحة للقراءة فقط.</p><asp:Literal ID="litCloseError" runat="server" /><asp:Panel ID="pnlOutcome" runat="server"><label class="form-label">هل تم الإنجاز؟ <span class="text-danger">*</span></label><asp:RadioButtonList ID="rblOutcome" runat="server" CssClass="mb-3"><asp:ListItem Value="1">تم الإنجاز</asp:ListItem><asp:ListItem Value="0">لم يتم الإنجاز</asp:ListItem></asp:RadioButtonList></asp:Panel><div class="mb-3"><asp:Label runat="server" AssociatedControlID="ddlClosureKind" CssClass="form-label" Text="سبب الإنهاء" /><asp:DropDownList ID="ddlClosureKind" runat="server" CssClass="form-select"></asp:DropDownList></div><asp:Label runat="server" AssociatedControlID="txtCloseReason" CssClass="form-label" Text="التوضيح (مطلوب لنقل المسؤولية)" /><asp:TextBox ID="txtCloseReason" runat="server" CssClass="form-control" TextMode="MultiLine" Rows="3" MaxLength="1000" /></div>
   <div class="modal-footer"><asp:Button ID="btnCloseCancel" runat="server" Text="إلغاء" CssClass="btn btn-label-secondary" OnClick="CloseCancel_Click" CausesValidation="false" /><asp:Button ID="btnCloseConfirm" runat="server" Text="تأكيد الإنهاء" CssClass="btn btn-primary" OnClick="CloseConfirm_Click" /></div>
  </div></div>
 </asp:Panel><asp:Label ID="lblCloseTarget" runat="server" /><cc1:ModalPopupExtender ID="CloseModal" runat="server" TargetControlID="lblCloseTarget" PopupControlID="pnlClose" BackgroundCssClass="modal-backdrop fade show" />
</asp:Panel><div class="modal fade" id="correspondence-preview" tabindex="-1" aria-labelledby="correspondence-preview-title" aria-hidden="true"><div class="modal-dialog modal-xl modal-dialog-centered"><div class="modal-content"><div class="modal-header"><h5 class="modal-title" id="correspondence-preview-title">مرفق المراسلة</h5><button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="إغلاق"></button></div><div class="modal-body p-0"><iframe title="معاينة المرفق" id="correspondence-preview-frame" class="w-100 border-0" style="height:70vh"></iframe></div></div></div></div></div>
<script>
document.addEventListener('click',function(e){const link=e.target.closest('[data-correspondence-file]');if(link && /\.(pdf|png|jpe?g|gif)$/i.test(new URL(link.href).pathname)){e.preventDefault();document.getElementById('correspondence-preview-frame').src=link.href;bootstrap.Modal.getOrCreateInstance(document.getElementById('correspondence-preview')).show();}});
document.addEventListener('DOMContentLoaded',function(){document.getElementById('correspondence-preview').addEventListener('hidden.bs.modal',function(){document.getElementById('correspondence-preview-frame').removeAttribute('src');});
function visible(){const field=document.getElementById('hfVisible');if(field)field.value=document.hidden?'0':'1';}visible();document.addEventListener('visibilitychange',visible);
if(window.Sys && Sys.WebForms){const manager=Sys.WebForms.PageRequestManager.getInstance();manager.add_initializeRequest(visible);manager.add_endRequest(function(){const state=document.getElementById('correspondence-sync');if(!state)return;const compose=document.getElementById('pnlCompose'),close=document.getElementById('btnCloseStart'),note=document.getElementById('correspondence-live-note');if(compose)compose.hidden=state.dataset.reply!=='1';if(close)close.style.display=state.dataset.close==='1'?'':'none';if(note && compose){note.hidden=state.dataset.reply==='1';note.textContent=state.dataset.note;}});}
});
</script></asp:Content>
