<%@ Page Title="تقديم طلب جديد" Language="vb" AutoEventWireup="false" MasterPageFile="~/Site.Master" CodeBehind="AddEmployeeFeedback.aspx.vb" Inherits="CRM.AddEmployeeFeedback" %>
<%@ Register Assembly="AjaxControlToolkit" Namespace="AjaxControlToolkit" TagPrefix="cc1" %>
<asp:Content ID="Head" ContentPlaceHolderID="HeadContent" runat="server"><link rel="stylesheet" href="/assets/vendor/libs/bs-stepper/bs-stepper.css"/><link rel="stylesheet" href="/assets/css/crm.css"/><link rel="stylesheet" href="/assets/css/crm-list.css"/><link rel="stylesheet" href="/assets/css/feedback-workspace.css?v=20261022g"/></asp:Content>
<asp:Content ID="Main" ContentPlaceHolderID="ContentPlaceHolder1" runat="server"><div class="container-xxl container-p-y feedback-workspace crm-types" dir="rtl">
 <div class="type-page-header type-flex justify-content-between align-items-center"><div><h1 class="h4 mb-1">تقديم طلب جديد</h1><p class="small text-muted mb-0">أكمل الخطوات التالية لإرسال طلبك إلى الجهة المختصة.</p></div><a href="ManageEmployeeFeedback.aspx" class="btn btn-label-secondary"><i class="bx bx-arrow-back me-1" aria-hidden="true"></i>متابعة الطلبات</a></div><asp:Literal ID="litMessage" runat="server"/>
 <div class="card bs-stepper wizard-numbered feedback-wizard" data-feedback-wizard data-feedback-current="0">
  <div class="bs-stepper-header" role="list" aria-label="خطوات تقديم الطلب">
   <div class="step" data-feedback-indicator="0"><button type="button" class="step-trigger" data-feedback-jump="0"><span class="bs-stepper-circle">1</span><span class="bs-stepper-label"><span class="bs-stepper-title">بيانات مقدم الطلب</span><span class="bs-stepper-subtitle">الفرع وبيانات الموظف</span></span></button></div><div class="line" aria-hidden="true"><i class="bx bx-chevron-left"></i></div>
   <div class="step" data-feedback-indicator="1"><button type="button" class="step-trigger" data-feedback-jump="1"><span class="bs-stepper-circle">2</span><span class="bs-stepper-label"><span class="bs-stepper-title">تفاصيل الطلب</span><span class="bs-stepper-subtitle">النوع والموضوع والتفاصيل</span></span></button></div><div class="line" aria-hidden="true"><i class="bx bx-chevron-left"></i></div>
   <div class="step" data-feedback-indicator="2"><button type="button" class="step-trigger" data-feedback-jump="2"><span class="bs-stepper-circle">3</span><span class="bs-stepper-label"><span class="bs-stepper-title">المرفقات</span><span class="bs-stepper-subtitle">إرفاق الملفات اختياري</span></span></button></div><div class="line" aria-hidden="true"><i class="bx bx-chevron-left"></i></div>
   <div class="step" data-feedback-indicator="3"><button type="button" class="step-trigger" data-feedback-jump="3"><span class="bs-stepper-circle">4</span><span class="bs-stepper-label"><span class="bs-stepper-title">الإرسال والخصوصية</span><span class="bs-stepper-subtitle">المستلم والإفصاح عن الهوية</span></span></button></div>
  </div>
  <div class="bs-stepper-content"><p class="small text-muted mb-4" data-feedback-progress role="status" aria-live="polite">الخطوة 1 من 4</p>
   <section data-feedback-step="0"><h2 class="h5 mb-3">بيانات مقدم الطلب</h2><p class="text-muted small mb-4">تُجلب هذه البيانات من حسابك تلقائيًا. تُحفظ نسخة منها وقت الإرسال.</p><asp:Literal ID="litApplicant" runat="server"/></section>
   <section data-feedback-step="1" hidden><h2 class="h5 mb-3">تفاصيل الطلب</h2><div class="row g-3"><div class="col-12 col-md-6"><asp:Label runat="server" AssociatedControlID="ddlType" CssClass="form-label" Text="نوع الطلب *"/><asp:DropDownList ID="ddlType" runat="server" CssClass="form-select" data-feedback-type-select="1" data-feedback-topic-target="ddlTopic" data-feedback-required="1"/></div><div class="col-12 col-md-6"><asp:Label runat="server" AssociatedControlID="ddlTopic" CssClass="form-label" Text="الموضوع *"/><asp:DropDownList ID="ddlTopic" runat="server" ClientIDMode="Static" CssClass="form-select" data-feedback-topic="1" data-feedback-required="1"/></div><div class="col-12"><asp:Label runat="server" AssociatedControlID="txtTitle" CssClass="form-label" Text="عنوان الطلب *"/><asp:TextBox ID="txtTitle" runat="server" CssClass="form-control" MaxLength="300" data-feedback-required="1" placeholder="اكتب عنوانًا واضحًا للطلب"/></div><div class="col-12"><asp:Label runat="server" AssociatedControlID="txtDetails" CssClass="form-label" Text="التفاصيل *"/><asp:TextBox ID="txtDetails" runat="server" CssClass="form-control" TextMode="MultiLine" Rows="6" MaxLength="10000" data-feedback-required="1" placeholder="اشرح التفاصيل التي تساعد الجهة المعنية على متابعة الطلب"/></div></div></section>
   <section data-feedback-step="2" hidden><h2 class="h5 mb-3">المرفقات</h2><p class="small text-muted mb-3">يمكنك إكمال الطلب دون مرفقات، أو إضافة حتى خمسة ملفات بحجم 10 ميجابايت لكل ملف.</p><cc1:AjaxFileUpload ID="AttachmentUpload" runat="server" AllowedFileTypes="pdf,doc,docx,xls,xlsx,jpg,jpeg,png,gif" AutoStartUpload="true" MaximumNumberOfFiles="5" MaxFileSize="10240" OnUploadStart="AttachmentUpload_UploadStart" OnUploadComplete="AttachmentUpload_UploadComplete"/><div class="form-text mt-2">PDF، Word، Excel أو صور. انتظر اكتمال الرفع قبل إرسال الطلب.</div><asp:Label ID="lblQueued" runat="server" CssClass="form-text"/><p class="small text-muted mt-2 mb-0" data-feedback-upload-status role="status" aria-live="polite"></p><asp:Button ID="btnClearUploads" runat="server" Text="مسح المرفقات المحددة" OnClick="ClearUploads_Click" CssClass="btn btn-sm btn-label-secondary mt-3" CausesValidation="false" data-feedback-clear-files="1"/></section>
   <section data-feedback-step="3" hidden><h2 class="h5 mb-3">الإرسال والخصوصية</h2><div class="row g-3"><div class="col-12 col-md-6"><asp:Label runat="server" AssociatedControlID="ddlTarget" CssClass="form-label" Text="تقديم الطلب إلى *"/><asp:DropDownList ID="ddlTarget" runat="server" CssClass="form-select" data-feedback-routing-select="1" data-feedback-routing-target="lblRouting" data-feedback-required="1"/><asp:Label ID="lblRouting" runat="server" ClientIDMode="Static" CssClass="d-block small text-primary mt-2" role="status" aria-live="polite"/></div><div class="col-12 col-md-6"><asp:Label runat="server" AssociatedControlID="ddlIdentity" CssClass="form-label" Text="هل تريد الإفصاح عن هويتك؟ *"/><asp:DropDownList ID="ddlIdentity" runat="server" CssClass="form-select" data-feedback-required="1"><asp:ListItem Value="">اختر خيار الخصوصية</asp:ListItem><asp:ListItem Value="1">نعم، إظهار هويتي</asp:ListItem><asp:ListItem Value="0" data-feedback-valid-zero="1">لا، إخفاء هويتي</asp:ListItem></asp:DropDownList></div><div class="col-12"><div class="alert alert-info mb-0"><i class="bx bx-lock-alt me-1" aria-hidden="true"></i>عند إخفاء الهوية لا تظهر بياناتك الشخصية للمستلمين. تجنب ذكر ما يكشف هويتك في النص أو المرفقات.</div></div></div></section>
   <div class="feedback-wizard-footer border-top mt-4 pt-3"><button type="button" class="btn btn-label-secondary" data-feedback-prev hidden><i class="bx bx-chevron-right me-1" aria-hidden="true"></i>السابق</button><div class="feedback-wizard-final"><a href="ManageEmployeeFeedback.aspx" class="btn btn-label-secondary">إلغاء</a><button type="button" class="btn btn-primary" data-feedback-next>التالي<i class="bx bx-chevron-left ms-1" aria-hidden="true"></i></button><asp:Button ID="btnSave" runat="server" Text="إرسال الطلب" OnClick="Save_Click" CssClass="btn btn-success" data-feedback-submit="1" hidden="hidden"/></div></div>
  </div>
 </div>
</div><script src="/assets/js/feedback-wizard.js?v=20261022b"></script></asp:Content>
