<%@ Page Title="سجل المشاهدات والإجراءات" Language="vb" AutoEventWireup="false" MasterPageFile="~/Site.Master" CodeBehind="EmployeeFeedbackLogs.aspx.vb" Inherits="CRM.EmployeeFeedbackLogs" %>
<%@ Import Namespace="CRM" %>
<asp:Content ID="Head" ContentPlaceHolderID="HeadContent" runat="server" />
<asp:Content ID="Main" ContentPlaceHolderID="ContentPlaceHolder1" runat="server"><div class="container-xxl flex-grow-1 container-p-y" dir="rtl"><asp:Literal ID="litMessage" runat="server" /><div class="card"><div class="card-header d-inline-flex w-100 flex-wrap justify-content-between gap-2"><div><h5 class="mb-1"><i class="bx bx-history text-primary me-2"></i>سجل المتابعة والإجراءات</h5><asp:Label ID="lblScope" runat="server" CssClass="text-muted" /></div><asp:HyperLink ID="lnkBack" runat="server" CssClass="btn btn-label-secondary" Text="العودة" /></div><div class="card-body"><p class="form-text">تاريخ ووقت كل مشاهدة وإجراء بتوقيت الأردن، مع الحفاظ على خصوصية الطلبات المجهولة.</p><table id="ERPTable" class="ERP_ProstoTBL card-list-table table table-sm table-bordered dt-responsive nowrap"><thead><tr><th>الطلب</th><th>الحدث</th><th>بواسطة</th><th>التاريخ والوقت</th></tr></thead><tbody><asp:ListView ID="lstData" runat="server"><LayoutTemplate><asp:PlaceHolder ID="itemPlaceholder" runat="server" /></LayoutTemplate><ItemTemplate><tr><td class="py-2" data-title="الطلب"><a href='<%# "ViewEmployeeFeedback.aspx?report=1&ID=" & Eval("Request_ID").ToString()%>'>#<%#: Eval("Request_ID")%></a></td><td class="py-2" data-title="الحدث"><span class="badge bg-label-info"><i class="bx bx-history me-1"></i><%#: Eval("EventType")%></span></td><td class="py-2" data-title="بواسطة"><%#: Eval("ActorName")%></td><td class="py-2" data-title="التاريخ والوقت"><span dir="ltr"><%#: EmployeeFeedbackData.LogDate(Eval("EventDate"))%></span></td></tr></ItemTemplate><EmptyDataTemplate><tr><td colspan="4" class="text-center py-4">لا توجد سجلات.</td></tr></EmptyDataTemplate></asp:ListView></tbody></table></div></div></div></asp:Content>