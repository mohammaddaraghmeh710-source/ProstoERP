<%@ Page Title="إشعارات الشكاوى والاقتراحات" Language="vb" AutoEventWireup="false" MasterPageFile="~/Site.Master" CodeBehind="EmployeeFeedbackNotifications.aspx.vb" Inherits="CRM.EmployeeFeedbackNotifications" %>
<%@ Import Namespace="CRM" %>
<asp:Content ID="Head" ContentPlaceHolderID="HeadContent" runat="server"></asp:Content>
<asp:Content ID="Main" ContentPlaceHolderID="ContentPlaceHolder1" runat="server"><div class="container-xxl flex-grow-1 container-p-y" dir="rtl"><asp:Literal ID="litMessage" runat="server" /><asp:Literal ID="litStatistics" runat="server" /><section class="card cvv-code-mask mb-4"><div class="card-header d-inline-flex w-100 flex-wrap justify-content-between align-items-center gap-3"><h5 class="card-title mb-0"><i class="bx bx-bell text-primary me-2"></i>إشعارات الطلبات</h5><a href="ManageEmployeeFeedback.aspx" class="btn btn-sm btn-label-secondary"><i class="bx bx-arrow-back me-1"></i>متابعة الطلبات</a></div><div class="card-body"><table id="ERPTable" class="ERP_ProstoTBL card-list-table table table-sm table-bordered dt-responsive nowrap"><thead><tr><th>الطلب</th><th>الإشعار</th><th>التاريخ</th><th>القراءة</th><th>عرض</th></tr></thead><tbody><asp:ListView ID="lstData" runat="server"><LayoutTemplate><asp:PlaceHolder ID="itemPlaceholder" runat="server" /></LayoutTemplate><ItemTemplate><tr><td class="py-2" data-title="الطلب"><%#: Eval("Title")%></td><td class="py-2" data-title="الإشعار"><i class="bx bx-history text-primary me-2"></i><%#: EmployeeFeedbackData.ActionText(Eval("NotificationType"))%></td><td class="py-2" data-title="التاريخ"><%#: CorrespondencePresentation.DisplayDate(Eval("SendDate"))%></td><td class="py-2" data-title="القراءة"><span class='<%# "badge " & If(CBool(Eval("IsRead")), "bg-label-secondary", "bg-label-warning")%>'><%#: If(CBool(Eval("IsRead")), "تمت القراءة", "جديد")%></span></td><td class="py-2" data-title="عرض"><a class="btn btn-sm btn-label-primary" href='<%# "ViewEmployeeFeedback.aspx?ID=" & Eval("Request_ID").ToString()%>'>فتح الطلب</a></td></tr></ItemTemplate><EmptyDataTemplate><tr><td colspan="5" class="text-center py-4">لا توجد إشعارات.</td></tr></EmptyDataTemplate></asp:ListView></tbody></table></div></section></div></asp:Content>