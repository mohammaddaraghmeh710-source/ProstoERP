<asp:Content ID="Main" ContentPlaceHolderID="ContentPlaceHolder1" runat="server"><div class="container-xxl flex-grow-1 container-p-y crm-shell crm-types" dir="rtl"><asp:Literal ID="litMessage" runat="server" /><section class="card cvv-code-mask mb-4"><div class="card-header d-inline-flex w-100 flex-wrap justify-content-between align-items-center gap-3"><h5 class="card-title mb-0"><i class="bx bx-bar-chart-alt-2 text-primary me-2"></i>إحصائيات الشكاوى والاقتراحات</h5><div class="d-inline-flex flex-wrap gap-2"><asp:Button ID="btnReset" runat="server" Text="مسح الفلاتر" CssClass="btn btn-sm btn-label-secondary" OnClick="Reset_Click" /><a href="EmployeeFeedbackLogs.aspx" class="btn btn-sm btn-label-info">سجل المشاهدات والإجراءات</a><a href="ManageEmployeeFeedback.aspx" class="btn btn-sm btn-label-primary">متابعة الطلبات</a></div></div><div class="card-body type-filter-header"><div class="row g-3 align-items-end"><div class="col-md-4"><asp:TextBox ID="txtSearch" runat="server" CssClass="form-control" MaxLength="300" placeholder="العنوان أو رقم الطلب" aria-label="العنوان أو رقم الطلب" /></div><div class="col-md-3"><asp:Label runat="server" AssociatedControlID="ddlType" CssClass="form-label" Text="النوع" /><asp:DropDownList ID="ddlType" runat="server" CssClass="form-select select2" ></asp:DropDownList></div><div class="col-md-3"><asp:Label runat="server" AssociatedControlID="ddlStatus" CssClass="form-label" Text="الحالة" /><asp:DropDownList ID="ddlStatus" runat="server" CssClass="form-select select2" ><asp:ListItem Value="0">الكل</asp:ListItem><asp:ListItem Value="4">فعال — جديد أو قيد المعالجة</asp:ListItem><asp:ListItem Value="1">جديد</asp:ListItem><asp:ListItem Value="2">قيد المعالجة</asp:ListItem><asp:ListItem Value="3">مغلق</asp:ListItem></asp:DropDownList></div><div class="col-md-2"><asp:Button ID="btnSearch" runat="server" Text="بحث" OnClick="Search_Click" CssClass="btn btn-primary"  /></div></div><details class="border-top pt-2 mt-2" <%= If(IsPostBack OrElse Request.QueryString.Count>0,"open","") %>><summary class="text-primary fw-semibold mb-0"><i class="bx bx-filter-alt me-1"></i>بحث متقدم</summary><asp:Panel ID="pnlReport" runat="server" CssClass="row g-3 mb-3"><div class="col-md-4"><asp:Label runat="server" AssociatedControlID="ddlBrand" CssClass="form-label" Text="العلامة التجارية" /><asp:DropDownList ID="ddlBrand" runat="server" AutoPostBack="true" OnSelectedIndexChanged="Brand_Changed" CssClass="form-select select2" ></asp:DropDownList></div><div class="col-md-4"><asp:Label runat="server" AssociatedControlID="ddlBranch" CssClass="form-label" Text="الفرع" /><asp:DropDownList ID="ddlBranch" runat="server" CssClass="form-select select2" ></asp:DropDownList></div><div class="col-md-4"><asp:Label runat="server" AssociatedControlID="ddlIdentity" CssClass="form-label" Text="الهوية" /><asp:DropDownList ID="ddlIdentity" runat="server" CssClass="form-select"><asp:ListItem Value="0">الكل</asp:ListItem><asp:ListItem Value="1">معروف الهوية</asp:ListItem><asp:ListItem Value="2">مجهول الهوية</asp:ListItem></asp:DropDownList></div><div class="col-md-4"><asp:Label runat="server" AssociatedControlID="ddlSource" Text="مقدم الطلب" CssClass="form-label" /><asp:DropDownList ID="ddlSource" runat="server" CssClass="form-select"><asp:ListItem Value="0">الكل</asp:ListItem><asp:ListItem Value="1">موظف</asp:ListItem><asp:ListItem Value="2">زبون</asp:ListItem></asp:DropDownList></div><div class="col-md-4 d-none"><asp:Label runat="server" AssociatedControlID="ddlShift" CssClass="form-label" Text="الوردية" /><asp:DropDownList ID="ddlShift" runat="server" CssClass="form-select select2" ></asp:DropDownList></div><div class="col-md-4"><asp:Label runat="server" AssociatedControlID="txtFrom" CssClass="form-label" Text="من تاريخ" /><asp:TextBox ID="txtFrom" runat="server" CssClass="form-control" TextMode="Date" /></div><div class="col-md-4"><asp:Label runat="server" AssociatedControlID="txtTo" CssClass="form-label" Text="إلى تاريخ" /><asp:TextBox ID="txtTo" runat="server" CssClass="form-control" TextMode="Date" /></div><p class="form-text">تشمل الإحصائيات الطلبات المعلنة والمجهولة. يظهر اسم العلامة والفرع ومصدر الطلب، وتبقى هوية مقدم الطلب المجهول وبيانات تواصله محجوبة.</p></asp:Panel></details>
</div></section><asp:Literal ID="litStatistics" runat="server" /><section class="card"><div class="card-header py-3"><h2 class="h6 mb-1">نتائج البحث</h2><asp:Label ID="lblTotal" runat="server" CssClass="small text-muted" /></div><div id="pnlTableActions" class="type-flex type-toolbar-controls align-items-center"><asp:HyperLink ID="lnkNew" runat="server" NavigateUrl="AddEmployeeFeedback.aspx" CssClass="btn btn-primary">تقديم طلب</asp:HyperLink><asp:Button ID="btnExport" runat="server" Text="تصدير CSV" OnClick="Export_Click" CssClass="btn btn-label-secondary"  /></div><div class="card-datatable table-responsive"><table id="ERPTable" data-enhanced="1" class="ERP_ProstoTBL card-list-table table border-top crm-table"><thead><tr><th>رقم الطلب</th><th>النوع</th><th>العنوان / مقدّم الطلب</th><th>الحالة</th><th>الجهة الحالية</th><th>تاريخ التقديم</th><th data-orderable="false">الإجراءات</th></tr></thead><tbody><asp:ListView ID="lstData" runat="server"><LayoutTemplate><asp:PlaceHolder ID="itemPlaceholder" runat="server" /></LayoutTemplate><ItemTemplate><tr><td class="py-2" data-title="رقم الطلب"><%#: Eval("ID") %></td><td class="py-2" data-title="النوع"><%#: CRM.EmployeeFeedbackData.TypeText(Eval("Type")) %></td><td class="py-2" data-title="العنوان / مقدّم الطلب"><div class="type-record-name"><strong><%#: Eval("Title") %></strong><div class="mt-1"><span class="badge bg-label-info"><%#: CRM.FeedbackPresentation.SourceName(Eval("SourceType")) %></span></div><div class="small text-muted mt-1"><%#: Eval("BrandName") %> · <%#: Eval("BranchName") %></div><div class="small text-muted"><%#: Eval("EmployeeName") %></div><asp:Label runat="server" CssClass="badge bg-label-warning" Visible='<%# Convert.ToInt32(Eval("UnreadCount"))>0 %>' Text="غير مقروء" /></div></td><td class="py-2" data-title="الحالة"><span class='<%# CRM.EmployeeFeedbackData.StatusCss(Eval("Status")) %>'><%#: CRM.EmployeeFeedbackData.StatusText(Eval("Status")) %></span></td><td class="py-2" data-title="الجهة الحالية"><%#: Eval("CurrentRecipient") %></td><td class="py-2" data-title="تاريخ التقديم"><%#: CRM.CorrespondencePresentation.DisplayDate(Eval("AddedDate")) %></td><td class="py-2" data-title="الإجراءات"><div class="type-flex type-row-actions"><a class="btn btn-sm btn-icon type-row-action text-secondary" href='<%# DetailLink(Eval("ID")) %>' aria-label="تفاصيل الطلب" title="تفاصيل الطلب" data-bs-toggle="tooltip"><i class="fa-solid fa-eye" aria-hidden="true"></i></a></div></td></tr></ItemTemplate></asp:ListView></tbody></table></div></section></div><script src="/assets/js/crm-list.js?v=20261021suppliers"></script></asp:Content>
