<%@ Page Title="تفاصيل الطلب" Language="vb" AutoEventWireup="false" MasterPageFile="~/Site.Master" CodeBehind="ViewEmployeeFeedback.aspx.vb" Inherits="CRM.ViewEmployeeFeedback" %>
<%@ Register Assembly="AjaxControlToolkit" Namespace="AjaxControlToolkit" TagPrefix="cc1" %>
<asp:Content ID="Head" ContentPlaceHolderID="HeadContent" runat="server"></asp:Content>
<asp:Content ID="Main" ContentPlaceHolderID="ContentPlaceHolder1" runat="server">
<div class="container-xxl flex-grow-1 container-p-y" dir="rtl">
    <asp:Literal ID="litMessage" runat="server" />
    <asp:Panel ID="pnlDetails" runat="server" Visible="false">
        <div class="card cvv-code-mask mb-3">
            <div class="card-body p-3">
                <div class="row g-2 align-items-center">
                    <div class="col-md">
                        <div class="d-inline-flex flex-wrap align-items-center gap-2 mb-1">
                            <span class="small text-muted">طلب #<asp:Literal ID="litID" runat="server" Mode="Encode" /></span>
                            <asp:Label ID="lblSource" runat="server" CssClass="badge bg-label-secondary" />
                            <asp:Label ID="lblType" runat="server" CssClass="badge bg-label-info" />
                            <asp:Label ID="lblStatus" runat="server" />
                        </div>
                        <h6 class="mb-0 text-break"><asp:Literal ID="litTitle" runat="server" Mode="Encode" /></h6>
                    </div>
                    <div class="col-md-auto">
                        <asp:HyperLink ID="lnkBack" runat="server" CssClass="badge bg-label-secondary"><i class="bx bx-arrow-back me-1" aria-hidden="true"></i>العودة للقائمة</asp:HyperLink>
                    </div>
                </div>
            </div>
        </div>
        <div class="card cvv-code-mask mb-4">
            <div class="nav-align-top">
                <ul class="nav nav-pills nav-fill flex-wrap gap-1 p-3 border-bottom" role="tablist" aria-label="تفاصيل الشكوى أو الاقتراح">
                    <li class="nav-item" role="presentation"><button type="button" id="feedback-details-tab" class='nav-link text-wrap <%= If(IsPostBack, "", "active") %>' data-bs-toggle="tab" data-bs-target="#feedback-details" role="tab" aria-controls="feedback-details" aria-selected='<%= If(IsPostBack, "false", "true") %>'><i class="bx bx-detail me-1" aria-hidden="true"></i>معلومات الطلب</button></li>
                    <li class="nav-item" role="presentation"><button type="button" id="feedback-contact-tab" class="nav-link text-wrap" data-bs-toggle="tab" data-bs-target="#feedback-contact" role="tab" aria-controls="feedback-contact" aria-selected="false"><i class="bx bx-user-pin me-1" aria-hidden="true"></i>معلومات التواصل</button></li>
                    <li class="nav-item" role="presentation"><button type="button" id="feedback-workflow-tab" class="nav-link text-wrap" data-bs-toggle="tab" data-bs-target="#feedback-workflow" role="tab" aria-controls="feedback-workflow" aria-selected="false"><i class="bx bx-git-branch me-1" aria-hidden="true"></i>سير العمل</button></li>
                    <li class="nav-item" role="presentation"><button type="button" id="feedback-actions-tab" class='nav-link text-wrap <%= If(IsPostBack, "active", "") %>' data-bs-toggle="tab" data-bs-target="#feedback-actions" role="tab" aria-controls="feedback-actions" aria-selected='<%= If(IsPostBack, "true", "false") %>'><i class="bx bx-check-shield me-1" aria-hidden="true"></i>الإجراءات</button></li>
                    <li ID="liLogs" runat="server" class="nav-item" role="presentation"><button type="button" id="feedback-logs-tab" class="nav-link" data-bs-toggle="tab" data-bs-target="#pnlLogs" role="tab" aria-controls="pnlLogs" aria-selected="false"><i class="bx bx-history me-1" aria-hidden="true"></i>السجلات</button></li>
                </ul>
                <div class="tab-content p-3 p-md-4">
                    <asp:Panel ID="pnlLogs" runat="server" ClientIDMode="Static" CssClass="tab-pane fade" role="tabpanel" aria-labelledby="feedback-logs-tab"><p class="form-text">أوقات المشاهدة والإجراءات بتوقيت الأردن. تسجيل المشاهدات متاح منذ تفعيل هذه الميزة.</p><asp:Repeater ID="rptLogs" runat="server"><HeaderTemplate><div class="list-group list-group-flush"></HeaderTemplate><ItemTemplate><div class="list-group-item px-0"><div class="d-inline-flex w-100 flex-wrap justify-content-between gap-2"><strong><%#: Eval("EventType") %></strong><span class="small text-muted" dir="ltr"><%#: CRM.EmployeeFeedbackData.LogDate(Eval("EventDate")) %></span></div><div class="small mt-1"><%#: Eval("ActorName") %></div></div></ItemTemplate><FooterTemplate></div></FooterTemplate></asp:Repeater></asp:Panel>
                    <div class='tab-pane fade <%= If(IsPostBack, "", "show active") %>' id="feedback-details" role="tabpanel" aria-labelledby="feedback-details-tab" tabindex="0">
                        <asp:Label ID="lblEmployee" runat="server" CssClass="badge bg-label-secondary mb-3" />
                        <asp:Literal ID="litMeta" runat="server" />
                        <hr class="my-3" /><h6><i class="bx bx-message-square-detail me-2 text-primary"></i>تفاصيل الطلب</h6>
                        <div class="text-break"><asp:Literal ID="litDetails" runat="server" /></div>
                        <div class="border-top pt-3 mt-3">
                        <p class="small text-muted"><i class="bx bx-paperclip me-1"></i>المرفقات المرتبطة بالطلب وإجراءات المتابعة</p>
<asp:Repeater ID="rptFiles" runat="server"><ItemTemplate><span class="d-inline-flex align-items-center gap-2 border rounded p-2 me-2 mb-2"><i class="bx bx-file text-primary fs-4" aria-hidden="true"></i><span class="small">مرفق <%#: Container.ItemIndex+1 %> · <%#: Eval("File_Type") %></span><asp:PlaceHolder runat="server" Visible='<%# CanPreview(Eval("File_Type")) %>'><a class="btn btn-sm btn-label-primary" data-feedback-preview="true" data-bs-toggle="modal" data-bs-target="#feedback-preview" href='<%# FileLink(Eval("ID")) & "&preview=1" %>'>معاينة</a></asp:PlaceHolder><a class="btn btn-sm btn-label-secondary" href='<%# FileLink(Eval("ID")) %>' aria-label="تنزيل المرفق"><i class="bx bx-download"></i></a></span></ItemTemplate></asp:Repeater><asp:Label ID="lblNoFiles" runat="server" Text="لا توجد مرفقات لهذا الطلب." CssClass="text-muted" />
                    </div>
                    </div>
                    <div class="tab-pane fade" id="feedback-contact" role="tabpanel" aria-labelledby="feedback-contact-tab"><h6 class="mb-3"><i class="bx bx-id-card me-2 text-primary"></i>التواصل مع مقدم الطلب</h6><asp:Literal ID="litContact" runat="server" /></div>
                    <div class="tab-pane fade" id="feedback-workflow" role="tabpanel" aria-labelledby="feedback-workflow-tab" tabindex="0"><ol class="timeline mt-2 mb-0"><asp:Repeater ID="rptWorkflow" runat="server"><ItemTemplate><li class="timeline-item timeline-item-transparent ps-4"><span class='<%# "timeline-point timeline-point-" & If(Convert.ToInt32(Eval("ActionType"))=3,"success",If(Convert.ToInt32(Eval("ActionType"))=2,"warning","primary")) %>'></span><div class="timeline-event pb-2"><div class="d-inline-flex w-100 flex-wrap justify-content-between gap-2"><h6 class="mb-1"><i class="bx bx-history me-1"></i><%#: CRM.EmployeeFeedbackData.ActionText(Eval("ActionType")) %></h6><small dir="ltr"><%#: CRM.CorrespondenceData.DisplayDate(Eval("AddedDate")) %></small></div><p class="small"><%#: Eval("SenderName") %> ← <%#: Eval("ReceiverNames") %></p><div class="text-break mb-2"><%# CRM.CorrespondenceData.MessageHtml(Eval("Comment")) %></div><asp:Repeater ID="rptActionFiles" runat="server" DataSource='<%# FilesFor(Eval("GroupID")) %>'><ItemTemplate><span class="d-inline-flex align-items-center gap-2 border rounded p-2 me-2 mb-2"><i class="bx bx-file text-primary fs-4" aria-hidden="true"></i><span class="small">مرفق <%#: Container.ItemIndex+1 %> · <%#: Eval("File_Type") %></span><asp:PlaceHolder runat="server" Visible='<%# CanPreview(Eval("File_Type")) %>'><a class="btn btn-sm btn-label-primary" data-feedback-preview="true" data-bs-toggle="modal" data-bs-target="#feedback-preview" href='<%# FileLink(Eval("ID")) & "&preview=1" %>'>معاينة</a></asp:PlaceHolder><a class="btn btn-sm btn-label-secondary" href='<%# FileLink(Eval("ID")) %>' aria-label="تنزيل المرفق"><i class="bx bx-download"></i></a></span></ItemTemplate></asp:Repeater></div></li></ItemTemplate></asp:Repeater></ol>
                    </div>
                    <div class='tab-pane fade <%= If(IsPostBack, "show active", "") %>' id="feedback-actions" role="tabpanel" aria-labelledby="feedback-actions-tab" tabindex="0"><asp:Panel ID="pnlReadOnly" runat="server" CssClass="alert alert-secondary mb-0"><i class="bx bx-info-circle me-2"></i>لا توجد إجراءات متاحة لك على هذا الطلب. يمكنك الاطلاع على تفاصيله ومتابعة سير العمل.</asp:Panel><asp:Panel ID="pnlActions" runat="server"><div><p>اختر تحويل الطلب للمتابعة أو إغلاقه، مع توضيح الإجراء في حقل الشروحات.</p><div class="d-inline-flex w-100 flex-wrap gap-2"><asp:Button ID="btnTransfer" runat="server" Text="تحويل" OnClick="Transfer_Click" CssClass="btn btn-primary"  /><asp:Button ID="btnClose" runat="server" Text="إغلاق الطلب" OnClick="Close_Click" CssClass="btn btn-label-danger"  /></div></div></asp:Panel>
                    </div>
                </div>
            </div>
        </div><asp:Panel ID="pnlActionModal" runat="server" Width="100%" Style="display:none;" role="dialog" aria-modal="true" aria-labelledby="actionTitle"><div class="modal-dialog modal-dialog-centered modal-dialog-scrollable"><div class="modal-content"><div class="modal-header"><h5 id="actionTitle" class="modal-title"><asp:Literal ID="litActionTitle" runat="server" Mode="Encode" /></h5></div><div class="modal-body"><asp:Literal ID="litActionError" runat="server" /><asp:Panel ID="pnlTransferTarget" runat="server" CssClass="mb-3"><asp:Label runat="server" AssociatedControlID="ddlTransferTarget" Text="التحويل إلى *" CssClass="form-label" /><asp:DropDownList ID="ddlTransferTarget" runat="server" CssClass="form-select" AutoPostBack="true" OnSelectedIndexChanged="TransferTarget_Changed" /><asp:Label ID="lblTransferRouting" runat="server" CssClass="form-text" /></asp:Panel><asp:Label runat="server" AssociatedControlID="txtComment" CssClass="form-label" Text="الشروحات *" /><asp:TextBox ID="txtComment" runat="server" CssClass="form-control" TextMode="MultiLine" Rows="4" MaxLength="10000" /><div class="mt-3"><asp:Label runat="server" AssociatedControlID="AttachmentUpload" CssClass="form-label" Text="المرفقات (اختياري)" /><cc1:AjaxFileUpload ID="AttachmentUpload" runat="server" AllowedFileTypes="pdf,doc,docx,xls,xlsx,jpg,jpeg,png,gif" MaximumNumberOfFiles="5" MaxFileSize="10240" OnUploadStart="AttachmentUpload_UploadStart" OnUploadComplete="AttachmentUpload_UploadComplete" /><div class="form-text mt-2">PDF، Word، Excel أو صور · حتى 5 ملفات، 10 ميجابايت لكل ملف. ارفع المرفقات أولًا ثم نفّذ الإجراء.</div><asp:Label ID="lblQueued" runat="server" CssClass="form-text" /><div><asp:Button ID="btnClearUploads" runat="server" Text="مسح المرفقات المحددة" OnClick="ClearUploads_Click" CssClass="btn btn-sm btn-label-secondary mt-2" CausesValidation="false" /></div></div></div><div class="modal-footer"><asp:Button ID="btnCancel" runat="server" Text="إلغاء" OnClick="Cancel_Click" CssClass="btn btn-label-secondary" CausesValidation="false" /><asp:Button ID="btnConfirm" runat="server" Text="تأكيد الإجراء" OnClick="Confirm_Click" CssClass="btn btn-primary"  /></div></div></div></asp:Panel><asp:Label ID="lblModalTarget" runat="server" /><cc1:ModalPopupExtender ID="ActionModal" runat="server" TargetControlID="lblModalTarget" PopupControlID="pnlActionModal" BackgroundCssClass="modal-backdrop fade show" />
<div class="modal fade" id="feedback-preview" tabindex="-1" aria-labelledby="feedback-preview-title" aria-hidden="true"><div class="modal-dialog modal-xl modal-dialog-centered"><div class="modal-content"><div class="modal-header"><h5 id="feedback-preview-title" class="modal-title">معاينة المرفق</h5><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="إغلاق"></button></div><div class="modal-body p-0"><iframe id="feedback-preview-frame" title="محتوى المرفق" class="w-100 border-0" style="height:70vh"></iframe></div></div></div></div>
    </asp:Panel>
<script>document.addEventListener('click',function(e){const link=e.target.closest('[data-feedback-preview]');if(link){e.preventDefault();document.getElementById('feedback-preview-frame').src=link.href;}});document.addEventListener('DOMContentLoaded',function(){const modal=document.getElementById('feedback-preview');if(modal)modal.addEventListener('hidden.bs.modal',function(){document.getElementById('feedback-preview-frame').removeAttribute('src');});});</script>
</div>
</asp:Content>