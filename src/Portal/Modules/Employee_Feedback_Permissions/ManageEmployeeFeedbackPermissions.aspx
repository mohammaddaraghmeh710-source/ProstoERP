<%@ Page Title="صلاحيات الشكاوى والاقتراحات" Language="vb" AutoEventWireup="false" MasterPageFile="~/Site.Master" CodeBehind="ManageEmployeeFeedbackPermissions.aspx.vb" Inherits="CRM.ManageEmployeeFeedbackPermissions" %>
<asp:Content ID="Head" ContentPlaceHolderID="HeadContent" runat="server" />
<asp:Content ID="Main" ContentPlaceHolderID="ContentPlaceHolder1" runat="server"><div class="container-xxl flex-grow-1 container-p-y" dir="rtl"><asp:Literal ID="litMessage" runat="server" /><nav aria-label="إعدادات الشكاوى والاقتراحات"><ul class="nav nav-pills d-inline-flex w-100 flex-wrap gap-2 mb-3"><li class="nav-item"><a class="nav-link " href="../Employee_Feedback_Types/ManageEmployeeFeedbackTypes.aspx"><i class="bx bx-category me-2"></i>أنواع الطلبات</a></li><li class="nav-item"><a class="nav-link " href="../Employee_Feedback_Topics/ManageEmployeeFeedbackTopics.aspx"><i class="bx bx-list-ul me-2"></i>مواضيع الطلبات</a></li><li class="nav-item"><a class="nav-link active" href="../Employee_Feedback_Permissions/ManageEmployeeFeedbackPermissions.aspx"><i class="bx bx-shield-quarter me-2"></i>الصلاحيات والتوجيه</a></li></ul></nav>
<div class="card mb-4"><div class="card-header py-3"><h5 class="mb-1"><i class="bx bx-shield-quarter text-primary me-2" aria-hidden="true"></i>صلاحيات الشكاوى والاقتراحات</h5><p class="text-muted mb-0">حدد صلاحيات نوع المستخدم والجهات التي يمكنه إرسال الطلب إليها.</p></div><div class="card-body">
<div class="row g-3"><div class="col-lg-4"><asp:Label runat="server" AssociatedControlID="ddlRole" Text="نوع المستخدم" CssClass="form-label" /><asp:DropDownList ID="ddlRole" runat="server" CssClass="form-select" AutoPostBack="true" OnSelectedIndexChanged="Role_Changed" /></div>
<div class="col-lg-8"><div class="row g-3"><div class="col-md-4"><div class="form-check"><asp:CheckBox ID="chkSubmit" runat="server" Text=" تقديم طلب" /></div></div><div class="col-md-4"><div class="form-check"><asp:CheckBox ID="chkTransfer" runat="server" Text=" تحويل الطلب" /></div></div><div class="col-md-4"><div class="form-check"><asp:CheckBox ID="chkClose" runat="server" Text=" إغلاق الطلب" /></div></div><p class="form-text mt-3">التحويل والإغلاق يطبّقان على الطلبات الواردة التي لا تزال بانتظار إجراء من المستخدم. تقديم الطلب لا يمنحه صلاحية إجراء على طلبه الشخصي.</p></div></div>
</div><hr class="my-3"/><h6><i class="bx bx-git-branch me-2 text-primary"></i>الجهات المسموح بالإرسال والتحويل إليها</h6><asp:CheckBoxList ID="lstTargets" runat="server" RepeatLayout="UnorderedList" CssClass="list-unstyled row row-cols-1 row-cols-sm-2 row-cols-lg-3 g-2" /><p class="form-text">تظهر هذه الأنواع في التقديم والتحويل. يُحدّد المستلمون تلقائيًا حسب الفرع والوردية أو القسم. عند غياب المدير يُوجّه الطلب إلى مدير النظام.</p>
<asp:Button ID="btnSave" runat="server" Text="حفظ الصلاحيات" OnClick="Save_Click" CssClass="btn btn-primary" /></div></div><div class="card"><div class="card-header py-3"><h5 class="mb-0">ملخص صلاحيات أنواع المستخدمين</h5></div><div class="card-body"><table id="ERPTable" class="ERP_ProstoTBL card-list-table table table-sm table-bordered dt-responsive nowrap"><thead><tr><th>نوع المستخدم</th><th>التقديم</th><th>التحويل</th><th>الإغلاق</th><th>المستلمون المسموحون</th><th>تعديل</th></tr></thead><tbody><asp:Repeater ID="rptRoles" runat="server"><ItemTemplate><tr><td class="py-2" data-title="نوع المستخدم"><%#: Eval("Title")%></td><td class="py-2" data-title="التقديم"><%#: If(CBool(Eval("CanSubmit")), "نعم", "لا")%></td><td class="py-2" data-title="التحويل"><%#: If(CBool(Eval("CanTransfer")), "نعم", "لا")%></td><td class="py-2" data-title="الإغلاق"><%#: If(CBool(Eval("CanClose")), "نعم", "لا")%></td><td class="py-2" data-title="المستلمون المسموحون"><%#: TargetNames(Eval("Targets"))%></td><td class="py-2" data-title="تعديل"><a class="btn btn-sm btn-label-primary" href='<%# "ManageEmployeeFeedbackPermissions.aspx?role=" & Eval("UserTypeID").ToString()%>'>تعديل</a></td></tr></ItemTemplate></asp:Repeater></tbody></table></div></div></div></asp:Content>