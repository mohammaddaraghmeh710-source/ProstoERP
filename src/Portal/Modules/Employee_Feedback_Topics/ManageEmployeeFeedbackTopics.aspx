<%@ Page Title="مواضيع الشكاوى والاقتراحات" Language="vb" AutoEventWireup="false" MasterPageFile="~/Site.Master" CodeBehind="ManageEmployeeFeedbackTopics.aspx.vb" Inherits="CRM.ManageEmployeeFeedbackTopics" %>
<%@ Import Namespace="CRM" %>
<%@ Register Assembly="AjaxControlToolkit" Namespace="AjaxControlToolkit" TagPrefix="cc1" %>
<asp:Content ID="Head" ContentPlaceHolderID="HeadContent" runat="server"></asp:Content>
<asp:Content ID="Main" ContentPlaceHolderID="ContentPlaceHolder1" runat="server"><asp:UpdatePanel ID="systemAdminPanel" runat="server" UpdateMode="Conditional"><ContentTemplate><div class="container-xxl flex-grow-1 container-p-y" dir="rtl"><asp:Literal ID="litMessage" runat="server" /><div class="mb-3"><a class="btn btn-sm btn-label-secondary" href="/Modules/Employee_Feedback/Dashboard.aspx"><i class="bx bx-arrow-back me-1" aria-hidden="true"></i>لوحة إدارة الشكاوى</a></div><nav aria-label="إعدادات الشكاوى والاقتراحات"><ul class="nav nav-pills d-inline-flex w-100 flex-wrap gap-2 mb-3"><li class="nav-item"><a class="nav-link " href="../Employee_Feedback_Types/ManageEmployeeFeedbackTypes.aspx"><i class="bx bx-category me-2"></i>أنواع الطلبات</a></li><li class="nav-item"><a class="nav-link active" href="../Employee_Feedback_Topics/ManageEmployeeFeedbackTopics.aspx"><i class="bx bx-list-ul me-2"></i>مواضيع الطلبات</a></li><li class="nav-item"><a class="nav-link " href="../Employee_Feedback_Permissions/ManageEmployeeFeedbackPermissions.aspx"><i class="bx bx-shield-quarter me-2"></i>الصلاحيات والتوجيه</a></li></ul></nav><section class="card cvv-code-mask mb-4"><div class="card-header d-inline-flex w-100 flex-wrap justify-content-between align-items-center gap-3"><h5 class="card-title mb-0"><i class="bx bx-list-ul text-primary me-2" aria-hidden="true"></i>مواضيع الشكاوى والاقتراحات</h5><a href="AddEmployeeFeedbackTopics.aspx" class="btn btn-primary"><i class="bx bx-plus me-2"></i>إضافة موضوع</a></div><div class="card-body"><div class="row g-3 align-items-end mb-4"><div class="col-md-3"><asp:Label runat="server" AssociatedControlID="ddlType" CssClass="form-label" Text="النوع" /><asp:DropDownList ID="ddlType" runat="server" CssClass="form-select select2" ></asp:DropDownList></div><div class="col-md-4"><asp:Label runat="server" AssociatedControlID="ddlBrand" CssClass="form-label" Text="العلامة التجارية" /><asp:DropDownList ID="ddlBrand" runat="server" CssClass="form-select select2" ></asp:DropDownList></div><div class="col-md-3"><asp:Label runat="server" AssociatedControlID="ddlActive" CssClass="form-label" Text="الحالة" /><asp:DropDownList ID="ddlActive" runat="server" CssClass="form-select select2" ><asp:ListItem Value="">الكل</asp:ListItem><asp:ListItem Value="1">مفعّل</asp:ListItem><asp:ListItem Value="0">غير مفعّل</asp:ListItem></asp:DropDownList></div><div class="col-md-2"><asp:Button ID="btnSearch" runat="server" Text="بحث" OnClick="Search_Click" CssClass="btn btn-primary"  /></div></div><table id="ERPTable" class="ERP_ProstoTBL card-list-table table table-sm table-bordered dt-responsive nowrap"><thead><tr><th>النوع</th><th>الاسم بالعربية</th><th>الاسم بالإنجليزية</th><th>العلامة التجارية</th><th>الحالة</th><th>تعديل</th><th>حذف</th></tr></thead><tbody><asp:ListView ID="lstData" runat="server" OnItemCommand="Item_Command"><LayoutTemplate><asp:PlaceHolder ID="itemPlaceholder" runat="server" /></LayoutTemplate><ItemTemplate><tr data-admin-name='<%#: CRM.SystemAdministrationUI.SearchName(Container.DataItem) %>' data-admin-id='<%#: Eval("ID") %>' data-admin-active='<%# CRM.SystemAdministrationUI.State(Container.DataItem) %>'><td class="py-2" data-title="النوع"><%#: CRM.EmployeeFeedbackData.TypeText(Eval("Type")) %></td><td class="py-2" data-title="الاسم بالعربية"><%#: Eval("Title_Ar") %></td><td class="py-2" data-title="الاسم بالإنجليزية"><%#: Eval("Title_En") %></td><td class="py-2" data-title="العلامة التجارية"><%#: Eval("BrandName") %></td><td class="py-2" data-title="الحالة"><%#: If(CBool(Eval("IsActive")),"مفعّل","غير مفعّل") %></td><td class="py-2" data-title="تعديل"><a class="btn btn-icon btn-label-secondary" href='<%# "EditEmployeeFeedbackTopics.aspx?ID=" & Eval("ID").ToString() %>' aria-label="تعديل"><i class="bx bx-edit-alt"></i></a></td><td class="py-2" data-title="حذف"><asp:LinkButton ID="btnDelete" runat="server" CommandName="DeleteTopic" CommandArgument='<%#: Eval("ID") %>' CssClass="btn btn-icon btn-label-danger" OnClientClick="return confirm('هل تريد حذف الموضوع؟');" ToolTip="حذف"><i class="bx bx-trash-alt"></i></asp:LinkButton></td></tr></ItemTemplate><EmptyDataTemplate><tr><td colspan="7" class="text-center py-4">لا توجد مواضيع مطابقة.</td></tr></EmptyDataTemplate></asp:ListView></tbody></table></div></section></div></ContentTemplate></asp:UpdatePanel></asp:Content>