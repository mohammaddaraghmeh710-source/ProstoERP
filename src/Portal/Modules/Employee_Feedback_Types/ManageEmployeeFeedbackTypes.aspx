<%@ Page Title="أنواع الشكاوى والاقتراحات" Language="vb" AutoEventWireup="false" MasterPageFile="~/Site.Master" CodeBehind="ManageEmployeeFeedbackTypes.aspx.vb" Inherits="CRM.ManageEmployeeFeedbackTypes" %>
<asp:Content ID="Head" ContentPlaceHolderID="HeadContent" runat="server" />
<asp:Content ID="Main" ContentPlaceHolderID="ContentPlaceHolder1" runat="server"><asp:UpdatePanel ID="systemAdminPanel" runat="server" UpdateMode="Conditional"><ContentTemplate><div class="container-xxl flex-grow-1 container-p-y" dir="rtl"><asp:Literal ID="litMessage" runat="server" /><div class="mb-3"><a class="btn btn-sm btn-label-secondary" href="/Modules/Employee_Feedback/Dashboard.aspx"><i class="bx bx-arrow-back me-1" aria-hidden="true"></i>لوحة إدارة الشكاوى</a></div><nav aria-label="إعدادات الشكاوى والاقتراحات"><ul class="nav nav-pills d-inline-flex w-100 flex-wrap gap-2 mb-3"><li class="nav-item"><a class="nav-link active" href="../Employee_Feedback_Types/ManageEmployeeFeedbackTypes.aspx"><i class="bx bx-category me-2"></i>أنواع الطلبات</a></li><li class="nav-item"><a class="nav-link " href="../Employee_Feedback_Topics/ManageEmployeeFeedbackTopics.aspx"><i class="bx bx-list-ul me-2"></i>مواضيع الطلبات</a></li><li class="nav-item"><a class="nav-link " href="../Employee_Feedback_Permissions/ManageEmployeeFeedbackPermissions.aspx"><i class="bx bx-shield-quarter me-2"></i>الصلاحيات والتوجيه</a></li></ul></nav><div class="card"><div class="card-header d-inline-flex w-100 flex-wrap justify-content-between align-items-center gap-3"><div><h5 class="mb-1"><i class="bx bx-category text-primary me-2" aria-hidden="true"></i>أنواع الشكاوى والاقتراحات</h5><p class="text-muted mb-0">تُستخدم الأنواع في تقديم الطلبات وتعريف المواضيع والتقارير.</p></div><a href="AddEmployeeFeedbackTypes.aspx" class="btn btn-primary"><i class="bx bx-plus me-1"></i>إضافة نوع</a></div><div class="card-body"><div class="row g-3 align-items-end mb-4"><div class="col-md-6"><asp:Label runat="server" AssociatedControlID="txtSearch" Text="اسم النوع" CssClass="form-label" /><asp:TextBox ID="txtSearch" runat="server" CssClass="form-control" MaxLength="200" /></div><div class="col-md-4"><asp:Label runat="server" AssociatedControlID="ddlActive" Text="الحالة" CssClass="form-label" /><asp:DropDownList ID="ddlActive" runat="server" CssClass="form-select"><asp:ListItem Value="">الكل</asp:ListItem><asp:ListItem Value="1">فعال</asp:ListItem><asp:ListItem Value="0">غير فعال</asp:ListItem></asp:DropDownList></div><div class="col-md-2"><asp:Button ID="btnSearch" runat="server" Text="بحث" OnClick="Search_Click" CssClass="btn btn-primary" /></div></div><table id="ERPTable" class="ERP_ProstoTBL card-list-table table table-sm table-bordered dt-responsive nowrap"><thead><tr><th>الاسم بالعربية</th><th>الاسم بالإنجليزية</th><th>ترتيب العرض</th><th>الحالة</th><th>الإجراءات</th></tr></thead><tbody><asp:ListView ID="lstData" runat="server" OnItemCommand="Item_Command"><LayoutTemplate><asp:PlaceHolder ID="itemPlaceholder" runat="server" /></LayoutTemplate><ItemTemplate><tr data-admin-name='<%#: CRM.SystemAdministrationUI.SearchName(Container.DataItem) %>' data-admin-id='<%#: Eval("ID") %>' data-admin-active='<%# CRM.SystemAdministrationUI.State(Container.DataItem) %>'><td class="py-2" data-title="الاسم بالعربية"><%#: Eval("Title_Ar") %></td><td class="py-2" data-title="الاسم بالإنجليزية"><%#: Eval("Title_En") %></td><td class="py-2" data-title="ترتيب العرض"><%#: Eval("Item_Order") %></td><td class="py-2" data-title="الحالة"><span class='<%# If(CBool(Eval("IsActive")),"badge bg-label-success","badge bg-label-secondary") %>'><%#: If(CBool(Eval("IsActive")),"فعال","غير فعال") %></span></td><td class="py-2" data-title="الإجراءات"><a class="btn btn-sm btn-label-primary me-1" href='<%# "EditEmployeeFeedbackTypes.aspx?ID=" & Eval("ID").ToString() %>'>تعديل</a><asp:LinkButton ID="btnDelete" runat="server" CommandName="DeleteType" CommandArgument='<%#: Eval("ID") %>' CssClass="btn btn-sm btn-label-danger" Text="حذف" OnClientClick="return confirm('هل تريد حذف هذا النوع؟ الأنواع المرتبطة بطلبات أو مواضيع يمكن تعطيلها فقط.');" /></td></tr></ItemTemplate><EmptyDataTemplate><tr><td colspan="5" class="text-center py-4">لا توجد أنواع مطابقة.</td></tr></EmptyDataTemplate></asp:ListView></tbody></table><p class="form-text mt-3">تعطيل النوع يوقف استخدامه في الطلبات الجديدة مع الحفاظ على الطلبات السابقة.</p></div></div></div></ContentTemplate></asp:UpdatePanel></asp:Content>