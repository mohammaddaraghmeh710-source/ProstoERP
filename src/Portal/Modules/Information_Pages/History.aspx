<%@ Page Title="إصدارات الصفحة" Language="vb" AutoEventWireup="false" MasterPageFile="~/Site.Master" CodeBehind="History.aspx.vb" Inherits="CRM.InformationPageHistory" %>
<asp:Content ID="Head" ContentPlaceHolderID="HeadContent" runat="server"></asp:Content>
<asp:Content ID="Main" ContentPlaceHolderID="ContentPlaceHolder1" runat="server"><div class="container-xxl flex-grow-1 container-p-y" dir="rtl"><asp:Literal ID="litMessage" runat="server" />
<section class="card"><div class="card-header d-flex justify-content-between flex-wrap gap-2"><h4 class="mb-0">إصدارات الصفحة</h4><div><a href="Manage.aspx" class="btn btn-outline-secondary">إدارة الصفحات</a> <asp:HyperLink ID="lnkLogs" runat="server" CssClass="btn btn-primary" Text="سجل العمليات والزيارات" /></div></div><div class="card-body"><p class="text-muted">كل إصدار يحتفظ بالمحتوى باللغتين وإعدادات النشر والترتيب وقت الحفظ. استرجاع إصدار سابق ينشئ نسخة جديدة دون تغيير الصلاحيات الحالية. يستعيد أيضًا النشر والترتيب؛ النسخة ذات الجدولة المنتهية تبقى مخفية.</p>
<div class="table-responsive"><table class="table table-bordered"><thead><tr><th>الإصدار</th><th>العنوان</th><th>العملية</th><th>الموظف</th><th>التاريخ — عمّان</th><th>إعدادات النشر</th><th>المحتوى</th></tr></thead><tbody>
<asp:ListView ID="lstVersions" runat="server" OnItemCommand="Version_Command"><LayoutTemplate><asp:PlaceHolder ID="itemPlaceholder" runat="server" /></LayoutTemplate><ItemTemplate><tr>
<td><%#: Eval("VersionNumber") %></td><td><%#: Eval("Title_Ar") %></td><td><%#: CRM.InformationPagesData.ActionText(Eval("Action")) %><br /><small><%#: If(IsDBNull(Eval("RestoredFromVersion")), "", "من الإصدار " & Convert.ToString(Eval("RestoredFromVersion"))) %></small></td><td><%#: Eval("ActorName") %> <small>(<%#: Eval("ActorID") %>)</small></td><td><%#: CRM.InformationPagesData.LocalDate(Eval("OccurredUtc")) %></td>
<td><%#: If(CBool(Eval("IsDeleted")),"محذوفة",If(CBool(Eval("IsPublished")),"منشورة","مسودة")) %> / <%#: If(CStr(Eval("PublishMode"))="scheduled","مجدول","فوري") %><br /><%#: CRM.InformationPagesData.LocalDate(Eval("StartUtc")) %> — <%#: CRM.InformationPagesData.LocalDate(Eval("EndUtc")) %></td>
<td><a class="btn btn-sm btn-outline-primary" href='<%# "View.aspx?preview=1&ID=" & Eval("PageID").ToString() & "&version=" & Eval("VersionNumber").ToString() %>'>عرض الإصدار</a> <asp:LinkButton ID="btnRestore" runat="server" CommandName="RestoreVersion" CommandArgument='<%# Eval("VersionNumber").ToString() & ":" & Eval("CurrentVersion").ToString() %>' Visible='<%# CBool(Eval("CanRestore")) %>' CssClass="btn btn-sm btn-outline-warning" OnClientClick="return confirm('هل تريد استرجاع هذا الإصدار بمحتواه وإعدادات نشره وترتيبه كنسخة جديدة؟ لن تتغير صلاحيات الاطلاع الحالية.');" Text="استرجاع هذا الإصدار" /></td>
</tr></ItemTemplate><EmptyDataTemplate><tr><td colspan="7" class="text-center py-4">لا توجد إصدارات.</td></tr></EmptyDataTemplate></asp:ListView></tbody></table></div></div></section></div></asp:Content>
