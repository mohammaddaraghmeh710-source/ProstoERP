<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <appSettings>
    <add key="Integration.BasicUsername" value="REPLACE_WITH_LOCAL_USERNAME" />
    <add key="Integration.BasicPassword" value="REPLACE_WITH_LOCAL_SECRET" />
    <add key="PasswordReset.HashKey" value="REPLACE_WITH_LOCAL_VALUE" />
    <add key="MobileApi.AllowHttp" value="true" />
    <add key="webpages:Version" value="3.0.0.0" />
    <add key="webpages:Enabled" value="false" />
    <add key="ClientValidationEnabled" value="true" />
    <add key="UnobtrusiveJavaScriptEnabled" value="true" />
    <add key="MobileApi.IdleMinutes" value="480" />
    <add key="MobileApi.MaximumMinutes" value="43200" />
    <add key="MobileApi.AssetBaseUrl" value="REPLACE_WITH_LOCAL_VALUE" />
    <add key="MobileApi.CorrespondenceStoragePath" value="REPLACE_WITH_LOCAL_VALUE" />
    <add key="MobileApi.FeedbackStoragePath" value="REPLACE_WITH_LOCAL_VALUE" />
    <add key="CustomerApi.PortalRoot" value="REPLACE_WITH_LOCAL_VALUE" />
  </appSettings>
  <connectionStrings>
    <add connectionString="Server=YOUR_SERVER;Database=YOUR_DATABASE;Integrated Security=True;" providerName="System.Data.SqlClient" name="Prosto_ERP_ConnectionConnection" />
  </connectionStrings>
  <system.web>
    <compilation debug="true" targetFramework="4.8"><assemblies><add assembly="System.Net.Http, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b03f5f7f11d50a3a" /></assemblies></compilation>
    <httpRuntime targetFramework="4.8" maxRequestLength="52224" executionTimeout="180" />
  </system.web>
  <system.webServer>
    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="53477376" />
      </requestFiltering>
    </security>
    <handlers>
      <remove name="ExtensionlessUrlHandler-Integrated-4.0" />
      <remove name="OPTIONSVerbHandler" />
      <remove name="TRACEVerbHandler" />
      <add name="ExtensionlessUrlHandler-Integrated-4.0" path="*." verb="*" type="System.Web.Handlers.TransferRequestHandler" preCondition="integratedMode,runtimeVersionv4.0" />
    </handlers>
  </system.webServer>
